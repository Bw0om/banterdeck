---
import Base from '../../layouts/Base.astro';
// Navnet på leken – bytt her om dere finner et bedre.
const NAVN = 'Nasjonal vorsprøve';
---
<Base title={NAVN} lang="no" gate={true}
      description="Tre delprøver på telefonen: ordkjeder, fargekaos og tungekrøller. Karakter fra 1 til 6 – og den som stryker, drikker.">
  <p class="crumb"><a href="/no/">Forside</a> › <a href="/no/drinking-games">Drikkeleker</a> › {NAVN}</p>
  <h1>{NAVN}</h1>
  <p class="lead">Tre delprøver, én telefon som går rundt bordet. Karakter fra 1 til 6 – og den som stryker, drikker.</p>

  <div id="vp" class="vp" aria-live="polite"></div>

  <p class="small vp-note">Dette er en lek. Den sier ingenting om hvor full du er – og ingenting om hvorvidt du kan kjøre.</p>

  <script is:inline>
  (function () {
    /* ---------------- innhold ---------------- */
    var ORD = ['bil','hus','mus','katt','sol','ball','fisk','hest','vin','glass','kopp','dør','bord','stol','sko','lue',
      'hånd','fot','båt','tog','fly','sau','gris','gås','mat','brød','egg','ost','melk','fest','kake','brus','kork',
      'bok','penn','lys','sang','dans','hatt','vott','skog','stein','sjø','bro','vei','tre','blad','rev','ulv','elg','hund'];
    var FARGER = [
      { navn:'RØD',   farge:'#ff5a4d' }, { navn:'BLÅ',  farge:'#4d9bff' },
      { navn:'GRØNN', farge:'#3ecf6e' }, { navn:'GUL',  farge:'#f4d03f' }];
    var KROLLER = [
      'Sju sjøsyke sjømenn skjenket sjampanje til skjeggete sjefer.',
      'Fire flate flyndrer fra Flekkefjord flyter forbi fjorden.',
      'Kjekke kjøkkensjefer kjøper kjempekjipe kjøleskapskjeks.',
      'Bestefars brune brilleetui brakk bak bryggerhuset.',
      'Hvis hvilende hvalrosser hviler, hviler hvalrossene i hvite hvaltønner.',
      'Tretti tørste turister tråkket tretten tomme tønner.',
      'Skjønne skjærgårdsskippere skjenker skjelvende skjørt skjenkebord.',
      'Prøysens prøvekokte pølser passet perfekt på prekestolen.',
      'Kjersti kjører kjelke, Kjell kjøper kjøttkaker, kjøkkenet kjeder seg.',
      'Seks slappe sjåfører sjanglet sjenert sjøveien sørover.',
      'Grå grevlinger gravde gress i grevens grønne grøft.',
      'Snille snøfnugg snek seg sakte ned på snodige snømenn.'];
    var TID_KJEDE = 40, TID_FARGE = 20, MAL_KJEDE = 6, MAL_FARGE = 16;
    var KARAKTER = [
      null,
      { k:1, t:'Stryk',        d:'Drikk tre slurker.' },
      { k:2, t:'Lav',          d:'Drikk to slurker.' },
      { k:3, t:'Nokså god',    d:'Drikk én slurk.' },
      { k:4, t:'God',          d:'Du slipper unna.' },
      { k:5, t:'Meget god',    d:'Del ut én slurk.' },
      { k:6, t:'Fremragende',  d:'Del ut tre slurker.' }];

    /* ---------------- hjelpere ---------------- */
    var root, S = null, timer = null;
    function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
    function tilfeldig(a){ return a[Math.floor(Math.random()*a.length)]; }
    function stokk(a){ a=a.slice(); for (var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=a[i]; a[i]=a[j]; a[j]=t; } return a; }
    function antallDelinger(s){
      // hvor mange måter kan kjeden deles i ord fra lista? Vi vil ha nøyaktig én.
      var n=[1]; for (var i=1;i<=s.length;i++){ n[i]=0;
        for (var w=0; w<ORD.length; w++){ var o=ORD[w]; if (o.length<=i && s.substr(i-o.length,o.length)===o) n[i]+=n[i-o.length]; } }
      return n[s.length];
    }
    function nyKjede(){
      for (var forsok=0; forsok<200; forsok++){
        var k = 3 + (Math.random()<0.45 ? 1 : 0), ord=[];
        for (var i=0;i<k;i++) ord.push(tilfeldig(ORD));
        var s = ord.join('');
        if (antallDelinger(s)===1){
          var kutt=[], pos=0; for (var j=0;j<ord.length-1;j++){ pos+=ord[j].length; kutt.push(pos-1); }
          return { tekst:s, kutt:kutt };
        }
      }
      return { tekst:'bilhusmus', kutt:[2,5] };
    }
    function karakterFor(p){ return p>=90?6 : p>=75?5 : p>=60?4 : p>=45?3 : p>=30?2 : 1; }
    function stopp(){ if (timer){ clearInterval(timer); timer=null; } }
    function nedtelling(sek, onTick, onSlutt){
      var slutt = Date.now()+sek*1000; stopp();
      timer = setInterval(function(){
        var igjen = Math.max(0, (slutt-Date.now())/1000); onTick(igjen, igjen/sek);
        if (igjen<=0){ stopp(); onSlutt(); }
      }, 100);
    }
    function vis(html){
      root.innerHTML = html;
      // hold spillkortet i synsfeltet når skjermen bytter, under toppmenyen på mobil
      var topp = window.innerWidth < 900 ? 112 : 24;
      var y = root.getBoundingClientRect().top;
      if (y < topp || y > window.innerHeight * 0.45) window.scrollTo({ top: window.scrollY + y - topp, behavior: 'smooth' });
    }
    function klokke(){ return '<div class="vp-clock"><span id="vpTid"></span><div class="vp-bar"><i id="vpBar"></i></div></div>'; }
    function tikk(igjen, andel){
      var t=document.getElementById('vpTid'), b=document.getElementById('vpBar');
      if (t) t.textContent = Math.ceil(igjen)+' s'; if (b) b.style.width = (andel*100)+'%';
    }

    /* ---------------- skjermer ---------------- */
    function oppsett(navn){
      stopp();
      navn = navn && navn.length ? navn : ['','',''];
      vis('<div class="vp-card"><h2>Hvem er med?</h2><p class="small">Skriv inn navnene. Telefonen går rundt i denne rekkefølgen.</p>'+
        '<div id="vpNavn">'+navn.map(function(n,i){ return '<input class="vp-in" maxlength="20" placeholder="Spiller '+(i+1)+'" value="'+esc(n)+'">'; }).join('')+'</div>'+
        '<button class="btn ghost" data-a="leggtil">+ Legg til spiller</button>'+
        '<p class="small vp-err" id="vpErr" hidden>Dere må være minst to.</p>'+
        '<button class="btn gold vp-big" data-a="start">Start prøven</button></div>');
    }
    function startSpill(){
      var navn = Array.prototype.map.call(root.querySelectorAll('.vp-in'), function(x){ return x.value.trim(); }).filter(Boolean);
      if (navn.length<2){ document.getElementById('vpErr').hidden=false; return; }
      var kroller = stokk(KROLLER);
      S = { spillere: navn.map(function(n,i){ return { navn:n, kjede:0, farge:0, kroll:0, tekst:kroller[i%kroller.length] }; }), nr:0 };
      overlevering();
    }
    function aktiv(){ return S.spillere[S.nr]; }
    function overlevering(){
      stopp();
      vis('<div class="vp-card vp-center"><p class="small">Kandidat '+(S.nr+1)+' av '+S.spillere.length+'</p>'+
        '<h2 class="vp-name">Gi telefonen til<br>'+esc(aktiv().navn)+'</h2>'+
        '<button class="btn gold vp-big" data-a="del1">Jeg er klar</button></div>');
    }
    function intro(nr, tittel, tekst, handling){
      vis('<div class="vp-card"><p class="small">'+esc(aktiv().navn)+' · delprøve '+nr+' av 3</p><h2>'+tittel+'</h2><p>'+tekst+'</p>'+
        '<button class="btn gold vp-big" data-a="'+handling+'">Start</button></div>');
    }

    /* Delprøve 1: ordkjeder */
    var K=null;
    function del1(){ intro(1,'Ordkjeder','Ordene er skrevet sammen. Trykk på bokstaven der et ord slutter, og trykk <b>Sjekk</b>. '+TID_KJEDE+' sekunder – så mange du rekker.','spill1'); }
    function spill1(){
      K = nyKjede();
      vis('<div class="vp-card">'+klokke()+'<p class="small">Riktige: <b id="vpPoeng">'+aktiv().kjede+'</b></p>'+
        '<div class="vp-chain" id="vpKjede">'+K.tekst.split('').map(function(c,i){ return '<button class="lt" data-i="'+i+'">'+esc(c)+'</button>'; }).join('')+'</div>'+
        '<p class="vp-fasit small" id="vpFasit">&nbsp;</p>'+
        '<button class="btn gold vp-big" data-a="sjekk">Sjekk</button></div>');
      if (!timer) nedtelling(TID_KJEDE, tikk, del2);
    }
    function sjekk(){
      var valgt = Array.prototype.map.call(root.querySelectorAll('.lt.cut'), function(b){ return +b.dataset.i; }).sort(function(a,b){return a-b;});
      var ok = valgt.join(',')===K.kutt.join(',');
      var f=document.getElementById('vpFasit'), kjede=document.getElementById('vpKjede');
      if (ok){ aktiv().kjede++; kjede.classList.add('ok'); f.textContent='Riktig!'; }
      else {
        var d=[], start=0; K.kutt.concat([K.tekst.length-1]).forEach(function(k){ d.push(K.tekst.slice(start,k+1)); start=k+1; });
        kjede.classList.add('feil'); f.textContent='Fasit: '+d.join(' | ');
      }
      root.querySelector('[data-a=sjekk]').disabled=true;
      setTimeout(function(){ if (timer) spill1(); }, ok ? 450 : 1300);
    }

    /* Delprøve 2: fargekaos */
    var F=null;
    function del2(){ stopp(); intro(2,'Fargekaos','Du ser et fargeord skrevet i en annen farge. Trykk <b>fargen på bokstavene</b> – ikke det som står. '+TID_FARGE+' sekunder. Feil trekker fra.','spill2'); }
    function nyFarge(){
      var ord=tilfeldig(FARGER), blekk; do { blekk=tilfeldig(FARGER); } while (blekk===ord);
      F={ blekk:blekk.navn };
      document.getElementById('vpOrd').textContent=ord.navn;
      document.getElementById('vpOrd').style.color=blekk.farge;
    }
    function spill2(){
      vis('<div class="vp-card">'+klokke()+'<p class="small">Poeng: <b id="vpPoeng">0</b></p>'+
        '<p class="vp-word" id="vpOrd"></p>'+
        '<div class="vp-colors">'+stokk(FARGER).map(function(c){ return '<button class="btn ghost" data-farge="'+c.navn+'">'+c.navn.toLowerCase()+'</button>'; }).join('')+'</div></div>');
      nyFarge(); nedtelling(TID_FARGE, tikk, del3);
    }
    function svarFarge(navn){
      var p=aktiv(); p.farge += (navn===F.blekk) ? 1 : -1;
      var ord=document.getElementById('vpOrd'); ord.classList.remove('ok','feil'); void ord.offsetWidth;
      ord.classList.add(navn===F.blekk?'ok':'feil');
      document.getElementById('vpPoeng').textContent=Math.max(0,p.farge);
      nyFarge();
    }

    /* Delprøve 3: tungekrøller */
    function del3(){ stopp(); intro(3,'Tungekrøller','Les teksten høyt, i normalt tempo. Resten av bordet dømmer.','spill3'); }
    function spill3(){
      vis('<div class="vp-card"><p class="small">Les høyt:</p><p class="vp-twister">'+esc(aktiv().tekst)+'</p>'+
        '<p class="small">Bordet dømmer:</p><div class="vp-judge">'+
        '<button class="btn gold" data-kroll="3">Feilfritt</button>'+
        '<button class="btn ghost" data-kroll="1">Én–to snubler</button>'+
        '<button class="btn ghost" data-kroll="0">Kaos</button></div></div>');
    }
    function prosent(p){
      var a=Math.min(1,p.kjede/MAL_KJEDE), b=Math.min(1,Math.max(0,p.farge)/MAL_FARGE), c=p.kroll/3;
      return Math.round((a+b+c)/3*100);
    }
    function vitnemal(){
      var p=aktiv(); p.pst=prosent(p); p.kar=karakterFor(p.pst); var K1=KARAKTER[p.kar];
      var siste = S.nr===S.spillere.length-1;
      vis('<div class="vp-card vp-center"><p class="small">Vitnemål for '+esc(p.navn)+'</p>'+
        '<p class="vp-grade g'+p.kar+'">'+p.kar+'</p><h2>'+K1.t+'</h2><p>'+K1.d+'</p>'+
        '<ul class="vp-parts"><li>Ordkjeder <b>'+p.kjede+'</b></li><li>Fargekaos <b>'+Math.max(0,p.farge)+'</b></li><li>Tungekrøller <b>'+['Kaos','Snublet','','Feilfritt'][p.kroll]+'</b></li></ul>'+
        '<button class="btn gold vp-big" data-a="'+(siste?'resultat':'neste')+'">'+(siste?'Se klassens resultater':'Neste kandidat')+'</button></div>');
    }
    function resultat(){
      var r=S.spillere.slice().sort(function(a,b){ return b.pst-a.pst; });
      vis('<div class="vp-card"><h2>Klassens resultater</h2><p class="small">Klassens beste: <b>'+esc(r[0].navn)+'</b></p>'+
        '<ol class="vp-board">'+r.map(function(p){ var k=KARAKTER[p.kar];
          return '<li><span class="vp-g g'+p.kar+'">'+p.kar+'</span><span class="vp-bn">'+esc(p.navn)+'</span><span class="vp-bd">'+k.d+'</span></li>'; }).join('')+'</ol>'+
        '<button class="btn gold vp-big" data-a="igjen">Ny prøve – samme klasse</button>'+
        '<button class="btn ghost" data-a="nyklasse">Ny klasse</button></div>');
    }

    /* ---------------- hendelser ---------------- */
    function klikk(e){
      var b=e.target.closest('button'); if (!b || !root.contains(b)) return;
      var a=b.dataset.a;
      if (b.classList.contains('lt')){ if (+b.dataset.i < K.tekst.length-1) b.classList.toggle('cut'); return; }
      if (b.dataset.farge) return svarFarge(b.dataset.farge);
      if (b.dataset.kroll!==undefined){ aktiv().kroll=+b.dataset.kroll; return vitnemal(); }
      if (a==='leggtil'){ var n=root.querySelectorAll('.vp-in').length; if (n<12){ var i=document.createElement('input'); i.className='vp-in'; i.maxLength=20; i.placeholder='Spiller '+(n+1); document.getElementById('vpNavn').appendChild(i); i.focus(); } }
      else if (a==='start') startSpill();
      else if (a==='del1') del1();
      else if (a==='spill1') spill1();
      else if (a==='sjekk') sjekk();
      else if (a==='spill2') spill2();
      else if (a==='spill3') spill3();
      else if (a==='neste'){ S.nr++; overlevering(); }
      else if (a==='resultat') resultat();
      else if (a==='igjen'){ var navn=S.spillere.map(function(p){return p.navn;}); oppsett(navn); startSpill(); }
      else if (a==='nyklasse'){ S=null; oppsett(); }
    }
    function init(){
      root=document.getElementById('vp');
      if (!root || root.dataset.bound) return;
      root.dataset.bound='1'; root.addEventListener('click', klikk); oppsett();
    }
    init(); document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', stopp);
  })();
  </script>
</Base>
