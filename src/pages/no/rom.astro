      if (g === 'lyd') { lyd.paa = !lyd.paa; skriv('bd_lyd', lyd.paa); if (lyd.paa) { lydCtx(); spillLyd('pop'); } return tegn(); }
      if (g === 'reager') return gjorAlltid({ handling: 'reager', e: b.dataset.e });
