          var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'banterdeck-tavle.png';
          document.body.appendChild(a); a.click(); a.remove(); setTimeout(function () { URL.revokeObjectURL(a.href); }, 5000);
