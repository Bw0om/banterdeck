---
import Base from '../../layouts/Base.astro';
---
<Base title="Spill sammen" description="Lag et rom og få med alle fra hver sin telefon. Samme kort på alle skjermer, hemmelige roller, stemming og bingo." lang="no" gate={true}>
  <div id="rom" class="rom">
    <noscript><p>Rommet trenger JavaScript.</p></noscript>
  </div>

  <script is:inline data-astro-rerun>
  (function () {
    var root = document.getElementById('rom');
    if (!root || root.dataset.bound) return; root.dataset.bound = '1';
    if (window.__bdRomStopp) window.__bdRomStopp();

    var kode = (new URLSearchParams(location.search).get('k') || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 6);
    var meg = null, tilstand = null, versjon = 0, timer = null, sisteNr = 0, opptatt = false, feilTeller = 0;
    var ikon = {
      del: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 13v7h14v-7"/></svg>',
      krone: '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 7l4.5 4L12 4l4.5 7L21 7l-2 12H5z"/></svg>'
    };

    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function les(k) { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } }
    function skriv(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
    function toast(t) {
      var el = document.getElementById('toast'); if (!el) return;
      el.textContent = t; el.classList.add('show');
      clearTimeout(toast.t); toast.t = setTimeout(function () { el.classList.remove('show'); }, 2200);
    }
    function settAdresse(k) {
      var u = location.pathname + (k ? '?k=' + k : '');
      history.replaceState(history.state, '', u);
    }

    /* ---------- nettverk ---------- */
    function api(metode, sti, body) {
      var h = { 'Content-Type': 'application/json' };
      if (meg && metode === 'GET') { h['x-spiller'] = meg.id; h['x-pollett'] = meg.pollett; }
      return fetch(sti, { method: metode, headers: h, body: body ? JSON.stringify(body) : undefined, cache: 'no-store' })
        .then(function (r) {
          if (r.status === 204) return null;
          return r.json().then(function (d) { if (!r.ok) { var e = new Error(d.melding || 'Feil'); e.kode = d.feil; e.status = r.status; throw e; } return d; });
        });
    }
    function gjor(h) {
      if (!meg || opptatt) return;
      opptatt = true;
      h.id = meg.id; h.pollett = meg.pollett;
      api('POST', '/api/rom/' + kode, h).then(function (d) { opptatt = false; ta(d); })
        .catch(function (e) { opptatt = false; toast(e.message); if (e.kode === 'ikke-med') glemRom(); });
    }
    var ko = Promise.resolve();
    function gjorAlltid(h) {
      if (!meg) return;
      h.id = meg.id; h.pollett = meg.pollett;
      ko = ko.then(function () { return api('POST', '/api/rom/' + kode, h).then(ta).catch(function (e) { toast(e.message); }); });
    }
    function hent() {
      if (!kode || !meg) return;
      api('GET', '/api/rom/' + kode + '?v=' + versjon).then(function (d) { feilTeller = 0; if (d) ta(d); planlegg(); })
        .catch(function (e) {
          if (e.kode === 'finnes-ikke') { glemRom(); toast(e.message); return; }
          feilTeller++; planlegg();
        });
    }
    function planlegg() {
      clearTimeout(timer);
      if (!document.getElementById('rom')) return;
      var ms = document.hidden ? 6000 : Math.min(1500 + feilTeller * 1500, 8000);
      timer = setTimeout(hent, ms);
    }
    function ta(d) {
      if (!d) return;
      if (d.versjon) versjon = d.versjon;
      tilstand = d;
      if (d.hendelse && d.hendelse.nr > sisteNr) { if (sisteNr) toast(d.hendelse.tekst); sisteNr = d.hendelse.nr; }
      if (d.meg === null && meg) { glemRom(); return; }
      tegn();
    }
    function glemRom() {
      if (kode) { try { localStorage.removeItem('bd_rom_' + kode); } catch (e) {} }
      meg = null; tilstand = null; versjon = 0; clearTimeout(timer); tegnStart();
    }
    window.__bdRomStopp = function () { clearTimeout(timer); };
    document.addEventListener('astro:before-swap', function stopp() { clearTimeout(timer); document.removeEventListener('astro:before-swap', stopp); }, { once: true });
    document.addEventListener('visibilitychange', function () { if (!document.hidden && meg) hent(); });

    /* ---------- start: lag eller bli med ---------- */
    function tegnStart(melding) {
      var navn = les('bd_mittnavn') || '';
      root.innerHTML =
        '<h1 class="rom-h1">Spill sammen</h1>' +
        '<p class="lead">Én lager et rom, resten blir med med koden. Da ser alle det samme – eller sin egen hemmelighet – på hver sin telefon.</p>' +
        (melding ? '<p class="rom-feil" role="alert">' + esc(melding) + '</p>' : '') +
        '<div class="rom-start">' +
          '<form class="rom-boks" id="blimedSkjema">' +
            '<h2>Bli med</h2>' +
            '<label for="romKode">Kode</label>' +
            '<input id="romKode" class="rom-kodefelt" inputmode="text" autocomplete="off" autocapitalize="characters" maxlength="6" placeholder="ABCD" value="' + esc(kode) + '">' +
            '<label for="romNavn1">Navnet ditt</label>' +
            '<input id="romNavn1" maxlength="20" autocomplete="nickname" placeholder="F.eks. Jonas" value="' + esc(navn) + '">' +
            '<button class="btn gold rom-knapp" type="submit">Bli med</button>' +
          '</form>' +
          '<form class="rom-boks lag" id="lagSkjema">' +
            '<h2>Lag et rom</h2>' +
            '<p class="small">Du blir vert og velger lekene.</p>' +
            '<label for="romNavn2">Navnet ditt</label>' +
            '<input id="romNavn2" maxlength="20" autocomplete="nickname" placeholder="F.eks. Maria" value="' + esc(navn) + '">' +
            '<button class="btn rom-knapp" type="submit">Lag rom</button>' +
          '</form>' +
        '</div>';
      document.getElementById('blimedSkjema').addEventListener('submit', function (e) {
        e.preventDefault();
        var k = document.getElementById('romKode').value.toUpperCase().replace(/[^A-Z0-9]/g, '');
        var n = document.getElementById('romNavn1').value.trim();
        if (k.length < 4) return toast('Skriv inn koden.');
        if (!n) return toast('Skriv inn navnet ditt.');
        skriv('bd_mittnavn', n);
        api('POST', '/api/rom/' + k, { handling: 'bli-med', navn: n }).then(function (d) {
          kode = k; meg = { id: d.id, pollett: d.pollett }; skriv('bd_rom_' + kode, meg); settAdresse(kode); ta(d); planlegg();
        }).catch(function (err) { tegnStart(err.message); });
      });
      document.getElementById('lagSkjema').addEventListener('submit', function (e) {
        e.preventDefault();
        var n = document.getElementById('romNavn2').value.trim();
        if (!n) return toast('Skriv inn navnet ditt.');
        skriv('bd_mittnavn', n);
        api('POST', '/api/rom', { navn: n }).then(function (d) {
          kode = d.kode; meg = { id: d.id, pollett: d.pollett }; skriv('bd_rom_' + kode, meg); settAdresse(kode);
          versjon = 0; hent();
        }).catch(function (err) { tegnStart(err.message); });
      });
    }

    /* ---------- selve rommet ---------- */
    function navn(id) { var p = (tilstand.spillere || []).find(function (x) { return x.id === id; }); return p ? p.navn : '?'; }
    function erVert() { return tilstand && meg && tilstand.vert === meg.id; }

    function hode() {
      var t = tilstand;
      return '<div class="rom-hode">' +
        '<div><span class="rom-etikett">Rom</span><b class="rom-kode">' + esc(kode) + '</b></div>' +
        '<button class="rom-del" data-g="del" type="button">' + ikon.del + 'Inviter</button>' +
      '</div>' +
      '<div class="rom-spillere">' + t.spillere.map(function (p) {
        return '<span class="' + (p.id === t.meg ? 'meg' : '') + '">' + (p.id === t.vert ? ikon.krone : '') + esc(p.navn) +
          (p.slurker ? ' <small>' + p.slurker + '</small>' : '') +
          (erVert() && p.id !== t.vert ? ' <button class="rom-fjern" data-g="fjern" data-id="' + p.id + '" aria-label="Fjern ' + esc(p.navn) + '">×</button>' : '') + '</span>';
      }).join('') + '</div>';
    }

    function lobby() {
      var t = tilstand;
      if (!erVert()) {
        return '<div class="rom-vent"><p class="rom-stor">Venter på at ' + esc(navn(t.vert)) + ' velger en lek …</p>' +
          '<p class="small">' + t.spillere.length + ' med i rommet. Del koden <b>' + esc(kode) + '</b> med resten.</p></div>';
      }
      return '<h2 class="rom-h2">Velg en lek</h2>' +
        '<div class="rom-leker">' + t.leker.map(function (l) {
          var mod = l.moduser && l.moduser.length > 1 ? l.moduser : [];
          return '<div class="rom-lek"><b>' + esc(l.navn) + '</b><span>' + esc(l.om || '') + '</span>' +
            '<div class="rom-mod">' + (mod.length
              ? mod.map(function (m) { return '<button type="button" data-g="start" data-lek="' + l.id + '" data-modus="' + esc(m.v) + '">' + esc(m.t) + '</button>'; }).join('') +
                (l.type !== 'bingo' ? '<button type="button" data-g="start" data-lek="' + l.id + '" data-modus="*">Alle</button>' : '')
              : '<button type="button" data-g="start" data-lek="' + l.id + '" data-modus="*">Start</button>') +
            '</div></div>';
        }).join('') + '</div>';
    }

    function kortSpill(s) {
      var k = s.kort || {};
      var rof = s.lek === 'ring-of-fire';
      var kortHtml = rof
        ? '<div class="rof-kort rom-rof' + (k.rod ? ' rod' : '') + '"><div class="rof-hj"><b>' + esc(k.v) + '</b><span>' + esc(k.s) + '</span></div>' +
          '<div class="rof-midt"><b class="rof-regel">' + esc(k.regel) + '</b><span class="rof-tekst">' + esc(k.tekst) + '</span></div>' +
          '<div class="rof-hj rof-hj2"><b>' + esc(k.v) + '</b><span>' + esc(k.s) + '</span></div></div>'
        : '<div class="rom-kort">' + (k.k ? '<span class="sw-tag">' + esc(k.k) + '</span>' : '<span></span>') + '<p>' + esc(k.t) + '</p><span class="rom-teller">' + (s.pos + 1) + ' / ' + s.antall + '</span></div>';
      return (rof && k.hvem ? '<div class="rof-tur"><span>Trekker</span><b>' + esc(k.hvem) + '</b></div>' : '') +
        (rof ? '<p class="rom-status">' + (s.antall - s.pos - 1) + ' kort igjen · ' + (s.konger || 0) + ' konger</p>' : '') +
        kortHtml +
        '<button class="rom-stor-knapp" data-g="neste" data-pos="' + s.pos + '" type="button">Neste kort</button>';
    }

    function mestSpill(s) {
      var t = tilstand;
      if (s.fase === 'resultat') {
        var maks = s.resultat.length ? s.resultat[0].stemmer : 1;
        return '<p class="rom-sporsmal">' + esc(s.tekst) + '</p>' +
          '<ol class="rom-resultat">' + s.resultat.map(function (r) {
            return '<li><span>' + esc(r.navn) + '</span><i style="width:' + Math.round(100 * r.stemmer / maks) + '%"></i><b>' + r.stemmer + ' ' + (r.stemmer === 1 ? 'slurk' : 'slurker') + '</b></li>';
          }).join('') + '</ol>' +
          '<button class="rom-stor-knapp" data-g="runde" type="button">Neste spørsmål</button>';
      }
      var stemt = s.harStemt.length, alle = t.spillere.length;
      return '<p class="rom-sporsmal">' + esc(s.tekst) + '</p>' +
        '<p class="small">Stem på hvem det passer best på. Hver stemme er én slurk.</p>' +
        '<div class="rom-valg">' + t.spillere.map(function (p) {
          return '<button type="button" data-g="stem" data-paa="' + p.id + '" aria-pressed="' + (s.minStemme === p.id) + '">' + esc(p.navn) + (p.id === t.meg ? ' (deg)' : '') + '</button>';
        }).join('') + '</div>' +
        '<p class="rom-status">' + stemt + ' av ' + alle + ' har stemt</p>' +
        (erVert() ? '<button class="btn ghost" data-g="avslor" type="button">Vis resultat nå</button>' : '');
    }

    function forraederSpill(s) {
      var t = tilstand, jeg = t.meg === s.aktiv, han = navn(s.aktiv);
      if (s.fase === 'svar') {
        if (jeg) return '<p class="rom-etikett">Din tur – bare du ser dette</p>' +
          '<div class="rom-hemmelig ' + (s.hemmelig === 'lyv' ? 'lyv' : 'sann') + '"><b>' + (s.hemmelig === 'lyv' ? 'LYV!' : 'Si sannheten') + '</b></div>' +
          '<p class="rom-sporsmal">' + esc(s.tekst) + '</p>' +
          '<p class="small">Fullfør setningen høyt. Hold masken.</p>' +
          '<button class="rom-stor-knapp" data-g="svart" type="button">Jeg har svart</button>';
        return '<p class="rom-etikett">' + esc(han) + ' fullfører</p><p class="rom-sporsmal">' + esc(s.tekst) + '</p>' +
          '<p class="rom-stor">Hør godt etter …</p>' +
          (erVert() ? '<button class="btn ghost" data-g="svart" type="button">Gå til stemming</button>' : '');
      }
      if (s.fase === 'stem') {
        if (jeg) return '<p class="rom-sporsmal">' + esc(s.tekst) + '</p><p class="rom-stor">De andre stemmer nå …</p>' +
          '<p class="rom-status">' + s.harStemt.length + ' av ' + (t.spillere.length - 1) + ' har stemt</p>';
        return '<p class="rom-etikett">' + esc(han) + ' sa</p><p class="rom-sporsmal">' + esc(s.tekst) + '</p>' +
          '<div class="rom-valg to">' +
            '<button type="button" data-g="stem" data-paa="sannhet" aria-pressed="' + (s.minStemme === 'sannhet') + '">Sannhet</button>' +
            '<button type="button" data-g="stem" data-paa="lyv" aria-pressed="' + (s.minStemme === 'lyv') + '">Løgn</button>' +
          '</div>' +
          '<p class="rom-status">' + s.harStemt.length + ' av ' + (t.spillere.length - 1) + ' har stemt</p>' +
          (erVert() ? '<button class="btn ghost" data-g="avslor" type="button">Avslør nå</button>' : '');
      }
      var r = s.resultat || {};
      return '<p class="rom-etikett">Fasit</p>' +
        '<div class="rom-hemmelig ' + (r.svar === 'lyv' ? 'lyv' : 'sann') + '"><b>' + esc(han) + ' ' + (r.svar === 'lyv' ? 'løy!' : 'sa sannheten!') + '</b></div>' +
        (r.drikker && r.drikker.length
          ? '<ul class="rom-drikker">' + r.drikker.map(function (x) { return '<li><b>' + esc(x.navn) + '</b> drikker ' + x.slurker + '</li>'; }).join('') + '</ul>'
          : '<p class="rom-stor">Ingen drikker denne gangen.</p>') +
        '<p class="small">Gjettet du feil: 2 slurker. Gjettet alle riktig: den som svarte drikker 3.</p>' +
        '<button class="rom-stor-knapp" data-g="runde" type="button">Neste runde</button>';
    }

    function bingoSpill(s) {
      var b = s.mittBrett || [], m = s.mineMerker || [];
      return '<p class="rom-etikett">Ditt brett · ' + esc(s.tittel) + '</p>' +
        '<div class="rom-bingo">' + b.map(function (x, i) {
          return '<button type="button" data-g="merk" data-i="' + i + '" aria-pressed="' + !!m[i] + '"><b>' + esc(x[1]) + '</b><span>' + esc(x[0]) + '</span></button>';
        }).join('') + '</div>' +
        '<div class="gt-row">' + (s.spotify ? '<a class="btn gold" href="' + esc(s.spotify) + '" target="_blank" rel="noopener">Åpne spillelista ↗</a>' : '') +
        '<button class="btn ghost" data-g="nytt-brett" type="button">Nytt brett</button></div>' +
        (s.bingo && s.bingo.length ? '<p class="rom-status">BINGO: ' + s.bingo.map(function (id) { return esc(navn(id)); }).join(', ') + '</p>' : '') +
        '<p class="small">Merk en låt når den spilles. Rekke: del ut to slurker. Fullt brett: alle andre drikker opp.</p>';
    }


    /* ---------- kort og terninger ---------- */
    function vn(v) { return v <= 10 ? String(v) : ({ 11: 'Kn', 12: 'D', 13: 'K', 14: 'A' })[v]; }
    function kk(k, kl, attr) {
      if (!k) return '<span class="kk bak ' + (kl || '') + '"></span>';
      var rod = k.f === '♥' || k.f === '♦';
      return '<span class="kk ' + (rod ? 'rod ' : '') + (kl || '') + '"' + (attr || '') + '><b>' + vn(k.v) + '</b><i>' + k.f + '</i></span>';
    }
    var PRIKKER = { 1: [5], 2: [1, 9], 3: [1, 5, 9], 4: [1, 3, 7, 9], 5: [1, 3, 5, 7, 9], 6: [1, 3, 4, 6, 7, 9] };
    function terning(n) { var s = '<span class="dice" data-n="' + n + '">'; for (var i = 1; i <= 9; i++) s += '<i' + (PRIKKER[n].indexOf(i) !== -1 ? ' class="p"' : '') + '></i>'; return s + '</span>'; }
    var sisteKastNr = 0, presValg = [];

    function opusSpill(s) {
      var jeg = s.holder === tilstand.meg;
      var ny = s.nr !== sisteKastNr; sisteKastNr = s.nr;
      return '<p><a class="btn ghost small" href="https://open.spotify.com/search/Opus%20Eric%20Prydz" target="_blank" rel="noopener">«Opus» i Spotify ↗</a></p>' +
        '<p class="rom-etikett">Terningen er hos</p><p class="dl-holder">' + esc(navn(s.holder)) + (jeg ? ' (deg!)' : '') + '</p>' +
        '<div class="dl-terninger' + (ny && s.kast ? ' landet' : '') + '">' + terning(s.kast || 6) + '</div>' +
        '<p class="dl-melding dl-stor">' + (s.kast === 6 && s.fra ? 'SEKSER! ' + esc(navn(s.fra)) + ' sendte videre.' : s.kast ? s.kast + (jeg ? ' – trill igjen!' : '') : 'Start sangen og trill!') + '</p>' +
        (jeg ? '<button class="rom-stor-knapp" data-g="kast" type="button">Trill</button>' : '<p class="small">Vent til terningen kommer til deg.</p>') +
        '<p class="rom-status">' + s.antall + ' kast</p>' +
        (erVert() ? '<button class="btn ghost" data-g="drop" type="button">Droppet kom!</button>' : '');
    }
    function overunderSpill(s) {
      var jeg = s.tur === tilstand.meg, si = s.sist;
      return '<p class="rom-etikett">' + (jeg ? 'Din tur' : esc(navn(s.tur)) + ' gjetter') + '</p>' +
        '<div class="dl-bord">' + kk(s.kort, 'stor inn') + '</div>' +
        (si ? '<p class="dl-melding">' + esc(navn(si.hvem)) + ': ' + vn(si.fra.v) + si.fra.f + ' → ' + vn(si.til.v) + si.til.f + ' – ' + (si.riktig ? 'riktig!' : 'feil, drakk ' + si.bunke + '.') + '</p>' : '') +
        '<p class="rom-status">Bunken: ' + s.bunke + ' kort</p>' +
        (jeg ? '<div class="rom-valg to"><button type="button" data-g="gjett" data-paa="over">Høyere ↑</button><button type="button" data-g="gjett" data-paa="under">Lavere ↓</button></div>' : '');
    }
    function veddelopetSpill(s) {
      var F = ['♥', '♠', '♦', '♣'], NAVN = { '♥': 'Hjerter', '♠': 'Spar', '♦': 'Ruter', '♣': 'Kløver' };
      var bane = '<div class="dl-bane" style="--lengde:9">' + F.map(function (f) {
        var c = ''; for (var i = 0; i <= 8; i++) c += '<span class="dl-celle' + (i === 8 ? ' mal' : '') + '">' + (s.pos[f] === i ? kk({ v: 14, f: f }, 'liten' + (s.vinner === f ? ' vinner' : '')) : '') + '</span>';
        return '<div class="dl-rad">' + c + '</div>';
      }).join('') + '<div class="dl-rad banekort"><span class="dl-celle"></span>' + s.bane.map(function (k) { return '<span class="dl-celle">' + kk(k, 'liten') + '</span>'; }).join('') + '<span class="dl-celle"></span></div></div>';
      var vedd = Object.keys(s.veddemaal).map(function (id) { var v = s.veddemaal[id]; return esc(navn(id)) + ': ' + v.farge + ' ' + v.slurker; }).join(' · ');
      if (s.fase === 'vedd') {
        var mv = s.mittVeddemaal || {};
        return bane + '<p class="rom-etikett">Vedd på en hest</p>' +
          '<div class="rom-valg fire">' + F.map(function (f) { return '<button type="button" data-g="vedd" data-farge="' + f + '" aria-pressed="' + (mv.farge === f) + '">' + f + ' ' + NAVN[f] + '</button>'; }).join('') + '</div>' +
          '<label class="rof-lab" for="veddSl">Slurker du vedder</label><input class="rof-inp" id="veddSl" type="number" min="1" max="10" value="' + (mv.slurker || 2) + '">' +
          '<p class="rom-status">' + (vedd || 'Ingen har veddet ennå') + '</p>' +
          (erVert() ? '<button class="rom-stor-knapp" data-g="lop" type="button">Start løpet</button>' : '');
      }
      return bane + '<div class="dl-bord">' + (s.sist ? kk(s.sist, 'stor inn') : '') + '</div>' +
        (s.vinner ? '<p class="dl-melding dl-stor">' + NAVN[s.vinner] + ' vant! Riktig veddemål: del ut det dobbelte.</p>' : '') +
        '<p class="rom-status">' + vedd + '</p>' +
        (s.fase === 'lop' ? '<button class="rom-stor-knapp" data-g="snu" type="button">Snu kort</button>' : '<button class="rom-stor-knapp" data-g="nytt" type="button">Nytt løp</button>');
    }
    function pyramidenSpill(s) {
      var rader = [[14], [12, 13], [9, 10, 11], [5, 6, 7, 8], [0, 1, 2, 3, 4]];
      var pyr = '<div class="dl-pyramide">' + rader.map(function (r) { return '<div>' + r.map(function (i) { return i < s.pos ? kk(s.pyr[i], 'liten' + (i === s.pos - 1 ? ' vinner' : '')) : kk(null, 'liten'); }).join('') + '</div>'; }).join('') + '</div>';
      var siste = s.pos ? s.pyr[s.pos - 1] : null, rad = s.pos ? (s.pos - 1 < 5 ? 1 : s.pos - 1 < 9 ? 2 : s.pos - 1 < 12 ? 3 : s.pos - 1 < 14 ? 4 : 5) : 0;
      var minPast = s.pastander.some(function (p) { return p.id === tilstand.meg; });
      var past = s.pastander.map(function (p) {
        return '<li><b>' + esc(navn(p.id)) + '</b> sier de har ' + (siste ? vn(siste.v) : '') + ' (del ut ' + p.rad + ')' +
          (p.avgjort ? ' – <em>' + (p.avgjort === 'bløff' ? 'bløffet!' : p.avgjort === 'sant' ? 'hadde den!' : 'godtatt') + '</em>'
            : (p.id !== tilstand.meg ? ' <button class="btn ghost small" type="button" data-g="utfordre" data-paa="' + p.id + '">Utfordre</button>' : '')) + '</li>';
      }).join('');
      return pyr + (siste ? '<p class="dl-melding">Snudd: ' + vn(siste.v) + siste.f + ' · rad ' + rad + '</p>' : '<p class="dl-melding">Snu første kort nederst til venstre.</p>') +
        '<p class="rom-etikett">Din hånd – bare du ser den</p><div class="dl-hand">' + (s.minHand || []).map(function (k) { return kk(k); }).join('') + '</div>' +
        (siste && !minPast ? '<button class="btn gold" data-g="pastand" type="button">Jeg har den! (eller bløffer …)</button>' : '') +
        (past ? '<ul class="rom-past">' + past + '</ul>' : '') +
        (s.pos < 15 ? '<button class="rom-stor-knapp" data-g="snu" type="button">Snu neste kort</button>' : '<p class="dl-melding dl-stor">Toppen er snudd – runden er ferdig!</p><button class="rom-stor-knapp" data-g="nytt" type="button">Ny runde</button>');
    }
    function grisSpill(s) {
      var bok = function (id) { var n = s.bokstaver[id] || 0; return n ? 'GRIS'.slice(0, n) : '–'; };
      var tavle = '<div class="rom-gris-tavle">' + tilstand.spillere.map(function (p) { return '<span>' + esc(p.navn) + ' <b>' + bok(p.id) + '</b></span>'; }).join('') + '</div>';
      var nese = '<button class="rom-nese' + (s.fase === 'nese' ? ' blink' : '') + '" data-g="nese" type="button" aria-pressed="' + (s.neser.indexOf(tilstand.meg) !== -1) + '"><b>NESA!</b><span>Trykk når noen har fire like</span></button>';
      if (s.fase === 'ferdig') {
        return tavle + '<p class="dl-melding dl-stor">' + esc(navn(s.taper)) + ' var sist på nesa!</p>' +
          '<div class="dl-hender">' + Object.keys(s.fasit || {}).map(function (id) { return '<div><b>' + esc(navn(id)) + '</b><span>' + s.fasit[id].map(function (k) { return kk(k, 'mini'); }).join('') + '</span></div>'; }).join('') + '</div>' +
          '<button class="rom-stor-knapp" data-g="nytt" type="button">Ny runde</button>';
      }
      var hand = s.minHand || [];
      return tavle + '<p class="rom-etikett">Din hånd – velg et kort å sende til venstre</p>' +
        '<div class="dl-hand gris">' + hand.map(function (k, i) { return '<button type="button" data-g="velg" data-i="' + i + '" aria-pressed="' + (s.mittValg === i) + '">' + kk(k) + '</button>'; }).join('') + '</div>' +
        '<p class="rom-status">' + s.harValgt.length + ' av ' + tilstand.spillere.length + ' har valgt' + (s.harFire ? ' · <b class="dl-hint">Du har fire like!</b>' : '') + '</p>' +
        nese + '<p class="small">Tar du deg på nesa uten fire like, får du en bokstav.</p>';
    }
    function presidentSpill(s) {
      var jeg = s.tur === tilstand.meg, hand = s.minHand || [];
      presValg = presValg.filter(function (i) { return i < hand.length; });
      var tavle = '<div class="rom-gris-tavle">' + tilstand.spillere.map(function (p) {
        var t = s.titler && s.titler[p.id];
        return '<span class="' + (p.id === s.tur ? 'tur' : '') + '">' + esc(p.navn) + ' <b>' + (s.antall[p.id] !== undefined ? s.antall[p.id] : '–') + '</b>' + (t ? ' <em>' + t + '</em>' : '') + (s.pass.indexOf(p.id) !== -1 ? ' <small>pass</small>' : '') + '</span>';
      }).join('') + '</div>';
      if (s.fase === 'ferdig') return tavle + '<p class="dl-melding dl-stor">Runden er over!</p><p class="small">Presidenten bestemmer når andre skal drikke. Rævkjøreren henter drikke og gir sitt beste kort til presidenten.</p>' +
        '<button class="rom-stor-knapp" data-g="nytt" type="button">Ny runde</button>';
      return tavle + '<p class="rom-etikett">På bordet' + (s.bordAv ? ' – lagt av ' + esc(navn(s.bordAv)) : '') + '</p>' +
        '<div class="dl-bord">' + (s.bord.length ? s.bord.map(function (k) { return kk(k, 'inn'); }).join('') : '<span class="small">Tomt – ' + esc(navn(s.tur)) + ' starter</span>') + '</div>' +
        '<p class="rom-etikett">' + (jeg ? 'Din tur – velg like kort' : 'Venter på ' + esc(navn(s.tur))) + '</p>' +
        '<div class="dl-hand pres">' + hand.map(function (k, i) { return '<button type="button" data-g="pvelg" data-i="' + i + '" aria-pressed="' + (presValg.indexOf(i) !== -1) + '"' + (jeg ? '' : ' disabled') + '>' + kk(k, 'liten') + '</button>'; }).join('') + '</div>' +
        (jeg ? '<div class="dl-knapper"><button class="btn gold" data-g="legg" type="button">Legg ut</button>' + (s.bord.length ? '<button class="btn ghost" data-g="pass" type="button">Pass</button>' : '') + '</div>' : '') +
        '<p class="small">Toere er høyest og rydder bordet.</p>';
    }

    var rfOffset = 0, rfTimer = null;
    function rfIgjen(s) { return Math.max(0, Math.ceil((s.frist - 3000 - (Date.now() + rfOffset)) / 1000)); }
    function rfTikk() {
      clearInterval(rfTimer);
      rfTimer = setInterval(function () {
        var s = tilstand && tilstand.spill, el = document.getElementById('rfTid');
        if (!s || s.type !== 'regelfabrikken' || s.fase !== 'skriv' || !el) { clearInterval(rfTimer); return; }
        var n = rfIgjen(s); el.textContent = n;
        el.classList.toggle('snart', n <= 10);
        if (n <= 0) { var inp = document.getElementById('rfInput'); if (inp) inp.disabled = true; var f = document.getElementById('rfTekst'); if (f) f.textContent = 'Tiden er ute!'; }
      }, 250);
    }
    function regelfabrikkenSpill(s) {
      rfOffset = s.naa - Date.now();
      if (s.fase === 'klar') {
        return '<p class="dl-melding dl-stor">Klar for Regelfabrikken?</p>' +
          '<p>Når klokka starter, har alle ' + s.sek + ' sekunder til å skrive så mange drikkekort de rekker på sin egen telefon.</p>' +
          '<p class="rom-status">' + tilstand.spillere.length + ' med i rommet: ' + tilstand.spillere.map(function (p) { return esc(p.navn); }).join(', ') + '</p>' +
          (erVert()
            ? '<p class="small">Vent til alle har blitt med. Del koden <b>' + esc(kode) + '</b>.</p><button class="rom-stor-knapp" data-g="startklokke" type="button">Start klokka</button>'
            : '<p class="rom-stor">Venter på at ' + esc(navn(tilstand.vert)) + ' starter klokka …</p>');
      }
      if (s.fase === 'skriv') {
        var n = rfIgjen(s);
        setTimeout(rfTikk, 0);
        var andre = tilstand.spillere.map(function (p) { return esc(p.navn) + ' ' + (s.antall[p.id] || 0); }).join(' · ');
        return '<div class="rf-tid" id="rfTid">' + n + '</div>' +
          '<p class="dl-melding" id="rfTekst">' + (n > 0 ? 'Skriv så mange drikkekort du rekker!' : 'Tiden er ute!') + '</p>' +
          '<form class="rf-skjema" id="rfSkjema"><label for="rfInput" class="small">F.eks. «Alle med hvite sokker drikker»</label>' +
          '<div class="rf-rad"><input id="rfInput" maxlength="140" autocomplete="off" enterkeyhint="send" placeholder="Skriv et kort …"' + (n > 0 ? '' : ' disabled') + '>' +
          '<button class="btn gold" type="submit">Legg til</button></div></form>' +
          '<ol class="rf-mine">' + s.mineKort.slice().reverse().map(function (t) { return '<li>' + esc(t) + '</li>'; }).join('') + '</ol>' +
          '<p class="rom-status">' + andre + '</p>' +
          (erVert() || n <= 0 ? '<button class="rom-stor-knapp" data-g="stokk" type="button">' + (n > 0 ? 'Stopp og stokk nå' : 'Stokk ' + s.totalt + ' kort') + '</button>' : '');
      }
      return '<div class="rom-kort rf-kort"><span class="sw-tag">Kort ' + (s.pos + 1) + ' av ' + s.totalt + '</span><p>' + esc(s.kortet) + '</p><span></span></div>' +
        '<button class="rom-stor-knapp" data-g="neste" data-pos="' + s.pos + '" type="button">Trekk neste</button>' +
        (erVert() ? '<button class="btn ghost" data-g="nytt" type="button">Ny skriverunde</button>' : '');
    }

    function tosannheterSpill(s) {
      var jeg = s.aktiv === tilstand.meg, han = esc(navn(s.aktiv));
      if (s.fase === 'skriv') {
        if (!jeg) return '<p class="rom-stor">' + han + ' skriver tre påstander …</p><p class="small">To er sanne, én er løgn. Gjør deg klar til å avsløre.</p>';
        return '<p class="rom-etikett">Din tur – bare du ser dette</p><p>Skriv tre påstander om deg selv og merk løgnen.</p>' +
          '<form id="tsSkjema" class="ts-skjema">' + [0, 1, 2].map(function (i) {
            return '<div class="ts-rad"><input id="tsR' + i + '" maxlength="120" placeholder="Påstand ' + (i + 1) + '"><label><input type="radio" name="tsL" value="' + i + '"> Løgn</label></div>';
          }).join('') + '<button class="rom-stor-knapp" type="submit">Send til de andre</button></form>';
      }
      var liste = '<div class="ts-valg">' + s.pastander.map(function (t, i) {
        var kl = s.fase === 'avslort' ? (i === s.logn ? 'logn' : 'sann') : '';
        var ant = s.stemmer ? Object.keys(s.stemmer).filter(function (k) { return s.stemmer[k] === i; }).length : 0;
        var knapp = s.fase === 'stem' && !jeg;
        return (knapp ? '<button type="button" data-g="stem" data-paa="' + i + '" aria-pressed="' + (s.minStemme === i) + '"' : '<div') + ' class="' + kl + '"><b>' + (i + 1) + '</b><span>' + esc(t) + '</span>' +
          (s.fase === 'avslort' ? '<small>' + ant + ' stemmer</small>' : '') + (knapp ? '</button>' : '</div>');
      }).join('') + '</div>';
      if (s.fase === 'stem') return '<p class="rom-etikett">' + (jeg ? 'De andre stemmer' : 'Hvilken er ' + han + ' sin løgn?') + '</p>' + liste +
        '<p class="rom-status">' + s.harStemt.length + ' av ' + (tilstand.spillere.length - 1) + ' har stemt</p>' +
        (erVert() || jeg ? '<button class="btn ghost" data-g="avslor" type="button">Avslør nå</button>' : '');
      return '<p class="rom-etikett">Fasit</p>' + liste +
        (s.drikker && s.drikker.length ? '<ul class="rom-drikker">' + s.drikker.map(function (x) { return '<li><b>' + esc(x.navn) + '</b> drikker ' + x.slurker + '</li>'; }).join('') + '</ul>' : '') +
        '<button class="rom-stor-knapp" data-g="runde" type="button">Neste spiller</button>';
    }
    function tegn() {
      if (!tilstand) return;
      var s = tilstand.spill, innhold = '';
      if (!s) innhold = lobby();
      else {
        innhold = '<div class="rom-spill"><p class="rom-spillnavn">' + esc(s.navn) + (s.modus && s.modus !== '*' && s.type !== 'bingo' ? ' · ' + esc(s.modus) : '') + '</p>' +
          ({ kort: kortSpill, mest: mestSpill, forraeder: forraederSpill, bingo: bingoSpill, opus: opusSpill, overunder: overunderSpill,
             veddelopet: veddelopetSpill, pyramiden: pyramidenSpill, gris: grisSpill, president: presidentSpill, regelfabrikken: regelfabrikkenSpill, tosannheter: tosannheterSpill }[s.type] || function () { return ''; })(s) + '</div>';
      }
      var vert = erVert() ? '<div class="rom-vert">' +
        (s ? '<button class="btn ghost small" data-g="avslutt" type="button">Bytt lek</button>' : '') +
        '<button class="btn ghost small" data-g="nullstill" type="button">Nullstill slurker</button></div>' : '';
      var tsLagret = [0, 1, 2].map(function (i) { var e = document.getElementById('tsR' + i); return e ? e.value : null; }), tsValgt = (document.querySelector('input[name=tsL]:checked') || {}).value;
      var y = window.scrollY, gammel = document.getElementById('rfInput'), gVerdi = gammel ? gammel.value : null, gFokus = gammel && document.activeElement === gammel;
      root.innerHTML = hode() + innhold + vert +
        '<p class="rom-forlat"><button class="linkbtn" data-g="forlat" type="button">Forlat rommet</button></p>';
      window.scrollTo(0, y);
      tsLagret.forEach(function (v, i) { var e = document.getElementById('tsR' + i); if (e && v !== null) e.value = v; });
      if (tsValgt !== undefined) { var r = document.querySelector('input[name=tsL][value="' + tsValgt + '"]'); if (r) r.checked = true; }
      var ny = document.getElementById('rfInput');
      if (ny && gVerdi !== null) { ny.value = gVerdi; if (gFokus) ny.focus({ preventScroll: true }); }
      var ts = document.getElementById('tsSkjema');
      if (ts) ts.addEventListener('submit', function (e) {
        e.preventDefault();
        var p = [0, 1, 2].map(function (i) { return document.getElementById('tsR' + i).value.trim(); });
        var l = ts.querySelector('input[name=tsL]:checked');
        if (p.some(function (x) { return !x; }) || !l) return toast('Skriv tre påstander og merk løgnen.');
        gjor({ handling: 'pastander', p: p, logn: Number(l.value) });
      });
      var sk = document.getElementById('rfSkjema');
      if (sk) sk.addEventListener('submit', function (e) {
        e.preventDefault();
        var i = document.getElementById('rfInput'), t = i.value.trim(); if (!t) return;
        i.value = ''; i.focus({ preventScroll: true });
        gjorAlltid({ handling: 'skriv', tekst: t });
      });
    }

    root.addEventListener('click', function (e) {
      var b = e.target.closest('[data-g]'); if (!b || !tilstand) return;
      var g = b.dataset.g;
      if (g === 'del') {
        var url = location.origin + '/no/rom?k=' + kode;
        var tekst = 'Bli med på Banterdeck! Kode: ' + kode;
        if (navigator.share) navigator.share({ title: 'Banterdeck', text: tekst, url: url }).catch(function () {});
        else if (navigator.clipboard) navigator.clipboard.writeText(tekst + '\n' + url).then(function () { toast('Lenken er kopiert'); });
        return;
      }
      if (g === 'forlat') { glemRom(); settAdresse(''); kode = ''; tegnStart(); return; }
      if (g === 'start') return gjor({ handling: 'start', lek: b.dataset.lek, modus: b.dataset.modus });
      if (g === 'neste') return gjor({ handling: 'neste', pos: Number(b.dataset.pos) });
      if (g === 'stem') return gjor({ handling: 'stem', paa: b.dataset.paa });
      if (g === 'merk') return gjor({ handling: 'merk', i: Number(b.dataset.i) });
      if (g === 'fjern') return gjor({ handling: 'fjern', id: b.dataset.id });
      if (g === 'gjett') return gjor({ handling: 'gjett', paa: b.dataset.paa });
      if (g === 'vedd') { var sl = document.getElementById('veddSl'); return gjor({ handling: 'vedd', farge: b.dataset.farge, slurker: sl ? Number(sl.value) : 2 }); }
      if (g === 'utfordre') return gjor({ handling: 'utfordre', paa: b.dataset.paa });
      if (g === 'velg') return gjor({ handling: 'velg', i: Number(b.dataset.i) });
      if (g === 'pvelg') { var i = Number(b.dataset.i), j = presValg.indexOf(i); if (j === -1) presValg.push(i); else presValg.splice(j, 1); b.setAttribute('aria-pressed', j === -1); return; }
      if (g === 'legg') { var valgte = presValg.slice(); presValg = []; return gjor({ handling: 'legg', kort: valgte }); }
      if (['kast', 'drop', 'lop', 'snu', 'nytt', 'pastand', 'nese', 'pass', 'stokk', 'startklokke'].indexOf(g) !== -1) return gjor({ handling: g });
      if (['avslutt', 'nullstill', 'svart', 'avslor', 'runde', 'nytt-brett'].indexOf(g) !== -1) return gjor({ handling: g });
    });

    /* ---------- oppstart ---------- */
    if (kode) meg = les('bd_rom_' + kode);
    if (kode && meg) { root.innerHTML = '<p class="rom-stor">Kobler til rom ' + esc(kode) + ' …</p>'; hent(); }
    else tegnStart();
  })();
  </script>
