---
// Se forklaringen i src/pages/categories/[id].astro.
import Category from '../../../components/pages/Category.astro';
import Redirect from '../../../components/Redirect.astro';
import { situationSectionsFor } from '../../../lib/content';
export function getStaticPaths() {
  return situationSectionsFor('no').map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props;
---
{s.kind === 'collection' ? <Category s={s} lang="no" /> : <Redirect to="/no/situations" />}
