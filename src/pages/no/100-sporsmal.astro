---
import Base from '../../layouts/Base.astro';
import SPM from '../../data/sporsmal.json';
---
<Base title="100 spørsmål" lang="no" gate={true}
      description="100 spørsmål på telefonen – velg blandet, gutta eller jentene, og snill, frekk eller drøy. Den som får snusboksen, drikker.">
  <p class="crumb"><a href="/no/">Forside</a> › <a href="/no/drinking-games">Drikkeleker</a> › 100 spørsmål</p>
  <h1>100 spørsmål</h1>
  <p class="lead">Les spørsmålet høyt og kast snusboksen – eller hva dere har for hånden – til den det passer best på. Den som tar imot, drikker, tar utfordringen og kaster videre.</p>

  <div id="hs" class="vp" aria-live="polite"></div>

  <p class="small vp-note">Hopp over alt som blir for mye – det er ingen skam. Spørsmålene blir gradvis drøyere utover i leken.</p>

  <script is:inline define:vars={{ SPM }}>
  (function () {
    var PUBLIKUM = [
      { v:'mix',    t:'Blandet',  d:'For alle' },
      { v:'gutter', t:'Gutta',    d:'Blandet + egne for gutta' },
      { v:'jenter', t:'Jentene',  d:'Blandet + egne for jentene' }];
    var NIVA = [
      { v:'snill', t:'Snill', d:'Trygt for alle',                 l:[1] },
      { v:'frekk', t:'Frekk', d:'Fylla, dating og pinligheter',   l:[1,2] },
      { v:'droy',  t:'Drøy',  d:'18+ – sex og hemmeligheter',     l:[2,3] }];
    var MAKS = 100, LAGRE = 'bd_100';
    var root, valg = { a:'mix', n:'frekk', u:true, s:false }, liste = [], nr = 0;
    try { var g = JSON.parse(localStorage.getItem(LAGRE) || 'null'); if (g) valg = Object.assign(valg, g); } catch (e) {}

    function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
    function stokk(a){ a=a.slice(); for (var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=a[i]; a[i]=a[j]; a[j]=t; } return a; }
    function nivaFor(v){ return NIVA.filter(function(x){ return x.v===v; })[0]; }
    function utvalg(){
      var niv = nivaFor(valg.n).l;
      return SPM.filter(function(s){
        return niv.indexOf(s.l) !== -1 && (s.a === 'mix' || s.a === valg.a);
      });
    }
    function vis(html){
      root.innerHTML = html;
      var topp = window.innerWidth < 900 ? 112 : 24, y = root.getBoundingClientRect().top;
      if (y < topp || y > window.innerHeight * 0.45) window.scrollTo({ top: window.scrollY + y - topp, behavior: 'smooth' });
    }
    function seg(k, alt){
      return '<div class="q-seg" data-k="'+k+'">'+alt.map(function(x){
        return '<button class="q-opt" data-v="'+x.v+'" aria-pressed="'+(valg[k]===x.v)+'"><b>'+x.t+'</b><span>'+x.d+'</span></button>'; }).join('')+'</div>';
    }

    function oppsett(){
      var n = Math.min(MAKS, utvalg().length);
      vis('<div class="vp-card">'+
        '<p class="q-lab">Hvem spiller?</p>'+seg('a', PUBLIKUM)+
        '<p class="q-lab">Hvor drøyt?</p>'+seg('n', NIVA)+
        '<label class="q-toggle"><input type="checkbox" id="hsU"'+(valg.u?' checked':'')+'> Med utfordringer</label>'+
        '<label class="q-toggle"><input type="checkbox" id="hsS"'+(valg.s?' checked':'')+'> Splash <span class="small">– mottakeren drikker to, naboene én hver</span></label>'+
        '<p class="small q-count">Dere får <b>'+n+'</b> spørsmål.</p>'+
        '<button class="btn gold vp-big" data-a="start">Start</button></div>');
    }
    function start(){
      try { localStorage.setItem(LAGRE, JSON.stringify(valg)); } catch (e) {}
      // tilfeldig utvalg, men sortert på nivå – så det blir gradvis drøyere
      liste = stokk(utvalg()).slice(0, MAKS).map(function(s,i){ return { s:s, r:Math.random() }; })
        .sort(function(a,b){ return a.s.l - b.s.l || a.r - b.r; }).map(function(x){ return x.s; });
      nr = 0; vis1();
    }
    function vis1(){
      var s = liste[nr], total = liste.length;
      vis('<div class="vp-card">'+
        '<div class="vp-clock"><span>'+(nr+1)+' / '+total+'</span><div class="vp-bar"><i style="width:'+((nr+1)/total*100)+'%"></i></div></div>'+
        '<p class="q-text">'+esc(s.q)+'</p>'+
        (valg.u && s.c ? '<p class="q-chal"><b>Utfordring:</b> '+esc(s.c)+'</p>' : '')+
        (valg.s ? '<p class="small q-splash">Splash: mottakeren drikker to, naboene én hver.</p>' : '')+
        '<button class="btn gold vp-big" data-a="neste">Neste</button>'+
        '<div class="q-row"><button class="btn ghost" data-a="tilbake"'+(nr===0?' disabled':'')+'>Tilbake</button>'+
        '<button class="btn ghost" data-a="avslutt">Avslutt</button></div></div>');
    }
    function neste(){
      nr++;
      if (nr >= liste.length) return ferdig();
      if (nr % 10 === 0) return skal();
      vis1();
    }
    function skal(){
      vis('<div class="vp-card vp-center"><p class="small">'+nr+' spørsmål unnagjort</p>'+
        '<p class="vp-grade g4">Skål!</p><h2>Alle skåler</h2><p>Hele bordet tar en slurk før dere fortsetter.</p>'+
        '<button class="btn gold vp-big" data-a="videre">Fortsett</button></div>');
    }
    function ferdig(){
      vis('<div class="vp-card vp-center"><p class="small">'+liste.length+' av '+liste.length+'</p>'+
        '<h2>Ferdig!</h2><p>Alle skåler en siste gang. Den som fikk snusboksen flest ganger, velger kveldens neste lek.</p>'+
        '<button class="btn gold vp-big" data-a="start">Spill igjen</button>'+
        '<button class="btn ghost" data-a="oppsett">Endre valg</button></div>');
    }

    function klikk(e){
      var b = e.target.closest('button'); if (!b || !root.contains(b)) return;
      var gruppe = b.closest('.q-seg');
      if (gruppe){ valg[gruppe.dataset.k] = b.dataset.v; return oppsett(); }
      var a = b.dataset.a;
      if (a==='start') start();
      else if (a==='neste') neste();
      else if (a==='videre') vis1();
      else if (a==='tilbake'){ if (nr>0){ nr--; vis1(); } }
      else if (a==='avslutt' || a==='oppsett') oppsett();
    }
    function endring(e){ if (e.target.id === 'hsU') valg.u = e.target.checked; if (e.target.id === 'hsS') valg.s = e.target.checked; }
    function init(){
      root = document.getElementById('hs');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = '1';
      root.addEventListener('click', klikk); root.addEventListener('change', endring);
      oppsett();
    }
    init(); document.addEventListener('astro:page-load', init);
  })();
  </script>
</Base>
