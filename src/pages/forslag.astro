---
import Base from '../layouts/Base.astro';
import { catSections, t } from '../lib/content';
const groups = catSections.filter((s) => s.id !== 'ordbok').flatMap((s) =>
  s.groups.map((g: any) => ({ id: `${s.id}.${g.id}`, label: `${s.emoji} ${t(s.title)}${g.title ? ' › ' + t(g.title) : ''}` }))
);
---
<Base title="Send inn en replikk" description="Har du en frekk, men morsom replikk? Send den inn – de beste havner i Banterdeck.">
  <h1>Send inn en replikk</h1>
  <p class="lead">Frekk, men morsom – det er hele regelen. De beste forslagene havner i stokken.</p>

  <form id="f" class="form" novalidate>
    <label>Hvilken situasjon passer den til?
      <select name="kategori" required>
        <option value="">Velg…</option>
        {groups.map((g) => <option value={g.id}>{g.label}</option>)}
      </select>
    </label>
    <label>Når sier man den? <span class="small">(valgfritt)</span>
      <input name="ctx" maxlength="120" placeholder="F.eks. Når noen kommer for sent" />
    </label>
    <label>Replikken
      <textarea name="line" rows="3" maxlength="300" required placeholder="Skriv replikken her"></textarea>
    </label>
    <label>Navn eller kallenavn <span class="small">(valgfritt – for æren)</span>
      <input name="navn" maxlength="60" />
    </label>
    <input name="website" class="hp" tabindex="-1" autocomplete="off" />
    <button class="btn gold" type="submit">Send inn</button>
    <p id="msg" class="small" role="status"></p>
  </form>

  <script is:inline>
    var f = document.getElementById('f'), msg = document.getElementById('msg');
    f.addEventListener('submit', async function (e) {
      e.preventDefault();
      var d = Object.fromEntries(new FormData(f).entries());
      if (!d.line || d.line.trim().length < 3) { msg.textContent = 'Skriv en replikk først.'; return; }
      var btn = f.querySelector('button'); btn.disabled = true; msg.textContent = 'Sender…';
      try {
        var r = await fetch('/api/forslag', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) });
        var j = await r.json();
        if (j.ok) { f.reset(); msg.textContent = 'Takk! Forslaget er sendt inn.'; }
        else msg.textContent = j.error || 'Noe gikk galt. Prøv igjen.';
      } catch (err) { msg.textContent = 'Noe gikk galt. Prøv igjen.'; }
      btn.disabled = false;
    });
  </script>
</Base>
