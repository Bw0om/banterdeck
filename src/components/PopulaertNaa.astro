---
/**
 * Topp 3: de tre mest spilte lekene de siste sju dagene, hentet fra /api/populaert.
 * Til det finnes nok data, vises tre klassikere – med en overskrift som sier akkurat det,
 * så vi aldri kaller et håndplukket utvalg for «mest spilt».
 */
import { gamesFor, gameHref, t } from '../lib/content';
import { illustrasjon } from '../lib/illustrasjon';
import { PLUSS_SLUGS } from '../lib/plussleker';
import { path, type Lang } from '../lib/i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const no = lang === 'no';
const PL = new Set(PLUSS_SLUGS);
const leker: Record<string, { n: string; h: string; b: string; pl: string; p: boolean }> = Object.fromEntries(gamesFor(lang).map((g: any) => [g.slug, {
  n: t(g.name, lang), h: gameHref(g, (p) => path(lang, p), lang), b: illustrasjon(g), pl: g.pl || '', p: PL.has(g.slug),
}]));
const STANDARD = ['ring-of-fire', '100-sporsmal', 'pekeleken', 'drikkehjulet', 'beer-pong', 'jeg-har-aldri'];
const utvalg = STANDARD.filter((s) => leker[s]).slice(0, 3);
const T = {
  tittel: no ? 'Tre å starte med' : 'Three to start with',
  sub: no ? 'Klassikerne folk kommer tilbake til.' : 'The classics people keep coming back to.',
  ekteTittel: no ? 'Topp 3 denne uka' : 'Top 3 this week',
  ekteSub: no ? 'Mest spilt på Mitt vors de siste sju dagene.' : 'Most played on Mitt vors in the last seven days.',
  spillere: no ? 'spillere' : 'players',
};
---
<section class="topp3" aria-labelledby="topp3Tittel">
  <div class="topp3-hode">
    <h2 id="topp3Tittel">{T.tittel}</h2>
    <p class="topp3-sub">{T.sub}</p>
  </div>
  <ol class="topp3-liste" data-topp3>
    {utvalg.map((s, i) => {
      const x = leker[s];
      return (
        <li class={`topp3-rad r${i + 1}`}>
          <a href={x.h}>
            <span class="topp3-bilde"><img src={x.b} alt="" width="240" height="126" loading="lazy" decoding="async" /></span>
            <span class="topp3-nr" aria-hidden="true">{i + 1}</span>
            <span class="topp3-tekst"><b>{x.n}</b><small>{x.pl && `${x.pl} ${T.spillere}`}{x.p && <i>Pluss</i>}</small></span>
          </a>
        </li>
      );
    })}
  </ol>
  <script type="application/json" data-topp3-oppslag set:html={JSON.stringify({ leker, T })}></script>
  <script is:inline data-astro-rerun>
  (function () {
    var root = document.currentScript.closest('.topp3');
    if (!root || root.dataset.bound) return; root.dataset.bound = '1';
    var d = JSON.parse(root.querySelector('[data-topp3-oppslag]').textContent), L = d.leker, T = d.T;
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    fetch('/api/populaert').then(function (r) { return r.ok ? r.json() : []; }).then(function (rader) {
      var topp = (rader || []).filter(function (x) { return x.type === 'lek' && L[x.ref]; }).slice(0, 3);
      if (topp.length < 3) return;                    // for lite data ennå – behold klassikerne
      root.querySelector('[data-topp3]').innerHTML = topp.map(function (x, i) {
        var o = L[x.ref];
        return '<li class="topp3-rad r' + (i + 1) + '"><a href="' + esc(o.h) + '">' +
          '<span class="topp3-bilde"><img src="' + esc(o.b) + '" alt="" width="240" height="126" decoding="async"></span>' +
          '<span class="topp3-nr" aria-hidden="true">' + (i + 1) + '</span>' +
          '<span class="topp3-tekst"><b>' + esc(o.n) + '</b><small>' + (o.pl ? esc(o.pl) + ' ' + T.spillere : '') + (o.p ? '<i>Pluss</i>' : '') + '</small></span></a></li>';
      }).join('');
      root.querySelector('#topp3Tittel').textContent = T.ekteTittel;
      root.querySelector('.topp3-sub').textContent = T.ekteSub;
    }).catch(function () {});
  })();
  </script>
</section>
