---
// Finn lek: fire spørsmål, tre forslag. Felles for /no/finn-lek (lang="no") og /find-a-game (lang="en").
import Base from '../../layouts/Base.astro';
import { gamesFor, gameHref, t } from '../../lib/content';
import { path, type Lang } from '../../lib/i18n';
const { lang = 'no' } = Astro.props as { lang?: Lang };
const no = lang === 'no';
const LEKER = gamesFor(lang).filter((g: any) => g.fit).map((g: any) => ({
  n: t(g.name, lang), h: gameHref(g, (p) => path(lang, p), lang),
  u: t(g.gear, lang), p: g.pl, f: g.fit,
}));
const antall = no ? '51' : String(gamesFor(lang).length);
---
<Base title={no ? 'Finn lek' : 'Find a game'} lang={lang} gate={true}
      description={no ? 'Fire spørsmål om kvelden, gjengen og hva dere har for hånden – så foreslår vi lekene som passer.' : "Four questions about the night, the crew and what you've got to hand – and we'll suggest the games that fit."}>
  {no
    ? <p class="crumb"><a href="/no/">Forside</a> › <a href="/no/drinking-games">Drikkeleker</a> › Finn lek</p>
    : <p class="crumb"><a href="/">Home</a> › <a href="/drinking-games">Drinking games</a> › Find a game</p>}
  <h1>{no ? 'Finn lek' : 'Find a game'}</h1>
  <p class="lead">{no ? `Fire spørsmål, så foreslår vi tre leker av de ${antall} vi har.` : `Four questions, and we'll suggest three games out of the ${antall} we've got.`}</p>
  <div id="fl" class="vp"></div>

  <script is:inline define:vars={{ LEKER, LANG: lang, ANTALL: antall }}>
  (function () {
    var EN = LANG === 'en';
    var SPM = EN ? [
      { k:'nar', s:'What kind of night is it?', a:[
        { v:'prevors', t:'Pre-pre-drinks' }, { v:'vors', t:'Pre-drinks' }, { v:'nach', t:'Afterparty' },
        { v:'bursdag', t:'Birthday or party' }, { v:'rolig', t:'Chill night in' }, { v:'skjerm', t:'In front of the TV' }] },
      { k:'ant', s:'How many of you are there?', a:[
        { v:'2', t:'Two' }, { v:'4', t:'Three to five' }, { v:'8', t:'Six to ten' }, { v:'14', t:'More than ten' }] },
      { k:'utstyr', s:"What have you got to hand?", a:[
        { v:'ingen', t:'Nothing' }, { v:'kort', t:'A deck of cards' }, { v:'terning', t:'Dice' },
        { v:'kopper', t:'Cups and a ball' }, { v:'musikk', t:'A sound system' }, { v:'mobil', t:'Just our phones' },
        { v:'skjerm', t:'A TV or console' }, { v:'*', t:"Doesn't matter" }] },
      { k:'tempo', s:'What pace?', a:[
        { v:'rolig', t:'Chill' }, { v:'sosialt', t:'Social' }, { v:'kaos', t:'Chaos' }, { v:'*', t:"Doesn't matter" }] },
    ] : [
      { k:'nar', s:'Hva slags kveld er det?', a:[
        { v:'prevors', t:'Pré-vors' }, { v:'vors', t:'Vors' }, { v:'nach', t:'Nachspiel' },
        { v:'bursdag', t:'Bursdag eller fest' }, { v:'rolig', t:'Rolig kveld' }, { v:'skjerm', t:'Foran TV-en' }] },
      { k:'ant', s:'Hvor mange er dere?', a:[
        { v:'2', t:'To' }, { v:'4', t:'Tre til fem' }, { v:'8', t:'Seks til ti' }, { v:'14', t:'Over ti' }] },
      { k:'utstyr', s:'Hva har dere for hånden?', a:[
        { v:'ingen', t:'Ingenting' }, { v:'kort', t:'Kortstokk' }, { v:'terning', t:'Terninger' },
        { v:'kopper', t:'Kopper og ball' }, { v:'musikk', t:'Musikkanlegg' }, { v:'mobil', t:'Bare mobilen' },
        { v:'skjerm', t:'TV eller konsoll' }, { v:'*', t:'Spiller ingen rolle' }] },
      { k:'tempo', s:'Hvilket tempo?', a:[
        { v:'rolig', t:'Rolig' }, { v:'sosialt', t:'Sosialt' }, { v:'kaos', t:'Kaos' }, { v:'*', t:'Spiller ingen rolle' }] },
    ];
    var root, svar = {}, steg = 0;
    function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
    function vis(html){
      root.innerHTML = html;
      var topp = window.innerWidth < 900 ? 112 : 24, y = root.getBoundingClientRect().top;
      if (y < topp || y > window.innerHeight * 0.5) window.scrollTo({ top: window.scrollY + y - topp, behavior: 'smooth' });
    }
    function sporsmal(){
      var q = SPM[steg];
      vis('<div class="vp-card"><p class="small">' + (EN ? 'Question ' : 'Spørsmål ') + (steg+1) + (EN ? ' of ' : ' av ') + SPM.length + '</p>' +
        '<h2>' + q.s + '</h2><div class="fl-opts">' +
        q.a.map(function(a){ return '<button class="fl-opt" data-v="'+a.v+'">'+esc(a.t)+'</button>'; }).join('') + '</div>' +
        (steg ? '<button class="btn ghost" data-a="tilbake">' + (EN ? 'Back' : 'Tilbake') + '</button>' : '') + '</div>');
    }
    function treff(){
      var ant = +svar.ant;
      return LEKER.map(function(l){
        var p = 0;
        if (ant < l.f.min || ant > l.f.maks) return null;
        if (svar.utstyr !== '*' && l.f.utstyr !== svar.utstyr && l.f.utstyr !== 'ingen') return null;
        if (svar.utstyr === l.f.utstyr) p += 2;
        if (l.f.nar.indexOf(svar.nar) !== -1) p += 3;
        if (ant === 2 && l.f.nar.indexOf('to') !== -1) p += 3;
        if (svar.tempo !== '*' && l.f.tempo === svar.tempo) p += 2;
        return { l: l, p: p + Math.random() };
      }).filter(Boolean).sort(function(a,b){ return b.p - a.p; }).slice(0, 3);
    }
    function svarene(){
      var s = [];
      SPM.forEach(function(q){ var a = q.a.filter(function(x){ return x.v === svar[q.k]; })[0]; if (a) s.push(a.t); });
      return s.join(' · ');
    }
    function resultat(){
      var r = treff();
      vis('<div class="vp-card"><p class="small">' + esc(svarene()) + '</p>' +
        (r.length ? '<h2>' + (EN ? 'Try these' : 'Prøv disse') + '</h2><div class="fl-hits">' + r.map(function(x){
          return '<a class="fl-hit" href="'+x.l.h+'"><span class="fl-n">'+esc(x.l.n)+'</span>' +
            '<span class="fl-m">'+esc(x.l.u)+' · '+esc(x.l.p)+(EN ? ' players' : ' spillere')+'</span></a>'; }).join('') + '</div>'
          : (EN ? '<h2>No matches</h2><p>Try “doesn’t matter” for what you’ve got.</p>' : '<h2>Ingen treff</h2><p>Prøv «spiller ingen rolle» på utstyr.</p>')) +
        '<button class="btn gold vp-big" data-a="omigjen">' + (EN ? 'Start over' : 'Start på nytt') + '</button>' +
        (EN ? '<a class="btn ghost" href="/drinking-games">See all ' + ANTALL + ' games</a>' : '<a class="btn ghost" href="/no/drinking-games">Se alle 51 lekene</a>') + '</div>');
    }
    function klikk(e){
      var b = e.target.closest('button'); if (!b || !root.contains(b)) return;
      if (b.dataset.v){ svar[SPM[steg].k] = b.dataset.v; steg++; return steg < SPM.length ? sporsmal() : resultat(); }
      if (b.dataset.a === 'tilbake' && steg > 0){ steg--; sporsmal(); }
      if (b.dataset.a === 'omigjen'){ steg = 0; svar = {}; sporsmal(); }
    }
    function init(){
      root = document.getElementById('fl');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = '1'; root.addEventListener('click', klikk); sporsmal();
    }
    init(); document.addEventListener('astro:page-load', init);
  })();
  </script>
</Base>
