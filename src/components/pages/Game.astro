---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import fs from 'node:fs';
import AdSlot from '../AdSlot.astro';
import GameTool from '../GameTool.astro';
import DigitalLek from '../DigitalLek.astro';
import DECKS from '../../data/decks.json';
import { ROMLEK, romLenke } from '../../lib/romlenke';
import { PLUSS_SLUGS } from '../../lib/plussleker';
import { lekebilde } from '../../lib/illustrasjon';
import { niva, provIAppen, HOOK } from '../../lib/niva';
import { gamesFor, gameHref, t, trules } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
const { game, lang = 'en' } = Astro.props as { game: any; lang?: Lang };
const L = ui(lang);
// Verktøy, rom og Pluss finnes på norsk og engelsk – men ikke for rent norske leker på engelsk side.
const verktoySprak = lang === 'no' || (lang === 'en' && !game.only && !(game.group && game.group.only));
const iRom = verktoySprak && ['pekeleken','jeg-har-aldri','enten-eller','kategorier','nodt-eller-sannhet','rygg-mot-rygg','ring-of-fire','forraeder','drikke-bingo','regelfabrikken','to-sannheter-og-en-logn','sannhet-eller-drikk','tanken-bak-sangen','over-eller-under','veddelopet','pyramiden','president','gris','bussruta','drikke-yatzy','nyhetsrunden','hvem-skrev-det','bloffquizen','samme-svar','spionen','hvem-er-jeg','skal-refleksen','hemmelig-oppdrag'].includes(game.slug);
const DIGITAL = ['power-hour','snurr-flasken','drikke-yatzy','to-sannheter-og-en-logn','over-eller-under','fuck-the-dealer','krig','veddelopet','bussruta','terningen-bestemmer','21-med-terninger','opus','regelfabrikken','pyramiden','president','gris'];
const harVerktoy = verktoySprak && (!!(DECKS as any)[game.slug] || game.slug === 'drikke-bingo' || DIGITAL.includes(game.slug));
const name = t(game.name, lang);
const plussLek = verktoySprak && PLUSS_SLUGS.includes(game.slug);
const rules: string[] = trules(game, lang);
// Hvor mye appen betyr for leken – rene regelleker får forslag om en lek som spilles i appen
const lekNiva = niva(game.slug);
const forslag = lekNiva === 'regler' ? provIAppen(game, gamesFor(lang)) : [];
const NIVA_IKON: Record<string, string> = { rom: 'telefon', app: 'kort', regler: 'ordbok' };
const NIVA_TEKST: Record<string, [string, string]> = { rom: ['Spilles fra hver sin telefon', 'Played from your own phones'], app: ['Telefonen er kortstokken', 'The phone is the deck'], regler: ['Bare regler', 'Just the rules'] };

const blocks: { type: 'p' | 'ul'; items: string[] }[] = [];
for (const r of rules) {
  if (r.startsWith('b|')) {
    const last = blocks[blocks.length - 1];
    if (last && last.type === 'ul') last.items.push(r.slice(2));
    else blocks.push({ type: 'ul', items: [r.slice(2)] });
  } else blocks.push({ type: 'p', items: [r] });
}
const description = `${name} – ${lang === 'no' ? 'regler for drikkeleken' : 'drinking game rules'}. ${t(game.gear, lang)}. ${game.pl} ${L.players}.`;
const copyText = name + '\n' + rules.map((r) => r.replace(/^b\|/, '• ')).join('\n');
// Samme gruppe først – en liste over alle 38 blir bare støy
const others = gamesFor(lang).filter((x) => x.slug !== game.slug && x.group.id === game.group.id);
// Delingsbilde per lek (laget på forhånd i public/og/lek). Nye leker får standardbildet.
const bilde = fs.existsSync(`public/og/lek/${game.slug}.jpg`) ? `/og/lek/${game.slug}.jpg` : '/og/drikkeleker.jpg';
const side = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = JSON.stringify([{
  '@context': 'https://schema.org', '@type': 'Article', headline: `${name} – ${lang === 'no' ? 'regler' : 'rules'}`,
  description, inLanguage: lang === 'no' ? 'nb' : 'en', isFamilyFriendly: false,
  image: new URL(bilde, Astro.site).toString(), mainEntityOfPage: side,
  publisher: { '@type': 'Organization', name: 'mittvors', url: 'https://www.mittvors.no' },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'no' ? 'Forside' : 'Home', item: new URL(path(lang, '/'), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: L.nav.games, item: new URL(path(lang, '/drinking-games'), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name, item: side },
  ],
}]);
---
<Base title={`${name} – ${lang === 'no' ? 'regler' : 'rules'}`} description={description} lang={lang} gate={true} bilde={bilde}>
  <Fragment slot="head"><script type="application/ld+json" set:html={jsonLd} /></Fragment>
  <p class="crumb">
    <a href={path(lang, '/')}>{L.breadcrumbHome}</a> ›
    <a href={path(lang, '/drinking-games')}>{L.gamesTitle}</a> › {name}
  </p>
  <!-- Toppen: illustrasjonen stort, så navnet, så fakta på én linje (ingen bokser) -->
  <figure class="lek-banner" set:html={lekebilde(game)} />
  <h1 class="lek-navn">{name}</h1>
  {game.fra && <p class="lek-fra">{lang === 'no' ? 'Sendt inn av' : 'Submitted by'} <b>{game.fra}</b></p>}
  <ul class="lek-fakta">
    <li class={`lek-niva ${lekNiva}`}><Icon name={NIVA_IKON[lekNiva]} size={15} />{NIVA_TEKST[lekNiva][lang === 'en' ? 1 : 0]}</li>
    <li><Icon name="gjeng" size={15} />{game.pl} {lang === 'no' ? 'spillere' : 'players'}</li>
    <li>{t(game.gear, lang)}</li>
    <li>{t(game.group.title, lang)}</li>
  </ul>
  {lang === 'no' && <p class="alkfri-linje"><button type="button" class="alkfri-bryter" data-alkoholfri-bryter aria-pressed="false"><span class="alkfri-knott" aria-hidden="true"></span>Alkoholfri modus</button></p>}
  {lang === 'en' && <p class="alkfri-linje"><button type="button" class="alkfri-bryter" data-alkoholfri-bryter aria-pressed="false"><span class="alkfri-knott" aria-hidden="true"></span>Alcohol-free mode</button></p>}
  {(harVerktoy || iRom) && (
    <p class="startrow" data-irom={iRom ? '1' : undefined}>
      {iRom && <a class="btn ghost romlenke" href={romLenke(game.slug, '', lang)}><span class="bare-nett">{lang === 'en' ? 'Play from your own phones' : 'Spill fra hver sin telefon'}</span><span class="bare-app">{lang === 'en' ? 'Play in the room' : 'Spill i rommet'}</span></a>}
      {harVerktoy && <a class="btn start" href="#lekverktoy">{iRom ? <><span class="bare-nett">{lang === 'no' ? 'Start leken' : 'Start the game'}</span><span class="bare-app">{lang === 'no' ? 'Bare én telefon' : 'Just one phone'}</span></> : (lang === 'no' ? 'Start leken' : 'Start the game')}{plussLek && <Icon name="gnist" size={16} />}<span aria-hidden="true">↓</span></a>}
    </p>
  )}

  <h2 class="lek-h">{lang === 'no' ? 'Slik spiller dere' : 'How to play'}</h2>
  <div class="rules">
    {blocks.map((b) => b.type === 'p' ? <p>{b.items[0]}</p> : <ul>{b.items.map((x) => <li>{x}</li>)}</ul>)}
  </div>
  <p class="gameacts">
    {game.link && <a class="btn gold" href={game.link.href} target="_blank" rel="noopener">{game.link.label} ↗</a>}
    <button class="btn ghost" data-copy={copyText}>{L.copyRules}</button>
  </p>

  {forslag.length > 0 && (
    <aside class="prov-appen">
      <p class="rom-etikett">{lang === 'en' ? 'Like this game?' : 'Liker dere denne?'}</p>
      <h2>{lang === 'en' ? 'Try one you play from your own phones' : 'Prøv en dere spiller fra hver deres telefon'}</h2>
      <div class="prov-appen-leker">
        {forslag.map((x: any) => (
          <a href={gameHref(x, (p) => path(lang, p), lang)}>
            <Fragment set:html={lekebilde(x)} />
            <span><b>{t(x.name, lang)}</b><small>{HOOK[x.slug] ? HOOK[x.slug][lang === 'en' ? 1 : 0] : ''}</small></span>
          </a>
        ))}
      </div>
      <a class="btn gold" href={lang === 'en' ? '/room' : '/no/rom'}>{lang === 'en' ? 'Create a room – it’s free' : 'Lag et rom – det er gratis'}</a>
    </aside>
  )}

  <!-- Appen: når den native lekesiden har trukket seg til side for kortbunken, er dette raden øverst – tilbake til reglene -->
  <div class="lv-topp"><button type="button" class="lv-tilbake" data-lv-tilbake><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>{lang === 'en' ? 'The rules' : 'Reglene'}</button><b>{name}</b></div>
  <div id="lekverktoy" class:list={[plussLek && 'pluss-laast']} data-pluss={plussLek ? '1' : undefined}>
    {plussLek && lang !== 'en' && (
      <div class="pluss-laas" id="plussLaas">
        <p class="rom-etikett"><Icon name="gnist" size={14} />Pluss</p>
        <p><b>Spill {name} på mobilen med mittvors pluss.</b> Reglene over er gratis – med Pluss blir telefonen kortstokken, og i rom får alle være med.</p>
        <div class="dl-knapper"><a class="btn gold" href="/no/pluss">Første kveld er gratis</a></div>
      </div>
    )}
    {plussLek && lang === 'en' && (
      <div class="pluss-laas" id="plussLaas">
        <p class="rom-etikett"><Icon name="gnist" size={14} />Pluss</p>
        <p><b>Play {name} on your phone with mittvors pluss.</b> The rules above are free – with Pluss the phone becomes the deck, and in a room everyone can join in.</p>
        <div class="dl-knapper"><a class="btn gold" href="/plus">Your first night is free</a></div>
      </div>
    )}
    {plussLek
      ? <div class="lekverktoy-innhold" data-verktoy={game.slug} data-lang={lang}></div>
      : <div class="lekverktoy-innhold">{verktoySprak && <GameTool slug={game.slug} lang={lang} />}{verktoySprak && <DigitalLek slug={game.slug} lang={lang} />}</div>}
  </div>
  {plussLek && (
    <script is:inline data-astro-rerun>
    (function () {
      var el = document.querySelector('[data-pluss="1"]'); if (!el || el.dataset.bound) return; el.dataset.bound = '1';
      var K = window.BDKonto; if (!K || !K.les()) return;
      // Verktøyet hentes fra serveren, som sjekker Pluss først
      var boks = el.querySelector('[data-verktoy]'); if (!boks) return;
      K.api('/pluss-verktoy?slug=' + encodeURIComponent(boks.dataset.verktoy) + '&lang=' + boks.dataset.lang).then(function (r) {
        if (!r.ok) return;
        return r.text().then(function (html) {
          var mal = document.createElement('template'); mal.innerHTML = html;
          boks.appendChild(mal.content);
          // Skript satt inn med innerHTML kjører ikke – lag dem på nytt, der de står, så document.currentScript stemmer
          boks.querySelectorAll('script').forEach(function (gammel) {
            var ny = document.createElement('script');
            for (var i = 0; i < gammel.attributes.length; i++) ny.setAttribute(gammel.attributes[i].name, gammel.attributes[i].value);
            ny.textContent = gammel.textContent;
            gammel.parentNode.replaceChild(ny, gammel);
          });
          el.classList.remove('pluss-laast');
        });
      }).catch(function () {});
    })();
    </script>
  )}
  <span hidden data-spilt={`lek:${game.slug}`}></span>

  <script is:inline define:vars={{ LEKESIDE: {
    skjerm: 'lekeside', slug: game.slug, navn: name, fra: game.fra || '', niva: lekNiva, nivaTekst: NIVA_TEKST[lekNiva][lang === 'en' ? 1 : 0],
    pl: `${game.pl} ${lang === 'no' ? 'spillere' : 'players'}`, utstyr: t(game.gear, lang), gruppe: t(game.group.title, lang),
    iRom: iRom, romHref: iRom ? romLenke(game.slug, '', lang) : '', harVerktoy: harVerktoy, pluss: plussLek,
    link: game.link ? { href: game.link.href, label: game.link.label } : null, kopier: copyText,
    regler: blocks, forslag: forslag.map((x: any) => ({ href: gameHref(x, (p) => path(lang, p), lang), navn: t(x.name, lang), hook: HOOK[x.slug] ? HOOK[x.slug][lang === 'en' ? 1 : 0] : '' })),
    flere: others.map((x) => ({ href: gameHref(x, (p) => path(lang, p), lang), navn: t(x.name, lang), pl: `${x.pl} ${lang === 'no' ? 'spillere' : 'players'}` })),
    tekst: lang === 'en' ? {
      tilbake: 'Back', sendtInn: 'Submitted by', alkfri: 'Alcohol-free mode', rom: 'Play in the room', enTelefon: 'Just one phone', start: 'Start the game',
      slik: 'How to play', kopier: L.copyRules, kopiert: L.copied, likerDere: 'Like this game?', provEn: 'Try one you play from your own phones', lagRom: 'Create a room – it’s free',
      flere: `${L.moreGames}: ${t(game.group.title, lang).toLowerCase()}`, alle: L.allGames, pluss: 'Pluss', plussTekst: `Play ${name} on your phone with mittvors pluss. The rules are free.`,
    } : {
      tilbake: 'Tilbake', sendtInn: 'Sendt inn av', alkfri: 'Alkoholfri modus', rom: 'Spill i rommet', enTelefon: 'Bare én telefon', start: 'Start leken',
      slik: 'Slik spiller dere', kopier: L.copyRules, kopiert: L.copied, likerDere: 'Liker dere denne?', provEn: 'Prøv en dere spiller fra hver deres telefon', lagRom: 'Lag et rom – det er gratis',
      flere: `${L.moreGames}: ${t(game.group.title, lang).toLowerCase()}`, alle: L.allGames, pluss: 'Pluss', plussTekst: `Spill ${name} på mobilen med mittvors pluss. Reglene er gratis.`,
    } }, ROM_FANE: lang === 'en' ? '/room' : '/no/rom', LEKER_SIDE: path(lang, '/drinking-games') }}>
    /* Appen med Swift-skall: lekesiden er native (ios/App/App/LekesideSkjerm.swift). Siden gir innholdet dit (reglene, knappene, bildene som PNG),
       og gjør jobben når du trykker: rommet, kortbunken, alkoholfri, kopier. Samme mønster som lekelista (GamesIndex.astro). */
    (function start() {
      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', start); return; }
      var h = document.documentElement;
      if (!h.classList.contains('har-skall')) {
        if (!window.Capacitor) return;
        new MutationObserver(function (_, obs) { if (h.classList.contains('har-skall')) { obs.disconnect(); start(); } }).observe(h, { attributes: true, attributeFilter: ['class'] });
        return;
      }
      /** Et bilde på siden (inline SVG eller <img>) som PNG (base64) – den native skjermen tegner ikke SVG */
      function png(el, bredde) {
        return new Promise(function (res) {
          if (!el) return res('');
          var w = bredde || 480;
          function tegn(img, nw, nh) { try { var c = document.createElement('canvas'); c.width = w; c.height = Math.round(w * (nh || 126) / (nw || 240)); c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); res(c.toDataURL('image/png').split(',')[1] || ''); } catch (e) { res(''); } }
          var img = new Image();
          img.onerror = function () { res(''); };
          if (el.tagName === 'IMG') { img.onload = function () { tegn(img, img.naturalWidth, img.naturalHeight); }; img.src = el.currentSrc || el.src; return; }
          var vb = (el.getAttribute('viewBox') || '0 0 240 126').split(/[\s,]+/).map(Number);
          var k = el.cloneNode(true); k.setAttribute('width', String(w)); k.setAttribute('height', String(Math.round(w * (vb[3] || 126) / (vb[2] || 240)))); k.removeAttribute('class');
          img.onload = function () { tegn(img, vb[2], vb[3]); };
          img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(new XMLSerializer().serializeToString(k));
        });
      }
      function egenAlkfri() { try { return localStorage.getItem('bd_alkoholfri') === '1'; } catch (e) { return false; } }
      var d = LEKESIDE, bilder = { banner: '' };
      // Bildene til «Flere leker» og forslagene ligger alt på siden – i samme rekkefølge som listene
      var flereBilder = Array.prototype.slice.call(document.querySelectorAll('.lek-flere-rad .lekebilde'));
      var forslagBilder = Array.prototype.slice.call(document.querySelectorAll('.prov-appen-leker .lekebilde'));
      function meld() {
        d.alkfri = egenAlkfri();
        d.png = bilder.banner;
        d.flere.forEach(function (x, i) { x.png = bilder['f' + i] || ''; });
        d.forslag.forEach(function (x, i) { x.png = bilder['p' + i] || ''; });
        window.__mvSisteSkjerm = d;   // app.js lytter kanskje ikke ennå (det lastes etter siden): det henter meldingen her når det starter
        try { document.dispatchEvent(new CustomEvent('mv-skjerm', { detail: d })); } catch (e) {}
      }
      function visVerktoy(paa) {
        h.classList.toggle('lek-verktoy', paa);
        if (paa) {
          // Den native skjermen går til side, kortbunken får hele siden
          window.__mvSisteSkjerm = { skjerm: 'verktoy' };
          try { document.dispatchEvent(new CustomEvent('mv-skjerm', { detail: { skjerm: 'verktoy' } })); } catch (e) {}
          window.scrollTo(0, 0);
        } else { window.scrollTo(0, 0); meld(); }
      }
      meld();
      // Bildene tar et øyeblikk: innholdet kommer først, bildene i neste melding
      Promise.all([png(document.querySelector('.lek-banner .lekebilde'), 720).then(function (b) { bilder.banner = b; })]
        .concat(flereBilder.map(function (el, i) { return png(el).then(function (b) { bilder['f' + i] = b; }); }))
        .concat(forslagBilder.map(function (el, i) { return png(el).then(function (b) { bilder['p' + i] = b; }); }))).then(meld);
      var tilbakeKnapp = document.querySelector('[data-lv-tilbake]');
      if (tilbakeKnapp) tilbakeKnapp.addEventListener('click', function () { visVerktoy(false); });
      window.__mvLekeside = {
        gaa: function (u) { if (/^\/[a-z0-9/?=&%#-]*$/i.test(String(u || ''))) location.href = u; },
        // Tilbake til lista: historikken om vi kom derfra, ellers lista direkte (lenke rett inn i appen)
        tilbake: function () { if (history.length > 1) history.back(); else location.href = LEKER_SIDE; },
        // Rommet ligger i Spill-fanen: et lenketrykk, så app.js åpner den i riktig fane
        rom: function () { var a = document.querySelector('.startrow .romlenke'); if (a) { a.click(); return; } var b = document.createElement('a'); b.href = d.romHref || ROM_FANE; document.body.appendChild(b); b.click(); b.remove(); },
        verktoy: function () { visVerktoy(true); },
        alkfri: function (v) { if (window.BDTorr) window.BDTorr.sett(!!v); meld(); },
        kopier: function () {
          var ferdig = function () { try { document.dispatchEvent(new CustomEvent('mv-toast', { detail: { tekst: d.tekst.kopiert } })); } catch (e) {} };
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(d.kopier).then(ferdig, ferdig); else ferdig();
        },
        lenke: function () { if (d.link && d.link.href) window.open(d.link.href, '_blank', 'noopener'); }
      };
    })();
  </script>

  <AdSlot />

  <section class="lek-flere" aria-labelledby="lekFlere">
    <div class="lek-flere-hode">
      <h2 id="lekFlere">{L.moreGames}: {t(game.group.title, lang).toLowerCase()}</h2>
      <a href={path(lang, '/drinking-games')}>{L.allGames} <span aria-hidden="true">→</span></a>
    </div>
    <ul class="lek-flere-rad" role="list">
      {others.map((x) => (
        <li><a href={gameHref(x, (p) => path(lang, p), lang)}>
          <Fragment set:html={lekebilde(x)} />
          <b>{t(x.name, lang)}</b><small>{x.pl} {lang === 'no' ? 'spillere' : 'players'}</small>
        </a></li>
      ))}
    </ul>
  </section>
</Base>
