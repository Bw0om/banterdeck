---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Card from '../Card.astro';
import AdSlot from '../AdSlot.astro';
import Sveip from '../Sveip.astro';
import { itemsForSituation, dictForSituation, dictAnchor, dictViewOf, DICT_VIEWS, situationsFor, tdef, t, tf } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
const { sit, lang = 'en' } = Astro.props as { sit: any; lang?: Lang };
const L = ui(lang);
const title = t(sit.title, lang);
const rows = itemsForSituation(sit.id, lang);
const exprs = dictForSituation(sit.id, lang);
const sveipItems = rows.map(({ it }: any) => ({ l: tf(it, 'line', lang), k: '' }));
const related = situationsFor(lang).filter((x) => x.theme.id === sit.theme.id && x.id !== sit.id);
const description = lang === 'no'
  ? `${rows.length} replikker til når ${title.toLowerCase()}. Klikk for å kopiere.`
  : `${rows.length} lines for when ${title.toLowerCase()}. Click to copy.`;
---
<Base title={title} description={description} lang={lang}>
  <p class="crumb">
    <a href={path(lang, '/')}>{L.breadcrumbHome}</a> ›
    <a href={path(lang, '/situations')}>{L.linesTitle}</a> › {title}
  </p>
  <h1>{title}</h1>
  <span hidden data-spilt={`situasjon:${sit.id}`}></span>
  <p class="sit-meta"><span>{rows.length} {lang === 'no' ? 'replikker' : 'lines'}</span><em>{t(sit.theme.title, lang)}</em></p>
  <p class="sw-open-row">
    <button class="btn gold" type="button" data-sveip>{lang === 'no' ? 'Sveip gjennom' : 'Swipe through'}</button>
  </p>

  <div class="cards replikker">
    {rows.map(({ it }) => <Card it={it} lang={lang} mode="clean" cue={sit.cue} />)}
  </div>

  {exprs.length > 0 && (
    <section class="exprbox">
      <h2 class="withicon"><Icon name="ordbok" size={22} />{L.fitsExpr}</h2>
      <p class="small">{L.fitsExprLead}</p>
      <div class="exprlist">
        {exprs.map(({ it, g }) => (
          <a class="expr" href={path(lang, DICT_VIEWS[dictViewOf(g.id)].sti) + '#' + dictAnchor(it.word)}>
            <span class="ew">{it.word}</span>
            <span class="ed">{tdef(it, lang)}</span>
            <span class="eg">{t(g.title, lang)}</span>
          </a>
        ))}
      </div>
      <p style="margin-top:12px"><a href={path(lang, '/ord')}>{L.ordTitle} →</a> <a href={path(lang, '/uttrykk')} style="margin-left:14px">{L.uttrykkTitle} →</a></p>
    </section>
  )}

  <AdSlot />

  {related.length > 0 && (
    <section class="more">
      <h2>{L.related}</h2>
      <ul class="sit-relatert">
        {related.map((x) => (
          <li><a href={path(lang, `/situations/${x.id}`)}>{t(x.title, lang)}<span>{x.count}</span></a></li>
        ))}
      </ul>
      <p class="sit-alle"><a class="btn ghost" href={path(lang, '/situations')}>{L.allSituations}</a></p>
    </section>
  )}
  <Sveip items={sveipItems} title={title} lang={lang} />
</Base>

<style>
  .sit-meta{display:flex;align-items:baseline;gap:12px;margin:8px 0 22px;color:var(--muted);font-size:16.5px}
  .sit-meta em{font-family:var(--serif);font-style:italic;color:var(--gold-t);font-size:18px}
  .sit-meta em::before{content:"";display:inline-block;width:22px;height:1px;background:var(--hårstrek);vertical-align:middle;margin-right:12px}
  .sit-relatert{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px 22px}
  .sit-relatert a{font-family:var(--serif);font-size:19px;font-weight:500;color:var(--ink);text-decoration:none;display:inline-flex;align-items:baseline;gap:7px;padding:6px 0}
  .sit-relatert span{font-style:italic;font-size:15px;color:var(--gold-t)}
  @media (hover:hover) and (pointer:fine){.sit-relatert a:hover{color:var(--gold-t)}}
  .sit-alle{margin-top:22px}
</style>
