---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Card from '../Card.astro';
import AdSlot from '../AdSlot.astro';
import { itemsForSituation, dictForSituation, dictAnchor, situationsFor, tdef, t } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
const { sit, lang = 'en' } = Astro.props as { sit: any; lang?: Lang };
const L = ui(lang);
const title = t(sit.title, lang);
const rows = itemsForSituation(sit.id, lang);
const exprs = dictForSituation(sit.id, lang);
const related = situationsFor(lang).filter((x) => x.theme.id === sit.theme.id && x.id !== sit.id);
const description = lang === 'no'
  ? `${rows.length} replikker til når ${title.toLowerCase()}. Klikk for å kopiere.`
  : `${rows.length} lines for when ${title.toLowerCase()}. Click to copy.`;
---
<Base title={title} description={description} lang={lang}>
  <p class="crumb">
    <a href={path(lang, '/')}>{L.breadcrumbHome}</a> ›
    <a href={path(lang, '/situations')}>{L.linesTitle}</a> › {title}
  </p>
  <h1>{sit.emoji} {title}</h1>
  <p class="lead">{rows.length} {L.itemsLabel} · {t(sit.theme.title, lang)}</p>

  <div class="cards" style="margin-top:22px">
    {rows.map(({ it }) => <Card it={it} lang={lang} mode="clean" cue={sit.cue} />)}
  </div>

  {exprs.length > 0 && (
    <section class="exprbox">
      <h2 class="withicon"><Icon name="ordbok" size={22} />{L.fitsExpr}</h2>
      <p class="small">{L.fitsExprLead}</p>
      <div class="exprlist">
        {exprs.map(({ it, g }) => (
          <a class="expr" href={path(lang, '/dictionary') + '#' + dictAnchor(it.word)}>
            <span class="ew">{it.word}</span>
            <span class="ed">{tdef(it, lang)}</span>
            <span class="eg">{t(g.title, lang)}</span>
          </a>
        ))}
      </div>
      <p style="margin-top:12px"><a href={path(lang, '/dictionary')}>{L.seeDict} →</a></p>
    </section>
  )}

  <AdSlot />

  {related.length > 0 && (
    <section class="more">
      <h2>{L.related}</h2>
      <div class="sitchips">
        {related.map((x) => (
          <a class="sitchip" href={path(lang, `/situations/${x.id}`)}>
            <span class="st">{t(x.title, lang)}</span><b>{x.count}</b>
          </a>
        ))}
      </div>
      <p style="margin-top:18px"><a class="btn ghost" href={path(lang, '/situations')}>{L.allSituations}</a></p>
    </section>
  )}
</Base>
