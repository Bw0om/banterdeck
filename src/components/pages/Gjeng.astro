---
// Faste gjenger: poeng som samles over flere kvelder, med sesongtabell og kåringer.
// /no/gjeng viser gjengene dine, /no/gjeng?k=KODE viser én gjeng (alle med lenken kan se tabellen).
// Engelsk: /crew og /crew?k=KODE.
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../lib/i18n';
import { lekeliste } from '../../lib/rom';
const { lang = 'no' } = Astro.props as { lang?: Lang };
const no = lang === 'no';
// Lekene verten kan velge når kvelden startes fra gjengen (spilles fra hver sin telefon)
const UTVALG = ['spion', 'hvemskrev', 'bloff', 'samme', 'pannekort', 'mest', 'forraeder', 'tosannheter', 'nyhetsrunden', 'skal', 'bussruta', 'yatzy', 'president', 'pyramiden', 'regelfabrikken', 'veddelopet', 'overunder', 'ring-of-fire', 'bingo'];
const alle = lekeliste(lang);
const LEKER = [{ id: 'bors', navn: no ? '📈 Vorsbørsen (hele kvelden)' : '📈 The Exchange (all night)' }]
  .concat(UTVALG.map((id) => alle.find((x: any) => x.id === id)).filter(Boolean).map((x: any) => ({ id: x.id, navn: x.navn })));
---
<Base title={no ? 'Gjengen' : 'The crew'} description={no ? 'Samle poengene fra kveld til kveld: sesongtabell, kåringer og rivalisering for vennegjengen.' : 'Keep score from night to night: a season table, awards and rivalries for your group of friends.'} lang={lang} noindex={true} bilde="/og/drikkeleker.jpg">
  <div id="gjeng" class="gjeng"><p class="small">{no ? 'Henter …' : 'Loading …'}</p></div>

  <script is:inline data-astro-rerun define:vars={{ LANG: lang, LEKER }}>
  (function () {
    var root = document.getElementById('gjeng');
    if (!root || root.dataset.bound) return; root.dataset.bound = '1';
    var EN = LANG === 'en';
    var SIDE = EN ? '/crew' : '/no/gjeng', KONTO = EN ? '/account' : '/no/account', ROM = EN ? '/room' : '/no/rom';
    var K = window.BDKonto;
    var kode = (new URL(location.href).searchParams.get('k') || '').toUpperCase();
    var G = null, sesong = String(new Date().getFullYear()), sorter = 'slurker';
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function dato(d) { return new Date(d).toLocaleDateString(EN ? 'en-GB' : 'nb-NO', { weekday: 'short', day: 'numeric', month: 'short', year: new Date(d).getFullYear() === new Date().getFullYear() ? undefined : 'numeric' }); }
    function desimal(x) { return EN ? x.toFixed(1) : x.toFixed(1).replace('.', ','); }
    function innlogget() { return !!(K && K.les && K.les()); }
    function hode() { return EN ? { 'x-lang': 'en' } : undefined; }
    function kall(sti, body) {
      var opts = body ? { method: 'POST', body: JSON.stringify(body) } : {};
      if (EN) opts.headers = hode();
      return K.api(sti, opts).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (d) { d._ok = r.ok; d._status = r.status; return d; });
      });
    }
    function feil(t) { return '<p class="rom-feil">' + esc(t) + '</p>'; }
    function lenke(g) { return location.origin + SIDE + '?k=' + g.kode; }
    function inviter(g) {
      if (EN) return window.BDDel.lenke(lenke(g), 'Join the crew ' + g.navn + ' on Mitt vors – here’s our season table 🏆', {
        tittel: 'Invite to ' + g.navn, ingress: 'Anyone with the link can see the table. Those who create an account and join can also start rooms for the crew.',
      });
      window.BDDel.lenke(lenke(g), 'Bli med i gjengen ' + g.navn + ' på Mitt vors – her er sesongtabellen vår 🏆', {
        tittel: 'Inviter til ' + g.navn, ingress: 'Alle med lenken ser tabellen. De som lager konto og blir med, kan også starte rom for gjengen.',
      });
    }

    /* ---------- mine gjenger ---------- */
    function mine() {
      if (!innlogget()) {
        root.innerHTML = EN
          ? '<h1>Regular crews</h1><p class="lead">Keep score from night to night. Who’s the thirstiest of the year? Who wins the quiz most often?</p>' +
            forklaring() +
            '<p><a class="btn gold" href="' + KONTO + '">Log in or create a free account</a></p>' +
            '<p class="small">Got a crew link? Open it – you can see the table without an account.</p>'
          : '<h1>Faste gjenger</h1><p class="lead">Samle poengene fra kveld til kveld. Hvem er årets tørstigste? Hvem vinner quizen oftest?</p>' +
            forklaring() +
            '<p><a class="btn gold" href="/no/account">Logg inn eller lag gratis konto</a></p>' +
            '<p class="small">Har du fått en gjenglenke? Åpne den – tabellen kan ses uten konto.</p>';
        return;
      }
      var tittel = EN ? 'Your crews' : 'Gjengene dine';
      root.innerHTML = '<h1>' + tittel + '</h1><p class="small">' + (EN ? 'Loading …' : 'Henter …') + '</p>';
      kall('/api/gjeng').then(function (d) {
        if (!d._ok) { root.innerHTML = '<h1>' + tittel + '</h1>' + feil(d.melding || (EN ? 'Couldn’t load your crews.' : 'Fikk ikke hentet gjengene.')); return; }
        var l = d.gjenger || [];
        root.innerHTML = '<h1>' + tittel + '</h1><p class="lead">' + (EN ? 'Points that add up over many nights – with a season table and awards.' : 'Poeng som samles over flere kvelder – med sesongtabell og kåringer.') + '</p>' +
          (l.length ? '<ul class="gj-liste">' + l.map(function (g) {
            return '<li><a href="' + SIDE + '?k=' + g.kode + '"><b>' + esc(g.navn) + '</b><span>' + g.kvelder + ' ' + (EN ? (g.kvelder === 1 ? 'night' : 'nights') : (g.kvelder === 1 ? 'kveld' : 'kvelder')) +
              (g.sist ? (EN ? ' · last ' : ' · sist ') + dato(g.sist) : '') + (g.eier ? (EN ? ' · you own it' : ' · du eier') : '') + '</span></a></li>';
          }).join('') + '</ul>' : forklaring()) +
          (EN
            ? '<form class="form gj-skjema" id="gjLag"><label class="lab" for="gjNavn">Create a new crew</label>' +
              '<div class="gj-rad"><input id="gjNavn" maxlength="40" placeholder="E.g. The Usual Suspects" required><button class="btn gold" type="submit">Create crew</button></div></form>' +
              '<form class="form gj-skjema" id="gjBli"><label class="lab" for="gjKode">Got a crew code?</label>' +
              '<div class="gj-rad"><input id="gjKode" maxlength="8" placeholder="8 characters" autocapitalize="characters" required><button class="btn ghost" type="submit">Join</button></div></form>'
            : '<form class="form gj-skjema" id="gjLag"><label class="lab" for="gjNavn">Lag en ny gjeng</label>' +
              '<div class="gj-rad"><input id="gjNavn" maxlength="40" placeholder="F.eks. Gutta på tur" required><button class="btn gold" type="submit">Lag gjeng</button></div></form>' +
              '<form class="form gj-skjema" id="gjBli"><label class="lab" for="gjKode">Har du en gjengkode?</label>' +
              '<div class="gj-rad"><input id="gjKode" maxlength="8" placeholder="8 tegn" autocapitalize="characters" required><button class="btn ghost" type="submit">Bli med</button></div></form>') +
          '<p id="gjMld"></p>';
        root.querySelector('#gjLag').addEventListener('submit', function (e) {
          e.preventDefault();
          kall('/api/gjeng', { handling: 'lag', navn: root.querySelector('#gjNavn').value }).then(function (d) {
            if (!d._ok) return (root.querySelector('#gjMld').innerHTML = feil(d.melding || (EN ? 'That didn’t work.' : 'Det gikk ikke.')));
            location.href = SIDE + '?k=' + d.gjeng.kode + '&ny=1';
          });
        });
        root.querySelector('#gjBli').addEventListener('submit', function (e) {
          e.preventDefault();
          kall('/api/gjeng', { handling: 'bli-med', kode: root.querySelector('#gjKode').value.replace(/\s/g, '').toUpperCase() }).then(function (d) {
            if (!d._ok) return (root.querySelector('#gjMld').innerHTML = feil(d.melding || (EN ? 'Couldn’t find that crew.' : 'Fant ikke gjengen.')));
            location.href = SIDE + '?k=' + d.gjeng.kode;
          });
        });
      });
    }
    function forklaring() {
      if (EN) return '<ol class="gj-slik"><li><b>Create the crew</b> and share the link with your friends.</li>' +
        '<li><b>Start the night</b> from the crew page and pick the games – everyone gets a notification and joins without a code.</li>' +
        '<li><b>The winner of the night</b> writes a rule in the crew’s law book – and the season table keeps score.</li></ol>';
      return '<ol class="gj-slik"><li><b>Lag gjengen</b> og del lenken med vennene dine.</li>' +
        '<li><b>Start kvelden</b> fra gjengsiden og velg lekene – alle får varsel og blir med uten kode.</li>' +
        '<li><b>Kveldens vinner</b> skriver en regel i gjengens lovbok – og sesongtabellen fører regnskap.</li></ol>';
    }

    /* ---------- én gjeng ---------- */
    function nokkel(n) { return String(n || '').trim().toLowerCase(); }
    function kvelderI(s) { return (G.kvelder || []).filter(function (k) { return s === 'alle' || String(new Date(k.dato).getFullYear()) === s; }); }
    function tabell(kvelder) {
      var folk = {};
      kvelder.slice().reverse().forEach(function (k) {
        var sp = (k.data && k.data.spillere) || [];
        var topp = Math.max.apply(null, sp.map(function (p) { return p.slurker || 0; }).concat([0]));
        var toppQ = Math.max.apply(null, sp.map(function (p) { return p.quiz || 0; }).concat([0]));
        sp.forEach(function (p) {
          var n = nokkel(p.navn); if (!n) return;
          var f = folk[n] || (folk[n] = { navn: p.navn, kvelder: 0, slurker: 0, quiz: 0, sendt: 0, mottatt: 0, seire: 0, quizseire: 0, form: [] });
          f.navn = p.navn; f.kvelder++; f.slurker += p.slurker || 0; f.quiz += p.quiz || 0; f.sendt += p.sendt || 0; f.mottatt += p.mottatt || 0;
          if (topp > 0 && (p.slurker || 0) === topp) f.seire++;
          if (toppQ > 0 && (p.quiz || 0) === toppQ) f.quizseire++;
          f.form.push(p.slurker || 0);
        });
      });
      return Object.keys(folk).map(function (k) { var f = folk[k]; f.snitt = f.kvelder ? f.slurker / f.kvelder : 0; return f; });
    }
    function kaaringer(l, kvelder) {
      function topp(felt, min) {
        var x = l.filter(function (p) { return p[felt] > 0 && p.kvelder >= (min || 1); }).sort(function (a, b) { return b[felt] - a[felt]; });
        return x[0] || null;
      }
      var ut = [], t;
      if ((t = topp('slurker'))) ut.push({ i: '🏆', t: EN ? 'Thirstiest of the season' : 'Sesongens tørstigste', n: t.navn, v: t.slurker + (EN ? ' sips' : ' slurker') });
      if ((t = topp('seire'))) ut.push({ i: '👑', t: EN ? 'Most nights as thirstiest' : 'Flest kvelder som tørstigst', n: t.navn, v: t.seire + '×' });
      if ((t = topp('snitt', Math.min(3, kvelder.length)))) ut.push({ i: '📈', t: EN ? 'Highest average' : 'Høyest snitt', n: t.navn, v: desimal(t.snitt) + (EN ? ' sips per night' : ' slurker per kveld') });
      if ((t = topp('quiz'))) ut.push({ i: '🧠', t: EN ? 'Quiz master' : 'Quizmester', n: t.navn, v: t.quiz + (EN ? ' correct' : ' riktige') });
      if ((t = topp('sendt'))) ut.push({ i: '🎁', t: EN ? 'Most generous' : 'Mest gavmild', n: t.navn, v: t.sendt + (EN ? ' 🍺 sent' : ' 🍺 sendt') });
      if ((t = topp('mottatt'))) ut.push({ i: '🎯', t: EN ? 'Most picked on' : 'Mest mobbet', n: t.navn, v: t.mottatt + (EN ? ' 🍺 received' : ' 🍺 fått') });
      if ((t = topp('kvelder')) && kvelder.length >= 2) ut.push({ i: '🫡', t: EN ? 'Most loyal' : 'Mest trofast', n: t.navn, v: t.kvelder + (EN ? ' of ' : ' av ') + kvelder.length + (EN ? ' nights' : ' kvelder') });
      // Rivalene: de to på topp i slurker, hvis det er jevnt
      var s = l.slice().sort(function (a, b) { return b.slurker - a.slurker; });
      if (s.length >= 2 && s[0].slurker > 0 && s[0].slurker - s[1].slurker <= Math.max(3, s[0].slurker * 0.1))
        ut.push({ i: '⚔️', t: EN ? 'Closest duel' : 'Jevneste duell', n: s[0].navn + (EN ? ' vs ' : ' mot ') + s[1].navn, v: EN ? 'only ' + (s[0].slurker - s[1].slurker) + ' sips apart' : 'bare ' + (s[0].slurker - s[1].slurker) + ' slurker skiller' });
      return ut;
    }

    /* ---------- Gjengens lov: lovboka ---------- */
    function lovbok() {
      var L = G.lovbok; if (!L) return '';
      function regel(x, aktiv) {
        return '<li class="lb-lov"><div class="lb-regel"><div><b>«' + esc(x.tekst) + '»</b><small>' + esc(x.av) + (x.kveld ? (EN ? ' · night ' : ' · kveld ') + x.kveld : '') +
          (!aktiv ? ' · ' + (x.hvordan === 'flertall' ? (EN ? 'voted out by the crew' : 'stemt bort av gjengen') : x.fjernetAv ? (EN ? 'repealed by ' : 'opphevet av ') + esc(x.fjernetAv) : (EN ? 'repealed' : 'opphevet')) : '') + '</small></div>' +
          (aktiv && G.medlem ? '<button class="linkbtn lb-stem" data-g="lov-stem" data-regel="' + esc(x.id) + '" type="button" aria-pressed="' + x.harStemt + '">' + (x.harStemt ? (EN ? '✓ Voted to remove' : '✓ Stemt for å fjerne') : (EN ? 'Vote to remove' : 'Stem for å fjerne')) + (x.stemmer ? ' (' + x.stemmer + '/' + x.trengs + ')' : '') + '</button>' : '') + '</div></li>';
      }
      var r = L.rekorder || {};
      function rekord(ikon, tittel, liste, enhet) {
        if (!liste || !liste.length) return '';
        return '<div><small>' + ikon + ' ' + tittel + '</small><b>' + esc(liste[0].navn) + '</b> · ' + liste[0].n + ' ' + (Array.isArray(enhet) ? enhet[liste[0].n === 1 ? 0 : 1] : enhet) +
          (liste.length > 1 ? '<br><small>' + liste.slice(1, 3).map(function (x) { return esc(x.navn) + ' ' + x.n; }).join(', ') + '</small>' : '') + '</div>';
      }
      var v = L.ventende;
      return '<section class="lovbok" id="lovboka"><h2 class="gj-h2">' + (EN ? '⚖️ The Crew’s Law' : '⚖️ Gjengens lov') + '</h2>' +
        '<p class="small">' + (EN ? 'The winner of each night introduces a rule – or repeals one. A rule applies until a later winner repeals it, or a majority of the crew votes it out.' : 'Kveldens vinner innfører en regel – eller opphever en. Regelen gjelder til en senere vinner opphever den, eller et flertall i gjengen stemmer den bort.') +
          ' · ' + L.kvelder + (EN ? (L.kvelder === 1 ? ' night' : ' nights') : (L.kvelder === 1 ? ' kveld' : ' kvelder')) + '</p>' +
        (v ? (v.minTur
          ? '<div class="lb-valg"><b>' + (EN ? '🏆 You won the last night! Pick your rule' : '🏆 Du vant forrige kveld! Velg regelen din') + '</b>' +
            '<form class="gj-skjema" id="lbValg"><div class="gj-rad"><input id="lbTekst" maxlength="140" placeholder="' + (EN ? 'The new rule …' : 'Den nye regelen …') + '"><button class="btn gold" type="submit">' + (EN ? 'Introduce' : 'Innfør') + '</button></div></form>' +
            (L.aktive.length ? '<p class="small">' + (EN ? '… or repeal one:' : '… eller opphev en:') + '</p><div class="rom-valg en">' + L.aktive.map(function (x) { return '<button type="button" data-g="lov-opphev" data-regel="' + esc(x.id) + '">🗑️ ' + esc(x.tekst) + '</button>'; }).join('') + '</div>' : '') + '</div>'
          : '<p class="lb-valg">⏳ ' + esc(v.navn) + (EN ? ' won the last night and hasn’t picked a rule yet.' : ' vant forrige kveld og har ikke valgt regel ennå.') + '</p>') : '') +
        '<h3>' + (EN ? 'Rules in force' : 'Reglene som gjelder') + ' <small>(' + L.aktive.length + ')</small></h3>' +
        (L.aktive.length ? '<ol class="lb-lover">' + L.aktive.map(function (x) { return regel(x, true); }).join('') + '</ol>' : '<p class="small">' + (EN ? 'No rules yet. Start a night – the winner writes the first one.' : 'Ingen regler ennå. Start en kveld – vinneren skriver den første.') + '</p>') +
        ((r.seire && r.seire.length) || (r.borskonge && r.borskonge.length) || (r.regler && r.regler.length) ? '<h3>' + (EN ? 'Records' : 'Rekorder') + '</h3><div class="lb-rekorder">' +
          rekord('🏆', EN ? 'Most nights won' : 'Flest kveldsseiere', r.seire, EN ? ['win', 'wins'] : ['seier', 'seire']) +
          rekord('👑', EN ? 'Market King most often' : 'Børskonge flest ganger', r.borskonge, '×') +
          rekord('📜', EN ? 'Most rules in force' : 'Flest regler som gjelder', r.regler, EN ? ['rule', 'rules'] : ['regel', 'regler']) + '</div>' : '') +
        (L.fjernet.length ? '<details class="lb-gamle"><summary>' + (EN ? 'Repealed rules' : 'Opphevede regler') + ' (' + L.fjernet.length + ')</summary><ol class="lb-lover">' + L.fjernet.map(function (x) { return regel(x, false); }).join('') + '</ol></details>' : '') +
        (L.logg.length ? '<details class="lb-logg"><summary>' + (EN ? 'History' : 'Historikken') + '</summary><ul>' + L.logg.map(function (x) { return '<li><small>' + dato(x.dato) + '</small> ' + esc(x.tekst) + '</li>'; }).join('') + '</ul></details>' : '') +
        '</section>';
    }
    /* ---------- kvelden: start, bli med, varsler ---------- */
    var STANDARD = ['spion', 'hvemskrev', 'bloff', 'bors'];
    function mittNavn() { try { return JSON.parse(localStorage.getItem('bd_mittnavn') || '""') || ''; } catch (x) { return ''; } }
    function kveldBoks() {
      if (!G.medlem) return '';
      var k = G.kveld;
      if (k) return '<div class="gj-kveld"><p class="rom-etikett">' + (EN ? 'Happening now' : 'Pågår nå') + '</p><h2>🎉 ' + (EN ? esc(k.vert) + ' has started the night' : esc(k.vert) + ' har startet kvelden') + '</h2>' +
        '<p class="small">' + k.antall + (EN ? ' in the room' : ' med i rommet') + (k.plan && k.plan.length ? ' · ' + k.plan.map(function (id) { var l = LEKER.find(function (x) { return x.id === id; }); return esc(l ? l.navn : id); }).join(', ') : '') + '</p>' +
        (k.erMed ? '' : '<label class="lab" for="gjKveldNavn">' + (EN ? 'Your name tonight' : 'Navnet ditt i kveld') + '</label><input id="gjKveldNavn" maxlength="20" value="' + esc(mittNavn()) + '">') +
        '<p><button class="btn gold" data-g="bli-kveld" type="button">' + (k.erMed ? (EN ? 'Back to the night' : 'Tilbake til kvelden') : (EN ? 'Join the night' : 'Bli med i kvelden')) + '</button></p></div>';
      return '<details class="gj-start"' + (/[?&]ny=1/.test(location.search) ? ' open' : '') + '><summary class="btn gold">' + (EN ? '🎲 Start the night' : '🎲 Start kvelden') + '</summary>' +
        '<p class="small">' + (EN ? 'Pick the games. The crew gets a notification and joins straight from here – no code needed. Guests can join with the link and are let in by you or another member.' : 'Velg lekene. Gjengen får varsel og blir med rett herfra – uten kode. Gjester kan bli med på lenken og slippes inn av deg eller et annet medlem.') + '</p>' +
        '<label class="lab" for="gjKveldNavn">' + (EN ? 'Your name tonight' : 'Navnet ditt i kveld') + '</label><input id="gjKveldNavn" maxlength="20" value="' + esc(mittNavn()) + '">' +
        '<p class="lab">' + (EN ? 'Games' : 'Leker') + '</p><div>' + LEKER.map(function (l) { return '<label class="gj-lek"><input type="checkbox" name="gjLek" value="' + esc(l.id) + '"' + (STANDARD.indexOf(l.id) !== -1 ? ' checked' : '') + '> ' + esc(l.navn) + '</label>'; }).join('') + '</div>' +
        '<p><button class="btn gold" data-g="start-kveld" type="button">' + (EN ? 'Start and notify the crew' : 'Start og varsle gjengen') + '</button></p></details>';
    }
    function varselBoks() {
      if (!G.medlem || !('serviceWorker' in navigator) || !('PushManager' in window)) return '';
      return '<p class="small gj-varsel"><button class="linkbtn" data-g="varsel" type="button">' + (localStorage.getItem('bd_gjvarsel_' + G.id) ? (EN ? '🔔 Notifications on – turn off' : '🔔 Varsler er på – skru av') : (EN ? '🔔 Notify me when the crew starts a night' : '🔔 Varsle meg når gjengen starter kveld')) + '</button></p>';
    }
    function tilNokkel(b64) { var p = '='.repeat((4 - b64.length % 4) % 4), r = atob((b64 + p).replace(/-/g, '+').replace(/_/g, '/')), a = new Uint8Array(r.length); for (var i = 0; i < r.length; i++) a[i] = r.charCodeAt(i); return a; }
    function gaaTilRom(d) {
      try { localStorage.setItem('bd_rom_' + d.kode, JSON.stringify({ id: d.id, pollett: d.pollett })); localStorage.setItem('bd_sist_rom', JSON.stringify({ k: d.kode, t: Date.now() })); } catch (x) {}
      location.href = ROM + '?k=' + d.kode;
    }
    function vis() {
      var aar = {}; (G.kvelder || []).forEach(function (k) { aar[new Date(k.dato).getFullYear()] = 1; });
      aar[new Date().getFullYear()] = 1;
      var aarListe = Object.keys(aar).sort().reverse();
      var kv = kvelderI(sesong), l = tabell(kv);
      var sortFn = { slurker: function (a, b) { return b.slurker - a.slurker; }, snitt: function (a, b) { return b.snitt - a.snitt; }, seire: function (a, b) { return b.seire - a.seire || b.slurker - a.slurker; }, quiz: function (a, b) { return b.quiz - a.quiz; }, kvelder: function (a, b) { return b.kvelder - a.kvelder; } }[sorter];
      l.sort(sortFn);
      var sumSlurker = l.reduce(function (n, p) { return n + p.slurker; }, 0), leker = {};
      kv.forEach(function (k) { ((k.data && k.data.leker) || []).forEach(function (x) { leker[x] = (leker[x] || 0) + 1; }); });
      var favoritt = Object.keys(leker).sort(function (a, b) { return leker[b] - leker[a]; })[0];
      var ny = /[?&]ny=1/.test(location.search);
      root.innerHTML =
        '<p class="crumb"><a href="' + SIDE + '">' + (EN ? 'Your crews' : 'Gjengene dine') + '</a> › ' + esc(G.navn) + '</p>' +
        '<h1 class="gj-tittel">' + esc(G.navn) + '</h1>' +
        (ny ? (EN
          ? '<div class="gj-ny"><b>The crew is ready! 🎉</b><p>Share the link with the crew. When you play: tap “Start the night” here – everyone gets a notification and joins without a code.</p></div>'
          : '<div class="gj-ny"><b>Gjengen er klar! 🎉</b><p>Del lenken med gjengen. Når dere skal spille: trykk «Start kvelden» her – alle får varsel og blir med uten kode.</p></div>') : '') +
        '<div class="gj-knapper"><button class="btn gold" data-g="inviter" type="button">' + (EN ? 'Invite the crew' : 'Inviter gjengen') + '</button>' +

          (!G.medlem ? '<button class="btn ghost" data-g="bli-med" type="button">' + (G.innlogget ? (EN ? 'Join the crew' : 'Bli med i gjengen') : (EN ? 'Log in to join' : 'Logg inn for å bli med')) + '</button>' : '') + '</div>' +
        kveldBoks() + varselBoks() +
        lovbok() +
        '<div class="rom-mod gj-sesong" role="group" aria-label="' + (EN ? 'Season' : 'Sesong') + '">' + aarListe.map(function (a) { return '<button type="button" data-sesong="' + a + '" aria-pressed="' + (sesong === a) + '">' + a + '</button>'; }).join('') +
          '<button type="button" data-sesong="alle" aria-pressed="' + (sesong === 'alle') + '">' + (EN ? 'All' : 'Alle') + '</button></div>' +
        (kv.length ? '' : (EN
          ? '<p class="gj-tom">No nights in ' + (sesong === 'alle' ? 'the table' : sesong) + ' yet. Start a room, pick the crew in the lobby and tap “End the night” when you’re done.</p>'
          : '<p class="gj-tom">Ingen kvelder i ' + (sesong === 'alle' ? 'tabellen' : sesong) + ' ennå. Start et rom, velg gjengen i lobbyen og trykk «Avslutt kvelden» når dere er ferdige.</p>')) +
        (kv.length ? '<div class="stat-tall"><div><b>' + kv.length + '</b><span>' + (EN ? (kv.length === 1 ? 'night' : 'nights') : (kv.length === 1 ? 'kveld' : 'kvelder')) + '</span></div><div><b>' + sumSlurker + '</b><span>' + (EN ? 'sips in total' : 'slurker til sammen') + '</span></div>' +
          '<div><b>' + l.length + '</b><span>' + (EN ? 'in the table' : 'med i tabellen') + '</span></div>' + (favoritt ? '<div><b class="gj-fav">' + esc(favoritt) + '</b><span>' + (EN ? 'most played' : 'mest spilt') + '</span></div>' : '') + '</div>' : '') +
        (kv.length ? '<h2 class="gj-h2">' + (EN ? 'Awards' : 'Kåringer') + '</h2><div class="rom-kaaring gj-kaaring">' + kaaringer(l, kv).map(function (x) {
          return '<div><span>' + x.i + '</span><small>' + esc(x.t) + '</small><b>' + esc(x.n) + ' · ' + esc(x.v) + '</b></div>'; }).join('') + '</div>' : '') +
        (kv.length ? '<h2 class="gj-h2">' + (EN ? 'Season table' : 'Sesongtabellen') + '</h2><div class="gj-tabell-wrap"><table class="gj-tabell"><thead><tr><th>#</th><th>' + (EN ? 'Name' : 'Navn') + '</th>' +
          (EN ? [['kvelder', 'Nights'], ['slurker', 'Sips'], ['snitt', 'Avg'], ['seire', '🏆'], ['quiz', 'Quiz']] : [['kvelder', 'Kvelder'], ['slurker', 'Slurker'], ['snitt', 'Snitt'], ['seire', '🏆'], ['quiz', 'Quiz']]).map(function (c) {
            return '<th><button type="button" data-sort="' + c[0] + '" aria-pressed="' + (sorter === c[0]) + '">' + c[1] + '</button></th>'; }).join('') +
          '</tr></thead><tbody>' + l.map(function (p, i) {
            return '<tr><td>' + (i + 1) + '</td><td class="gj-navn">' + esc(p.navn) + formPil(p.form) + '</td><td>' + p.kvelder + '</td><td><b>' + p.slurker + '</b></td><td>' + desimal(p.snitt) + '</td><td>' + p.seire + '</td><td>' + p.quiz + '</td></tr>';
          }).join('') + '</tbody></table></div><p class="small">' + (EN
            ? '🏆 = number of nights as the thirstiest of the night. Names are merged regardless of upper and lower case – use the same name every time.'
            : '🏆 = antall kvelder som kveldens tørstigste. Navn slås sammen uansett store og små bokstaver – bruk samme navn hver gang.') + '</p>' : '') +
        (kv.length ? '<h2 class="gj-h2">' + (EN ? 'The nights' : 'Kveldene') + '</h2><ul class="gj-kvelder">' + kv.map(function (k) {
          var sp = ((k.data && k.data.spillere) || []).slice().sort(function (a, b) { return (b.slurker || 0) - (a.slurker || 0); });
          return '<li><div><b>' + dato(k.dato) + '</b><span>' + sp.length + (EN ? ' players · ' : ' med · ') + ((k.data && k.data.leker) || []).length + (EN ? ' games' : ' leker') + (k.data && k.data.alkoholfri ? (EN ? ' · 🥤 alcohol-free' : ' · 🥤 alkoholfri') : '') + '</span></div>' +
            '<p>' + (sp[0] && sp[0].slurker ? '🏆 ' + esc(sp[0].navn) + ' (' + sp[0].slurker + ')' : '') + (sp.length ? ' · ' + sp.slice(1, 6).map(function (p) { return esc(p.navn) + ' ' + (p.slurker || 0); }).join(', ') : '') + '</p>' +
            (G.eier ? '<button class="linkbtn" data-g="slett-kveld" data-id="' + k.id + '" type="button">' + (EN ? 'Remove from the table' : 'Fjern fra tabellen') + '</button>' : '') + '</li>';
        }).join('') + '</ul>' : '') +
        '<div class="gj-eier">' +
          (G.eier ? '<button class="linkbtn" data-g="endre" type="button">' + (EN ? 'Rename' : 'Endre navn') + '</button> · <button class="linkbtn" data-g="slett" type="button">' + (EN ? 'Delete the crew' : 'Slett gjengen') + '</button>'
                  : G.medlem ? '<button class="linkbtn" data-g="forlat" type="button">' + (EN ? 'Leave the crew' : 'Forlat gjengen') + '</button>' : '') +
          '<span class="small">' + (EN ? 'Crew code: ' : 'Gjengkode: ') + '<b>' + esc(G.kode) + '</b></span></div><p id="gjMld"></p>';
    }
    function formPil(f) {
      if (!f || f.length < 2) return '';
      var siste = f[f.length - 1], snitt = f.slice(0, -1).reduce(function (a, b) { return a + b; }, 0) / (f.length - 1);
      if (siste > snitt * 1.3 && siste - snitt >= 2) return ' <span class="gj-form opp" title="' + (EN ? 'More than usual last time' : 'Mer enn vanlig sist') + '">▲</span>';
      if (siste < snitt * 0.7 && snitt - siste >= 2) return ' <span class="gj-form ned" title="' + (EN ? 'Less than usual last time' : 'Mindre enn vanlig sist') + '">▼</span>';
      return '';
    }
    function hent() {
      root.innerHTML = '<p class="small">' + (EN ? 'Loading the crew …' : 'Henter gjengen …') + '</p>';
      var sti = '/api/gjeng/vis?k=' + encodeURIComponent(kode), o = EN ? { headers: hode() } : undefined;
      (innlogget() ? K.api(sti, o) : fetch(sti, o)).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (d) {
          if (!r.ok) { root.innerHTML = EN
            ? '<h1>The crew</h1>' + feil(d.melding || 'Couldn’t find that crew.') + '<p><a href="' + SIDE + '">To your crews</a></p>'
            : '<h1>Gjengen</h1>' + feil(d.melding || 'Fant ikke gjengen.') + '<p><a href="/no/gjeng">Til gjengene dine</a></p>'; return; }
          G = d;
          if (!G.kvelder.some(function (k) { return String(new Date(k.dato).getFullYear()) === sesong; }) && G.kvelder.length) sesong = String(new Date(G.kvelder[0].dato).getFullYear());
          vis();
        });
      }).catch(function () { root.innerHTML = feil(EN ? 'Couldn’t connect. Try again.' : 'Fikk ikke kontakt. Prøv igjen.'); });
    }
    root.addEventListener('click', function (e) {
      var b = e.target.closest('[data-g],[data-sesong],[data-sort]'); if (!b || !G) return;
      if (b.dataset.sesong) { sesong = b.dataset.sesong; return vis(); }
      if (b.dataset.sort) { sorter = b.dataset.sort; return vis(); }
      var g = b.dataset.g, mld = function (t) { var m = root.querySelector('#gjMld'); if (m) m.innerHTML = feil(t); };
      var ikke = EN ? 'That didn’t work.' : 'Det gikk ikke.';
      if (g === 'inviter') return inviter(G);
      if (g === 'bli-med') {
        if (!G.innlogget) { try { sessionStorage.setItem('bd_etter_innlogging', location.pathname + location.search); } catch (x) {} location.href = KONTO; return; }
        return kall('/api/gjeng', { handling: 'bli-med', kode: G.kode }).then(function (d) { if (!d._ok) return mld(d.melding || ikke); hent(); });
      }
      if (g === 'endre') {
        var n = prompt(EN ? 'New name for the crew' : 'Nytt navn på gjengen', G.navn); if (!n || !n.trim()) return;
        return kall('/api/gjeng', { handling: 'endre', id: G.id, navn: n }).then(function (d) { if (!d._ok) return mld(d.melding || ikke); hent(); });
      }
      if (g === 'slett') {
        if (!confirm(EN ? 'Delete ' + G.navn + ' and the whole season table? This can’t be undone.' : 'Slette ' + G.navn + ' og hele sesongtabellen? Dette kan ikke angres.')) return;
        return kall('/api/gjeng', { handling: 'slett', id: G.id }).then(function (d) { if (!d._ok) return mld(d.melding || ikke); location.href = SIDE; });
      }
      if (g === 'forlat') {
        if (!confirm(EN ? 'Leave ' + G.navn + '? The table stays for everyone else.' : 'Forlate ' + G.navn + '? Tabellen blir liggende for de andre.')) return;
        return kall('/api/gjeng', { handling: 'forlat', id: G.id }).then(function () { location.href = SIDE; });
      }
      if (g === 'start-kveld' || g === 'bli-kveld') {
        var nf = root.querySelector('#gjKveldNavn'), nv = nf ? nf.value.trim() : mittNavn();
        if (!nv) { if (nf) nf.focus(); return mld(EN ? 'Enter your name.' : 'Skriv inn navnet ditt.'); }
        try { localStorage.setItem('bd_mittnavn', JSON.stringify(nv)); } catch (x) {}
        var leker = Array.prototype.map.call(root.querySelectorAll('input[name=gjLek]:checked'), function (x) { return x.value; });
        if (g === 'start-kveld' && !leker.length) return mld(EN ? 'Pick at least one game.' : 'Velg minst én lek.');
        b.disabled = true;
        return kall('/api/gjeng', { handling: g, id: G.id, navn: nv, leker: leker }).then(function (d) { b.disabled = false; if (!d._ok) return mld(d.melding || ikke); gaaTilRom(d); });
      }
      if (g === 'lov-stem') return kall('/api/gjeng', { handling: 'lov-stem', id: G.id, regel: b.dataset.regel }).then(function (d) { if (!d._ok) return mld(d.melding || ikke); hent(); });
      if (g === 'lov-opphev') {
        if (!confirm(EN ? 'Repeal this rule?' : 'Oppheve denne regelen?')) return;
        return kall('/api/gjeng', { handling: 'lov-valg', id: G.id, kveld: G.lovbok.ventende.kveldId, type: 'opphev', regel: b.dataset.regel }).then(function (d) { if (!d._ok) return mld(d.melding || ikke); hent(); });
      }
      if (g === 'varsel') {
        var paa = !!localStorage.getItem('bd_gjvarsel_' + G.id);
        b.disabled = true;
        return navigator.serviceWorker.register('/sw.js').then(function () { return navigator.serviceWorker.ready; }).then(function (reg) {
          if (paa) return reg.pushManager.getSubscription().then(function (sub) {
            localStorage.removeItem('bd_gjvarsel_' + G.id);
            return kall('/api/gjeng', { handling: 'varsel', id: G.id, paa: false, endpoint: sub ? sub.endpoint : '' });
          });
          return Notification.requestPermission().then(function (svar) {
            if (svar !== 'granted') throw new Error(EN ? 'You need to allow notifications.' : 'Du må tillate varsler.');
            return reg.pushManager.getSubscription().then(function (sub) {
              if (sub) return sub;
              return fetch('/api/push/nokkel').then(function (r) { return r.json(); }).then(function (x) {
                if (!x.nokkel) throw new Error(EN ? 'Notifications aren’t set up yet.' : 'Varsler er ikke satt opp ennå.');
                return reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: tilNokkel(x.nokkel) });
              });
            }).then(function (sub) {
              return kall('/api/gjeng', { handling: 'varsel', id: G.id, sub: sub.toJSON() }).then(function (d) { if (!d._ok) throw new Error(d.melding || ikke); localStorage.setItem('bd_gjvarsel_' + G.id, '1'); });
            });
          });
        }).then(function () { vis(); }, function (e) { b.disabled = false; mld(e.message || ikke); });
      }
      if (g === 'lov-anke' || g === 'lov-veto') {
        var mitt = ''; try { mitt = JSON.parse(localStorage.getItem('bd_mittnavn') || '""') || ''; } catch (x) {}
        var navnInn = prompt(EN ? 'Your name in the crew' : 'Navnet ditt i gjengen', mitt); if (navnInn === null) return;
        var grunn = '';
        if (g === 'lov-anke') { grunn = prompt(EN ? 'Why? (optional – read out at the trial)' : 'Hvorfor? (valgfritt – leses opp i rettssaken)', ''); if (grunn === null) return; }
        else if (!confirm(EN ? 'Use your veto? You only get one per season, and the law stops immediately.' : 'Bruke vetoen din? Du har bare én per sesong, og loven stoppes med en gang.')) return;
        return kall('/api/gjeng', { handling: g, id: G.id, lov: b.dataset.lov, navn: navnInn, grunn: grunn }).then(function (d) { if (!d._ok) return mld(d.melding || ikke); hent(); });
      }
      if (g === 'slett-kveld') {
        if (!confirm(EN ? 'Remove this night from the table?' : 'Fjerne denne kvelden fra tabellen?')) return;
        return kall('/api/gjeng', { handling: 'slett-kveld', id: G.id, kveld: Number(b.dataset.id) }).then(function (d) { if (!d._ok) return mld(d.melding || ikke); hent(); });
      }
    });
    root.addEventListener('submit', function (e) {
      if (!e.target || e.target.id !== 'lbValg' || !G || !G.lovbok || !G.lovbok.ventende) return;
      e.preventDefault();
      var tx = root.querySelector('#lbTekst').value.trim();
      if (tx.length < 4) return;
      kall('/api/gjeng', { handling: 'lov-valg', id: G.id, kveld: G.lovbok.ventende.kveldId, type: 'ny', tekst: tx }).then(function (d) { if (!d._ok) { var m = root.querySelector('#gjMld'); if (m) m.innerHTML = feil(d.melding || ''); return; } hent(); });
    });
    // Kommer man tilbake til siden (f.eks. fra et varsel), hentes kvelden på nytt
    document.addEventListener('visibilitychange', function () { if (!document.hidden && kode && G && document.getElementById('gjeng') === root) hent(); });
    if (kode) hent(); else mine();
  })();
  </script>
</Base>
