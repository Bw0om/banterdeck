---
// Forsiden i stua-designet. Øverst: stua der gjestene går inn når koden skrives, og «Lag et rom».
// Så lekene med «Hvor mange er dere?», en kortbunke man kan dra fra, ukas faste ritualer, Pluss og humoren.
// All bevegelse er fjær (window.mvFjaer fra Stua.astro), og skjer bare når noen klikker, drar eller skriver.
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import PopulaertNaa from '../PopulaertNaa.astro';
import Sveip from '../Sveip.astro';
import Stua from '../Stua.astro';
import { rundeKort } from '../../lib/nyhetsrunden';
import { UKENS_LEKER, ukensLek } from '../../lib/ukenslek';
import { games as alleLeker, gamesFor, gameHref, situationSectionsFor, dictSection, visible, langGroups, itemsOf, t, tf, isCrude, totalsFor, situationById } from '../../lib/content';
import { niva, HOOK } from '../../lib/niva';
import { PLUSS_SLUGS } from '../../lib/plussleker';
import { klistremerke } from '../../lib/klistremerker';
import PLUSSPAKKER from '../../data/pluss.json';
import PLUSSPAKKER_EN from '../../data/pluss.en.json';
import DECKS from '../../data/decks.json';
import DECKS_EN from '../../data/decks.en.json';
import { ui, path, type Lang } from '../../lib/i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const L = ui(lang);
const no = lang === 'no';
const N = (nb: string, en: string) => (no ? nb : en);
const ROM = no ? '/no/rom' : '/room';
const ANT_JUL = (PLUSSPAKKER as any).julebord.items.length;
const PAKKENAVN: string[] = Object.keys(PLUSSPAKKER).map((id) => (no ? (PLUSSPAKKER as any)[id].navn : ((PLUSSPAKKER_EN as any)[id]?.navn || (PLUSSPAKKER as any)[id].navn)));
const PAKKELISTE = PAKKENAVN.length > 1 ? PAKKENAVN.slice(0, -1).join(', ') + N(' og ', ' and ') + PAKKENAVN[PAKKENAVN.length - 1] : PAKKENAVN[0];
// Ukas ritualer (Nyhetsrunden finnes bare på norsk)
const NR = rundeKort();
const nrBygg = NR.find((r) => r.fra <= Date.now()) || NR[NR.length - 1];
const UKE = UKENS_LEKER.map((sl) => alleLeker.find((g: any) => g.slug === sl)).filter((g: any) => g && (no || g.only !== 'no'))
  .map((g: any) => ({ slug: g.slug, navn: t(g.name, lang), pl: g.pl, gruppe: t(g.group.title, lang), merke: klistremerke(g.slug, 'st-ukemerke') }));
const ukeBygg = UKE.find((x) => x.slug === ukensLek()) || UKE[0];
const UKEBASE = no ? '/no/drinking-games/' : '/drinking-games/';
// Lekene som spilles fra hver sin telefon. Spillerantallet styrer «Hvor mange er dere?».
const TOPP = ['spionen', 'hvem-skrev-det', 'bloffquizen', 'pekeleken', 'nyhetsrunden', 'ring-of-fire', 'forraeder', 'regelfabrikken', 'samme-svar'];
const PL = new Set(PLUSS_SLUGS);
const alle = gamesFor(lang);
function spenn(g: any): [number, number] {
  if (g.fit && g.fit.min) return [g.fit.min, g.fit.maks || 99];
  const m = String(g.pl || '').match(/(\d+)\s*(?:[–-]\s*(\d+)|(\+))?/);
  if (!m) return [2, 99];
  return [+m[1], m[2] ? +m[2] : m[3] ? 99 : +m[1]];
}
const romLeker = alle.filter((g: any) => niva(g.slug) === 'rom')
  .sort((a: any, b: any) => ((TOPP.indexOf(a.slug) + 1 || 99) - (TOPP.indexOf(b.slug) + 1 || 99)))
  .slice(0, 9)
  .map((g: any) => {
    const [min, maks] = spenn(g);
    return { slug: g.slug, navn: t(g.name, lang), pl: g.pl, min, maks, hook: (HOOK[g.slug] || [])[no ? 0 : 1] || '', href: gameHref(g, (p: string) => path(lang, p), lang), pluss: PL.has(g.slug) };
  });
// «Trekk et kort»: tre ekte kortstokker, bare de snille og frekke kortene (aldri de grove på forsiden)
const KS: any = no ? DECKS : DECKS_EN;
const trekk = [
  { id: 'pekeleken', navn: N('Mest sannsynlig', 'Most likely to'), merke: 'peke' },
  { id: 'jeg-har-aldri', navn: N('Jeg har aldri', 'Never have I ever'), merke: 'aldri' },
  { id: 'enten-eller', navn: N('Enten eller', 'Would you rather'), merke: 'enten' },
].map((s) => ({ navn: s.navn, merke: klistremerke(s.merke), kort: KS[s.id].items.filter((x: any) => x.m !== 'droy').slice(0, 24).map((x: any) => x.t) }));
// Humor
const totals = totalsFor(lang);
const hasDict = visible(dictSection, lang);
const pool = situationSectionsFor(lang).flatMap((s) => langGroups(s, lang).flatMap((g: any) =>
  itemsOf(g, lang).filter((it: any) => it.line && !isCrude(it)).map((it: any) => {
    const sit = it.sit && situationById(it.sit[0]);
    return { l: tf(it, 'line', lang), k: sit ? t(sit.title, lang) : t(s.title, lang) };
  })));
const first = pool[0];
const sveipItems = pool.map((p) => ({ l: p.l, k: p.k }));
const pil = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="square"/></svg>';
---
<Base lang={lang}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'mittvors', url: 'https://www.mittvors.no/', inLanguage: no ? 'nb' : 'en' })} /></Fragment>
  <div class="st-forside">

  <!-- Toppen: stua og veien inn. Hver bokstav i koden sender en ny gjest inn døra. -->
  <section class="st-felt st-helt" aria-labelledby="stTittel">
    <div class="st-indre st-helt-grid">
      <h1 id="stTittel">{no ? <>Klar for <span class="st-boks">vors?</span></> : <>Ready to <span class="st-boks">pre-game?</span></>}</h1>
      <div class="st-stue"><Stua lang={lang} /></div>
      <div class="st-ingress">
        <div class="st-knapper">
          <a class="st-knapp st-gul st-lag" href={ROM + '?lag=1'}>{N('Lag rom', 'Create a room')}<Fragment set:html={pil} /></a>
          <a class="st-knapp st-gul h2-rom" href={ROM} hidden><span><b>{N('Spill sammen', 'Play together')}</b><small>{N('Tilbake til rommet', 'Back to the room')}</small></span><span class="kode" aria-hidden="true">ABCD</span></a>
        </div>
      </div>
      <form class="st-panel" action={ROM} method="get" id="h2Kode">
        <label class="sr-only" for="h2KodeFelt">{N('Kode fra verten', 'Code from the host')}</label>
        <div class="st-panelrad">
          <div class="st-flappfelt" id="stFlapp">
            <span class="flapp" aria-hidden="true"> </span><span class="flapp" aria-hidden="true"> </span><span class="flapp" aria-hidden="true"> </span><span class="flapp" aria-hidden="true"> </span>
            <input id="h2KodeFelt" name="k" size="6" maxlength="6" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text" required aria-describedby="stKodeStatus" />
          </div>
          <button type="submit" class="st-knapp st-hvit">{N('Bli med', 'Join')}</button>
        </div>
        <small id="stKodeStatus" aria-live="polite"></small>
      </form>
    </div>
  </section>

  <!-- Lekene: velg hvor mange dere er, så stokker de som passer seg fremst -->
  <section class="st-felt st-lekefelt" aria-labelledby="stLekerTittel">
    <div class="st-indre">
      <div class="st-hode">
        <h2 id="stLekerTittel">{N('Lekene', 'The games')}</h2>
        <a href={path(lang, '/drinking-games')} class="st-alle">{N(`Alle ${alle.length}`, `All ${alle.length}`)}<Fragment set:html={pil} /></a>
      </div>
      <ul class="st-lekegrid" id="stLeker" role="list">
        {romLeker.map((x) => (
          <li data-min={x.min} data-maks={x.maks}>
            <a class="st-lek" href={x.href}>
              <Fragment set:html={klistremerke(x.slug, 'st-merke')} />
              <span class="st-lek-tekst">
                <b>{x.navn}</b>
                <small><span class="st-pl">{x.pl} {N('spillere', 'players')}</span>{x.pluss && <span class="st-plussmerke">Pluss</span>}</small>
                {x.hook && <span class="st-hook">{x.hook}</span>}
              </span>
              <span class="st-for-faa" hidden>{N(`Fra ${x.min} spillere`, `From ${x.min} players`)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>


  <!-- Første runde på sekunder: dra et kort av bunken, uten rom og uten konto -->
  <section class="st-felt st-kortfelt" aria-labelledby="stKortTittel">
    <div class="st-indre st-kort-grid">
      <div>
        <h2 id="stKortTittel">{N('Bare én telefon', 'Just one phone')}</h2>
        <div class="st-stokkvalg" role="tablist" aria-label={N('Velg kortstokk', 'Choose a deck')}>
          {trekk.map((s, i) => <button type="button" class="st-chip" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-stokk={i}><Fragment set:html={s.merke} />{s.navn}</button>)}
        </div>
      </div>
      <div class="st-bunke" id="stBunke" data-stokker={JSON.stringify(trekk)} data-hint={N('Dra eller trykk for neste kort', 'Drag or tap for the next card')}></div>
    </div>
  </section>

  <!-- Denne uka: de faste ritualene -->
  <section class="st-felt st-ukefelt" aria-labelledby="stUkaTittel">
    <div class="st-indre">
      <h2 id="stUkaTittel" class="st-h">{N('Denne uka', 'This week')}</h2>
      <div class="st-uka">
        {no && nrBygg && (
          <a class="st-nr" href="/no/nyhetsrunden" id="nrFlis" data-runder={JSON.stringify(NR)}>
            <span class="st-nr-topp">
              <span class="st-nr-navn"><Fragment set:html={klistremerke('avis', 'st-merke')} /><b>Nyhetsrunden</b></span>
              <span class="st-nr-uke" aria-label={'Uke ' + nrBygg.uke}><small>Uke</small><span class="st-flapprad" id="nrUke" data-uke={nrBygg.uke}>{String(nrBygg.uke).padStart(2, '0').split('').map((c) => <span class="flapp" aria-hidden="true">{c}</span>)}</span></span>
            </span>
            <span class="st-nr-meta" id="nrAntall">{nrBygg.antall} spørsmål om uka som gikk</span>
            {nrBygg.smak && <span class="st-nr-smak" id="nrSmak">{nrBygg.smak}</span>}
            <span class="st-knapp st-svart st-nr-knapp">Spill quizen</span>
          </a>
        )}
        {ukeBygg && (
          <a class="st-ukelek" id="ukensLek" href={UKEBASE + ukeBygg.slug + '/'} data-leker={JSON.stringify(UKE)} data-base={UKEBASE} data-en={no ? undefined : '1'}>
            <span class="st-ukelek-merke" set:html={ukeBygg.merke} />
            <small class="st-merkelapp">{N('Ukens lek', 'Game of the week')}</small>
            <b>{ukeBygg.navn}</b>
            <em>{ukeBygg.gruppe} · {ukeBygg.pl} {N('spillere', 'players')}</em>
          </a>
        )}
        <a class="st-ukelek st-jul" id="julebord" href={ROM + '?lek=pakke-julebord'} hidden>
          <small class="st-merkelapp">{N('Sesongen er her', 'It’s the season')}</small>
          <b>{N('Julebordpakken', 'The Christmas party pack')}</b>
          <em>{N(`${ANT_JUL} kort – trygt med kolleger, men aldri kjedelig`, `${ANT_JUL} cards – safe with coworkers, never boring`)}</em>
        </a>
      </div>
    </div>
  </section>

  <!-- Gjengen din: grupper er hovedsaken -->
  <section class="st-felt st-gjengfelt" aria-labelledby="stGjengTittel">
    <div class="st-indre st-gjeng-grid">
      <h2 id="stGjengTittel">{N('Gjengen din', 'Your crew')}</h2>
      <div class="st-gjeng-hoder" aria-hidden="true"><span style="background:#FFD23F"></span><span style="background:#FF9CC2"></span><span style="background:#5A8DEE"></span><b>{N('Poeng fra kveld til kveld', 'Points from night to night')}</b></div>
      <div class="st-gjeng" id="h2Gjeng"><a class="st-knapp st-hvit h2-gjeng-lenke" href={no ? '/no/gjeng' : '/crew'}>{N('Lag gjeng', 'Make a crew')}</a></div>
    </div>
  </section>

  <!-- Pluss: to billetter -->
  <section class="st-felt st-plussfelt" aria-labelledby="stPlussTittel">
    <div class="st-indre st-pluss-grid">
      <div>
        <span class="st-plussnavn">mittvors pluss</span>
        <h2 id="stPlussTittel">{N('Pluss', 'Pluss')}</h2>
        <p class="st-pluss-linje">{N('Verten betaler, alle spiller', 'The host pays, everyone plays')}</p>
      </div>
      <div class="st-billetter">
        <a class="st-billett" href={no ? '/no/pluss' : '/plus'}><span class="st-billett-v"><span class="st-hva">{N('Kveldspass', 'Night pass')}</span><span class="st-pris">{N('29 kr', '29 NOK')}</span><span class="st-per">{N('24 timer. Perfekt til én fest.', '24 hours. Perfect for one party.')}</span></span><span class="st-stubb" set:html={klistremerke('mane', 'st-merke')} /></a>
        <a class="st-billett st-aar" href={no ? '/no/pluss' : '/plus'} id="h2PlussKnapp"><span class="st-billett-v"><span class="st-merkelapp st-mork">{N('Mest for pengene', 'Best value')}</span><span class="st-hva">{N('Årspass', 'Year pass')}</span><span class="st-pris">{N('199 kr', '199 NOK')}</span><span class="st-per">{N('Hele året', 'The whole year')}</span></span><span class="st-stubb" set:html={klistremerke('kalender', 'st-merke')} /></a>
      </div>
    </div>
  </section>

  <!-- Humor ved siden: dagens replikk stort -->
  <section class="st-felt st-humorfelt" aria-labelledby="stHumorTittel">
    <div class="st-indre st-humor-grid">
      <svg class="st-snakker" id="stSnakker" viewBox="-40 -100 80 104" aria-hidden="true"></svg>
      <div>
        <h2 id="stHumorTittel" class="st-kat"><span id="todayCat">{first.k}</span><span class="st-kat-del"> · {N('dagens replikk', 'line of the day')}</span></h2>
        <p class="st-replikk today" id="todayLine" data-copy={first.l} tabindex="0">«{first.l}»</p>
        <div class="st-humor-valg">
          <button type="button" class="st-knapp st-gul" data-sveip><Fragment set:html={klistremerke('sveip', 'st-merke st-merke-liten')} />{N(`Sveip ${totals.lines} replikker`, `Swipe ${totals.lines} lines`)}</button>
          <a class="st-lenke" href={path(lang, '/situations')}>{L.linesTitle}</a>
          {no && hasDict && <a class="st-lenke" href={path(lang, '/ord')}>{L.ordTitle}</a>}
          {no && hasDict && <a class="st-lenke" href={path(lang, '/uttrykk')}>{L.uttrykkTitle}</a>}
        </div>
      </div>
    </div>
  </section>

  <div class="st-indre"><AdSlot /></div>

  <section class="st-indre st-hjem">
    <h2 class="st-h">{L.takeItWithYou}</h2>
    <p>{L.takeItBody}</p>
    <div class="device">
      <p class="ios-only">{L.iosSteps}</p>
      <p class="android-only">{L.androidSteps}</p>
      <p class="desktop-only">{L.desktopSteps}</p>
      <p class="standalone-only">{L.standalone}</p>
    </div>
  </section>
  </div>

  <Sveip items={sveipItems} title={N('Alle replikker', 'All lines')} lang={lang} shuffle={true} />

  <div class="installer" id="installer" hidden>
    <span>{N('Legg mittvors på hjemskjermen – åpner som en app og virker uten nett.', 'Add mittvors to your home screen – opens like an app and works offline.')}</span>
    <button type="button" class="btn gold small" id="installerKnapp">{N('Legg til', 'Add')}</button>
    <button type="button" class="linkbtn" id="installerNei" aria-label={N('Ikke nå', 'Not now')}>✕</button>
    <p class="small" id="installerIos" hidden>{N('Trykk Del-knappen i Safari, og velg «Legg til på Hjem-skjerm».', 'Tap the Share button in Safari and choose “Add to Home Screen”.')}</p>
  </div>

  <script is:inline data-astro-rerun define:vars={{ pool: sveipItems }}>
    var d = new Date(), dag = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000);
    var p = pool[dag % pool.length], line = document.getElementById('todayLine');
    line.textContent = '«' + p.l + '»'; line.setAttribute('data-copy', p.l);
    document.getElementById('todayCat').textContent = p.k;
    var sn = document.getElementById('stSnakker');
    function snakker() { if (sn && window.mvFigur) sn.innerHTML = '<g transform="scale(1.3) translate(0,-2)">' + window.mvFigur({ topp: '#63E2A8', hud: '#C98D63', h: '#FF5B1F', haar: 'lue', oyne: 'blunk', munn: 'tunge' }) + '</g>'; }
    if (window.mvFigur) snakker(); else document.addEventListener('mv-stua-klar', snakker, { once: true });
  </script>

  <script is:inline data-astro-rerun>
  (function () {
    // Splitt-flapp: hver celle blar gjennom noen tegn før den lander. Brukes bare på tall og koder.
    var TEGN = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    var red = matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.mvFlipp = function (celle, mal, forsink) {
      mal = mal || ' ';
      if (celle.textContent === mal) return;
      if (red) { celle.textContent = mal; return; }
      var steg = 3 + (Math.random() * 4 | 0);
      clearTimeout(celle._t);
      celle._t = setTimeout(function tikk() {
        celle.classList.remove('slag'); void celle.offsetWidth; celle.classList.add('slag');
        if (--steg <= 0) { celle.textContent = mal; return; }
        celle.textContent = /\d/.test(mal) ? String(Math.random() * 10 | 0) : TEGN[Math.random() * TEGN.length | 0];
        celle._t = setTimeout(tikk, 55);
      }, forsink || 0);
    };
  })();
  </script>

  <script is:inline data-astro-rerun>
  (function () {
    // Kodefeltet: store bokstaver, splitt-flapp i rutene, og en ny gjest i stua for hver bokstav.
    // Fire riktige tegn = en hel kode: gå videre av seg selv (litt etter, så man rekker å se gjesten og rette siste tegn).
    // Romkoder har aldri I, O, 0 eller 1, så de stopper autoturen.
    var f = document.getElementById('h2Kode'); if (!f || f.dataset.bound) return; f.dataset.bound = '1';
    var inp = document.getElementById('h2KodeFelt'), felt = document.getElementById('stFlapp'), st = document.getElementById('stKodeStatus');
    var en = /^en/.test(document.documentElement.lang || ''), videre = null, forrige = '';
    function celler(n) {
      var c = felt.querySelectorAll('.flapp');
      while (c.length < n) { var s = document.createElement('span'); s.className = 'flapp'; s.setAttribute('aria-hidden', 'true'); s.textContent = ' '; felt.insertBefore(s, inp); c = felt.querySelectorAll('.flapp'); }
      for (var i = 4; i < c.length; i++) c[i].hidden = i >= n;
      return felt.querySelectorAll('.flapp');
    }
    inp.addEventListener('input', function () {
      var v = inp.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 6); if (v !== inp.value) inp.value = v;
      celler(Math.max(4, v.length)).forEach(function (c, i) { window.mvFlipp(c, v[i] || ' '); });
      if (v.length > forrige.length && window.mvStua) window.mvStua.nyGjest();
      forrige = v;
      if (window.mvStua) window.mvStua.kode((v + '····').slice(0, Math.max(4, v.length)));
      f.classList.toggle('klar', v.length >= 4); clearTimeout(videre);
      st.textContent = v.length >= 4 ? (en ? 'Joining room ' + v + '…' : 'Går inn i rom ' + v + '…') : (en ? 'Type the code and the guests walk in.' : 'Skriv koden, så går gjestene inn døra.');
      if (/^[A-HJ-NP-Z2-9]{4}$/.test(v)) videre = setTimeout(function () { if (inp.value === v) { if (f.requestSubmit) f.requestSubmit(); else f.submit(); } }, 800);
    });
    inp.setAttribute('enterkeyhint', 'go'); inp.setAttribute('autocorrect', 'off');
    f.addEventListener('submit', function (e) { if (inp.value.length < 4) { e.preventDefault(); st.textContent = en ? 'The code has four characters. Ask the host – it’s on the TV.' : 'Koden har fire tegn. Spør verten, den står på TV-en.'; inp.focus(); } });
    // Er du allerede i et rom på denne telefonen? Da blir knappen en snarvei tilbake.
    var a = document.querySelector('.h2-rom'); if (!a) return;
    try {
      var sr = JSON.parse(localStorage.getItem('bd_sist_rom') || 'null');
      if (!sr || !sr.k || Date.now() - (sr.t || 0) > 24 * 3600 * 1000 || !localStorage.getItem('bd_rom_' + sr.k)) return;
      a.href = (en ? '/room' : '/no/rom') + '?k=' + encodeURIComponent(sr.k); a.hidden = false;
      a.querySelector('b').textContent = en ? 'You’re in room ' + sr.k : 'Du er i rom ' + sr.k;
      a.querySelector('small').textContent = en ? 'Tap to go back' : 'Trykk for å gå tilbake';
      a.querySelector('.kode').textContent = sr.k;
    } catch (e) {}
  })();
  </script>

  <script is:inline data-astro-rerun>
  (function teller() {
    // «Hvor mange er dere?»: telleren styrer hvilke leker som passer. De som passer, glir frem med fjær.
    if (!window.mvFjaer) { document.addEventListener('mv-stua-klar', teller, { once: true }); return; }
    var boks = document.getElementById('stAntall'), liste = document.getElementById('stLeker');
    if (!boks || !liste || boks.dataset.bound) return; boks.dataset.bound = '1';
    var F = window.mvFjaer, en = /^en/.test(document.documentElement.lang || '');
    var tall = document.getElementById('stTall'), fjes = document.getElementById('stFjes'), passer = document.getElementById('stPasser');
    var n = 4, MIN = 2, MAKS = 16;
    try { var lagret = +localStorage.getItem('mv_antall'); if (lagret >= MIN && lagret <= MAKS) n = lagret; } catch (e) {}
    var PAL = [['#FF5B1F','#C98D63','#16120F','kort','vanlig','smil'],['#63E2A8','#F2C6A0','#FFD23F','lang','glad','glis'],['#FFD23F','#8D5A3B','#16120F','krus','vanlig','tunge'],
