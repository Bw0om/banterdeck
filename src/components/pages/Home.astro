---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import Icon from '../Icon.astro';
import PopulaertNaa from '../PopulaertNaa.astro';
import Sveip from '../Sveip.astro';
import { rundeKort } from '../../lib/nyhetsrunden';
import { UKENS_LEKER, ukensLek } from '../../lib/ukenslek';
import { games as alleLeker } from '../../lib/content';
import { illustrasjon } from '../../lib/illustrasjon';
const NR = rundeKort();
const SPRAK = ((Astro.props as any).lang || 'en') as 'no' | 'en';
const UKE = UKENS_LEKER.map((sl) => alleLeker.find((g: any) => g.slug === sl)).filter((g: any) => g && (SPRAK === 'no' || g.only !== 'no'))
  .map((g: any) => ({ slug: g.slug, navn: t(g.name, SPRAK), pl: g.pl, gruppe: t(g.group.title, SPRAK), bilde: illustrasjon(g) }));
const ukeBygg = UKE.find((x) => x.slug === ukensLek()) || UKE[0];
const nrBygg = NR.find((r) => r.fra <= Date.now()) || NR[NR.length - 1];
import { situationSectionsFor, dictSection, visible, langGroups, itemsOf, t, tf, isCrude, totalsFor, topSituationsFor, situationById, gamesFor, dictCount } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const L = ui(lang);
const no = lang === 'no';

const totals = totalsFor(lang);
const hasDict = visible(dictSection, lang);
const pool = situationSectionsFor(lang).flatMap((s) => langGroups(s, lang).flatMap((g: any) =>
  itemsOf(g, lang).filter((it: any) => it.line && !isCrude(it))
    .map((it: any) => {
      const sit = it.sit && situationById(it.sit[0]);
      return { l: tf(it, 'line', lang), c: tf(it, 'ctx', lang),
               k: sit ? t(sit.title, lang) : t(s.title, lang) };
    })
));
const first = pool[0];
const quick = topSituationsFor(lang).slice(0, 5);
const sveipItems = pool.map((p) => ({ l: p.l, k: p.k }));
---
<Base lang={lang}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Mitt vors', url: 'https://www.mittvors.no/', inLanguage: lang === 'no' ? 'nb' : 'en' })} /></Fragment>
  <section class="h2-hero">
    <h1>{no ? <>Klar for<br />vors?</> : <>Ready to<br />pre-game?</>}</h1>
    <p class="h2-sub">{no ? `${totals.games} drikkeleker, rom der alle spiller fra sin egen telefon – og ny Nyhetsrunde hver fredag.` : `${totals.games} drinking games, rooms where everyone plays from their own phone – and a plan for the whole night.`}</p>
    <div class="h2-chips">
      {no ? (
        <>
          <a class="h2-chip on" href="/no/rom">Spill sammen</a>
          <a class="h2-chip" href="/no/finn-lek">Finn lek</a>
          <a class="h2-chip" href="/no/kveld">Kveldsplan</a>
          <a class="h2-chip" href="/no/nyhetsrunden">Nyhetsrunden</a>
          <a class="h2-chip" href="/no/gjeng">Gjengen</a>
        </>
      ) : (
        <>
          <a class="h2-chip on" href="/room">Play together</a>
          <a class="h2-chip" href="/find-a-game">Find a game</a>
          <a class="h2-chip" href="/plan">Plan the night</a>
          <a class="h2-chip" href="/crew">Your crew</a>
        </>
      )}
    </div>
  </section>

  <p class="h2-label">{no ? 'Kvelden starter her' : 'The night starts here'}</p>
  <a class="h2-start" href={path(lang, '/drinking-games')}>
    <span><b>{no ? 'Start en drikkelek' : 'Start a drinking game'}</b><small>{gamesFor(lang).length} {no ? 'leker å velge mellom' : 'games to choose from'}</small></span>
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
  </a>

  {ukeBygg && (
    <a class="h2-uke" id="ukensLek" href={no ? `/no/drinking-games/${ukeBygg.slug}/` : `/drinking-games/${ukeBygg.slug}/`} data-leker={JSON.stringify(UKE)} data-base={no ? '/no/drinking-games/' : '/drinking-games/'}>
      <span class="h2-badge">{no ? 'Ukens lek' : 'Game of the week'}</span>
      <span><b>{ukeBygg.navn}</b><small>{ukeBygg.gruppe} · {ukeBygg.pl} {no ? 'spillere' : 'players'}</small></span>
      <img src={ukeBygg.bilde} alt="" width="120" height="63" loading="lazy" decoding="async" />
    </a>
  )}
  <a class="h2-jul" id="julebord" href={no ? '/no/rom?lek=pakke-julebord' : '/room?lek=pakke-julebord'} hidden>
    <span class="h2-badge">{no ? '🎄 Sesongen er her' : '🎄 It’s the season'}</span>
    <span><b>{no ? 'Julebordpakken' : 'The Christmas party pack'}</b><small>{no ? '94 kort til julebordet – trygt med kolleger, men aldri kjedelig' : '94 cards for the office party – safe with coworkers, never boring'}</small></span>
    <span class="h2-jul-ikon" aria-hidden="true">🎁</span>
  </a>
  <script is:inline data-astro-rerun>
  (function () {
    // Julebordsesongen: 1. november til lille julaften (norsk tid)
    var a = document.getElementById('julebord'); if (!a) return;
    var o = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Oslo' })), m = o.getMonth(), d = o.getDate();
    if (m === 10 || (m === 11 && d <= 23)) a.hidden = false;
  })();
  </script>
  <a class="h2-rom" href={no ? '/no/rom' : '/room'}>
    <span><b>{no ? 'Spill sammen fra hver sin telefon' : 'Play together from your own phones'}</b><small>{no ? 'Lag et rom og del koden' : 'Create a room and share the code'}</small></span>
    <span class="kode" aria-hidden="true">ABCD</span>
  </a>

  {no ? (
    <>
      {nrBygg && (
        <div class="h2-tiles">
          <a class="h2-tile" href="/no/nyhetsrunden" id="nrFlis" data-runder={JSON.stringify(NR)}>
            <span class="h2-badge">Uke {nrBygg.uke}</span>
            <span><b>Nyhetsrunden</b><small>{nrBygg.antall} spørsmål</small></span>
          </a>
          <a class="h2-tile" href="/no/kveld">
            <span class="h2-badge">Plan</span>
            <span><b>Kveldsplan</b><small>Leker fra vors til nachspiel</small></span>
          </a>
        </div>
      )}
      <div class="h2-row">
        <a href="/no/gjeng">👥 Gjengen</a>
        <a href="/no/pluss">✨ Pluss</a>
        <a href="/no/nyhetsrunden/arkiv">📰 Arkivet</a>
        <a href={path(lang, '/favourites')}><Icon name="favoritt" size={20} />Lagret</a>
      </div>

      <p class="h2-label">Humor ved siden</p>
      <div class="h2-tiles">
        <button class="h2-tile" type="button" data-sveip>
          <span class="h2-quote" aria-hidden="true">«…»</span>
          <span><b>Sveip replikker</b><small>{totals.lines} {L.itemsLabel}</small></span>
        </button>
        <a class="h2-tile" href={path(lang, '/situations')}>
          <span class="h2-badge">Alle</span>
          <span><b>{L.linesTitle}</b><small>Etter situasjon</small></span>
        </a>
      </div>
      {hasDict && (
        <div class="h2-row">
          <a href={path(lang, '/ord')}><Icon name="ordbok" size={20} />{L.ordTitle}</a>
          <a href={path(lang, '/uttrykk')}><Icon name="uttrykk" size={20} />{L.uttrykkTitle}</a>
        </div>
      )}
    </>
  ) : (
    <>
      <div class="h2-tiles">
        <a class="h2-tile" href="/plan">
          <span class="h2-badge">Plan</span>
          <span><b>Plan the night</b><small>Games from pre-drinks to afterparty</small></span>
        </a>
        <a class="h2-tile" href="/find-a-game">
          <span class="h2-badge">Quiz</span>
          <span><b>Find a game</b><small>Three questions, the right game</small></span>
        </a>
      </div>
      <div class="h2-row">
        <a href="/crew">👥 Your crew</a>
        <a href="/plus">✨ Plus</a>
        <a href={path(lang, '/favourites')}><Icon name="favoritt" size={20} />Saved</a>
      </div>

      <p class="h2-label">Humour on the side</p>
      <div class="h2-tiles">
        <button class="h2-tile" type="button" data-sveip>
          <span class="h2-quote" aria-hidden="true">«…»</span>
          <span><b>Swipe lines</b><small>{totals.lines} {L.itemsLabel}</small></span>
        </button>
        <a class="h2-tile" href={path(lang, '/situations')}>
          <span class="h2-badge">All</span>
          <span><b>{L.linesTitle}</b><small>By situation</small></span>
        </a>
      </div>
    </>
  )}

  <section class="h2-today">
    <div class="h2-today-top"><span>{L.todayLabel}</span><span id="todayCat">{first.k}</span></div>
    <p class="today" id="todayLine" data-copy={first.l} tabindex="0">«{first.l}»</p>
    <p class="h2-today-hint">{no ? 'Trykk for å kopiere' : 'Tap to copy'}</p>
  </section>

  <script is:inline data-astro-rerun define:vars={{ pool: sveipItems }}>
    var d = new Date();
    var day = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000);
    var p = pool[day % pool.length];
    var line = document.getElementById('todayLine');
    line.textContent = '«' + p.l + '»';
    line.setAttribute('data-copy', p.l);
    document.getElementById('todayCat').textContent = p.k;
  </script>

  <PopulaertNaa lang={lang} />

  <AdSlot />

  <h2>{L.takeItWithYou}</h2>
  <p class="lead">{L.takeItBody}</p>
  <div class="device">
    <p class="ios-only">{L.iosSteps}</p>
    <p class="android-only">{L.androidSteps}</p>
    <p class="desktop-only">{L.desktopSteps}</p>
    <p class="standalone-only">✓ {L.standalone}</p>
  </div>

  <Sveip items={sveipItems} title={no ? 'Alle replikker' : 'All lines'} lang={lang} shuffle={true} />
  <script is:inline data-astro-rerun>
  (function () {
    // Forsiden bygges på forhånd – velg her hvilken uke som faktisk er ute nå (fredag kl. 12)
    var f = document.getElementById('nrFlis'); if (!f) return;
    var l = []; try { l = JSON.parse(f.dataset.runder || '[]'); } catch (e) {}
    var naa = Date.now(), r = l.filter(function (x) { return x.fra <= naa; })[0];
    if (!r) return;
    f.querySelector('.h2-badge').textContent = 'Uke ' + r.uke;
    f.querySelector('small').textContent = r.antall + ' spørsmål';
  })();
  </script>
  <div class="installer" id="installer" hidden>
    <span>{no ? 'Legg Mitt vors på hjemskjermen – åpner som en app og virker uten nett.' : 'Add Mitt vors to your home screen – opens like an app and works offline.'}</span>
    <button type="button" class="btn gold small" id="installerKnapp">{no ? 'Legg til' : 'Add'}</button>
    <button type="button" class="linkbtn" id="installerNei" aria-label={no ? 'Ikke nå' : 'Not now'}>✕</button>
    <p class="small" id="installerIos" hidden>{no ? 'Trykk Del-knappen i Safari, og velg «Legg til på Hjem-skjerm».' : 'Tap the Share button in Safari and choose “Add to Home Screen”.'}</p>
  </div>
  <script is:inline data-astro-rerun>
  (function () {
    var el = document.getElementById('installer'); if (!el || el.dataset.bound) return; el.dataset.bound = '1';
    var ua = navigator.userAgent || '', ios = /iPad|iPhone|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    var mobil = ios || /Android/i.test(ua);
    var inne = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
    var nei = false; try { nei = Number(localStorage.getItem('bd_installer_nei') || 0) > Date.now(); } catch (e) {}
    if (inne || nei || !mobil) return;
    var besok = 0; try { besok = Number(localStorage.getItem('bd_besok') || 0) + 1; localStorage.setItem('bd_besok', besok); } catch (e) {}
    if (besok < 2) return;   // Ikke mas første gang
    var hendelse = window.__bdInstall || null;
    window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); hendelse = e; });
    el.hidden = false;
    document.getElementById('installerKnapp').addEventListener('click', function () {
      if (hendelse) { hendelse.prompt(); hendelse.userChoice.then(function () { el.hidden = true; }); return; }
      document.getElementById('installerIos').hidden = false;
    });
    document.getElementById('installerNei').addEventListener('click', function () {
      el.hidden = true; try { localStorage.setItem('bd_installer_nei', Date.now() + 30 * 86400000); } catch (e) {}
    });
  })();
  </script>
  <script is:inline data-astro-rerun>
  (function () {
    // Er du allerede i et rom på denne telefonen? Da blir rom-knappen en snarvei tilbake.
    var a = document.querySelector('.h2-rom'); if (!a) return;
    try {
      var sr = JSON.parse(localStorage.getItem('bd_sist_rom') || 'null');
      if (!sr || !sr.k || Date.now() - (sr.t || 0) > 24 * 3600 * 1000 || !localStorage.getItem('bd_rom_' + sr.k)) return;
      var en = /^en/.test(document.documentElement.lang || '');
      a.href = (en ? '/room' : '/no/rom') + '?k=' + encodeURIComponent(sr.k);
      a.classList.add('fortsett');
      a.querySelector('b').textContent = en ? 'You’re in room ' + sr.k : 'Du er i rom ' + sr.k;
      a.querySelector('small').textContent = en ? 'Tap to go back to the room' : 'Trykk for å gå tilbake til rommet';
      a.querySelector('.kode').textContent = sr.k;
    } catch (e) {}
  })();
  </script>
  <script is:inline data-astro-rerun>
  (function () {
    // Siden bygges sjelden – velg ukens lek i nettleseren, med samme regel som serveren
    var a = document.getElementById('ukensLek'); if (!a) return;
    var l = []; try { l = JSON.parse(a.dataset.leker || '[]'); } catch (e) {}
    if (!l.length) return;
    var o = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Oslo' }));
    var t = new Date(Date.UTC(o.getFullYear(), o.getMonth(), o.getDate())); t.setUTCDate(t.getUTCDate() - (t.getUTCDay() + 6) % 7 + 3);
    var aar = t.getUTCFullYear(), jan4 = new Date(Date.UTC(aar, 0, 4));
    var uke = 1 + Math.round(((t - jan4) / 86400000 - 3 + ((jan4.getUTCDay() + 6) % 7)) / 7);
    var x = l[(aar * 53 + uke) % l.length];
    a.href = (a.dataset.base || '/no/drinking-games/') + x.slug + '/';
    a.querySelector('b').textContent = x.navn;
    a.querySelector('small').textContent = x.gruppe + ' · ' + x.pl + (a.dataset.base === '/drinking-games/' ? ' players' : ' spillere');
    a.querySelector('img').src = x.bilde;
  })();
  </script>
</Base>
