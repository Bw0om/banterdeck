<style>
  /* Forsiden bruker hele bredden ved siden av menyen; fargefeltene går kant i kant */
  :global(.main:has(.st-forside)){max-width:none;padding-top:0}
  .st-forside{--kant:clamp(18px,4vw,56px);margin-inline:calc(var(--kant) * -1)}
  @media (max-width:899px){.st-forside{--kant:18px}}
  .st-indre{max-width:1180px;margin-inline:auto;padding-inline:var(--kant)}
  .st-felt{border-bottom:var(--strek) solid var(--blekk);overflow-x:clip}
  .st-felt > .st-indre{padding-block:clamp(56px,8vw,96px)}
  .st-forside h2{font-size:clamp(40px,6.4vw,84px)}
  .st-h{margin-bottom:28px}

  /* Knapper som hører til forsiden (samme språk som .btn) */
  .st-knapp{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 24px;font-family:var(--display);font-stretch:75%;font-weight:900;
    font-size:21px;text-transform:uppercase;line-height:1;border:var(--strek) solid var(--blekk);box-shadow:var(--skygge);text-decoration:none;cursor:pointer;border-radius:4px;
    transition:transform var(--fjaer-tid) var(--fjaer),box-shadow var(--fjaer-tid) var(--fjaer)}
  .st-knapp :global(svg){width:22px;height:22px;flex:none}
  .st-svart{background:var(--blekk);color:var(--gul)}
  .st-gul{background:var(--gul);color:var(--blekk)}
  @media (hover:hover) and (pointer:fine){.st-knapp:hover{transform:translate(-3px,-3px);box-shadow:8px 8px 0 var(--hard);text-decoration:none}}
  .st-knapp:active{transform:translate(5px,5px);box-shadow:0 0 0 var(--hard);transition-duration:90ms;transition-timing-function:ease-out}
  .st-merkelapp{display:inline-block;justify-self:start;font-family:var(--display);font-stretch:80%;font-weight:900;font-size:13px;text-transform:uppercase;letter-spacing:.03em;
    background:var(--oransje);color:var(--blekk);padding:3px 9px}
  .st-merkelapp.st-mork{background:var(--blekk);color:var(--gul)}

  /* Splitt-flapp: brukes på koden, antall spillere og ukenummeret */
  :global(.flapp){position:relative;display:inline-grid;place-items:center;width:var(--c,48px);height:calc(var(--c,48px) * 1.28);background:#2F2E34;color:var(--flapp-tekst);
    font-family:var(--display);font-stretch:85%;font-weight:850;font-size:calc(var(--c,48px) * .88);line-height:1;border-radius:4px;overflow:hidden;font-variant-numeric:tabular-nums}
  :global(.flapp)::after{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:#0b0b0d}
  :global(.flapp)::before{content:"";position:absolute;left:0;right:0;top:0;height:50%;background:linear-gradient(#3a3940,#323137);transform-origin:50% 100%;transform:scaleY(0);z-index:1}
  :global(.flapp.slag)::before{animation:stKlaff 70ms linear}
  @keyframes stKlaff{0%{transform:scaleY(1)}100%{transform:scaleY(0)}}

  /* 1. Toppen */
  .st-helt{background:var(--oransje);color:var(--blekk)}
  .st-helt-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);grid-template-areas:"h1 stue" "ingress stue" "ingress panel";gap:24px 44px;align-items:start}
  .st-helt-grid > .st-indre{padding:0}
  .st-helt h1{grid-area:h1;align-self:end;font-size:clamp(64px,10.5vw,152px);line-height:.82;color:var(--blekk)}
  .st-boks{display:inline-block;background:var(--blekk);color:var(--oransje);padding:0 .08em .04em;transform:rotate(-1.5deg);margin-top:.06em}
  .st-stue{grid-area:stue}
  .st-ingress{grid-area:ingress;display:grid;gap:24px;align-content:start}
  .st-ingress > p{font-size:clamp(18px,1.7vw,23px);font-weight:600;max-width:32ch;line-height:1.35}
  .st-knapper{display:flex;flex-wrap:wrap;gap:14px}
  .h2-rom :global(span){display:flex;flex-direction:column;gap:2px;text-align:left}
  .h2-rom small{font-size:13px;text-transform:none;font-stretch:100%;font-weight:700}
  .h2-rom .kode{font-size:24px;padding:4px 8px;background:var(--blekk);color:var(--gul)}
  .st-gjeng{font-size:16px;font-weight:650}
