---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import { situationThemes, situationsFor, collectionsFor, t, countSection } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const L = ui(lang);
const avail = situationsFor(lang);
const themes = situationThemes
  .map((th: any) => ({ ...th, list: avail.filter((x) => x.theme.id === th.id) }))
  .filter((th: any) => th.list.length);
---
<Base title={L.linesTitle} description={L.whatsHappeningLead} lang={lang}>
  <p class="crumb"><a href={path(lang, '/')}>{L.breadcrumbHome}</a> › {L.linesTitle}</p>
  <h1>{L.whatsHappening}</h1>
  <p class="lead">{L.whatsHappeningLead}</p>

  <div class="sitfilter sticky">
    <input id="sitInput" type="search" autocomplete="off" placeholder={L.filterSituations} aria-label={L.filterSituations} />
  </div>

  {themes.map((th: any) => (
    <section class="sittheme" data-theme>
      <h3>{th.emoji} {t(th.title, lang)}</h3>
      <div class="sitchips">
        {th.list.map((x: any) => (
          <a class="sitchip" href={path(lang, `/situations/${x.id}`)}
             data-q={`${t(x.title, 'no')} ${t(x.title, 'en')} ${t(th.title, lang)}`.toLowerCase()}>
            <span class="se">{x.emoji}</span>
            <span class="st">{t(x.title, lang)}</span>
            <b>{x.count}</b>
          </a>
        ))}
      </div>
    </section>
  ))}
  <p class="small" id="sitNone" hidden>{L.noResults}</p>

  <h2>{L.collections}</h2>
  <p class="lead" style="margin-bottom:16px">{L.collectionsLead}</p>
  <div class="tiles">
    {collectionsFor(lang).map((s) => (
      <a class="tile" href={path(lang, `/categories/${s.id}`)}>
        <span class="em">{s.emoji}</span>
        <span class="tn">{t(s.title, lang)}</span>
        <span class="tg">{t(s.desc, lang)}</span>
        <span class="tc">{countSection(s, lang)} {L.itemsLabel}</span>
      </a>
    ))}
  </div>

  <AdSlot />

  <script is:inline>
    (function () {
      function init() {
        var inp = document.getElementById('sitInput');
        if (!inp || inp.dataset.bound) return;
        inp.dataset.bound = '1';
        inp.addEventListener('input', function () {
          var q = inp.value.trim().toLowerCase(), any = false;
          document.querySelectorAll('[data-theme]').forEach(function (sec) {
            var shown = 0;
            sec.querySelectorAll('.sitchip').forEach(function (c) {
              var hit = !q || c.getAttribute('data-q').indexOf(q) !== -1;
              c.hidden = !hit; if (hit) shown++;
            });
            sec.hidden = shown === 0; if (shown) any = true;
          });
          document.getElementById('sitNone').hidden = any;
        });
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</Base>
