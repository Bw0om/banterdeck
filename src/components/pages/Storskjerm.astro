    .tvbf-liste li.inn{animation:tvtsInn 380ms cubic-bezier(.23,1,.32,1) both;animation-delay:var(--f,0ms)}
    .tvbf-tekst{position:relative;display:inline-block;font:700 2.3vw 'Courier New',ui-monospace,monospace;line-height:1.25}
    .tvbf-strek,.tvbf-ring{position:absolute;overflow:visible;pointer-events:none}
    .tvbf-strek{left:0;top:50%;width:100%;height:30px;margin-top:-15px}
    .tvbf-strek path{fill:none;stroke:#C81E35;stroke-width:5;stroke-linecap:round;vector-effect:non-scaling-stroke}
    .tvbf-ring{left:-18px;top:-14px;width:calc(100% + 36px);height:calc(100% + 28px)}
    .tvbf-ring path{fill:none;stroke:#1F8A5B;stroke-width:6;stroke-linecap:round;vector-effect:non-scaling-stroke}
    .tvbf-strek.inn path{stroke-dasharray:400;animation:tvbfStrek 450ms cubic-bezier(.23,1,.32,1) both;animation-delay:var(--f,0ms)}
    .tvbf-ring.inn path{stroke-dasharray:900;animation:tvbfRing 700ms cubic-bezier(.23,1,.32,1) both;animation-delay:var(--f,0ms)}
    @keyframes tvbfStrek{from{stroke-dashoffset:400}to{stroke-dashoffset:0}}
    @keyframes tvbfRing{from{stroke-dashoffset:900}to{stroke-dashoffset:0}}
    .tvbf-marg{position:absolute;left:-6.6vw;top:-.6vh;display:block}
    .tvbf-marg .tvnr-h{width:4.2vw;height:4.2vw}
    .tvbf-marg .tvnr-h svg,.tvbf-best .tvnr-h svg{width:100%!important;height:100%!important}
    .tvbf-penn{display:block;margin:.2vh 0 0 .4vw;font-family:'Fraunces Variable',Fraunces,Georgia,serif;font-style:italic;font-weight:700;font-size:1.9vw;line-height:1.1;transform:rotate(-1.5deg)}
    .tvbf-penn.rod{color:#C81E35}.tvbf-penn.gronn{color:#1F8A5B}
    .tvbf-penn.inn,.tvbf-marg.inn{animation:tvbfMarg 450ms linear(0, 0.0249, 0.0878, 0.1741, 0.2724, 0.3744, 0.4742, 0.5677, 0.6526, 0.7275, 0.792, 0.8462, 0.8909, 0.9269, 0.9552, 0.9768, 0.9928, 1.0042, 1.0119, 1.0166, 1.0191, 1.0199, 1.0195, 1.0184, 1.0167, 1.0148, 1.0127, 1.0107, 1.0089, 1.0071, 1.0056, 1.0043, 1.0032, 1.0023, 1.0015, 1.001, 1.0005, 1.0002, 1) both;animation-delay:var(--f,0ms)}
    @keyframes tvbfMarg{from{transform:translateX(-20px) rotate(-8deg);opacity:0}to{transform:rotate(-1.5deg);opacity:1}}
    .tvbf-fakta{margin-top:1.6vh;padding-top:1.2vh;border-top:3px dashed #16120F}
    /* Fasiten: tettere liste, og «Visste du at» som en gul lapp i hjørnet så den alltid synes */
    .tvbf-side.fasit .tvbf-hint{display:none}
    .tvbf-side.fasit .tvbf-liste{gap:.5vh}
    .tvbf-side.fasit .tvbf-tekst{font-size:1.8vw}
    .tvbf-side.fasit .tvbf-penn{font-size:1.4vw}
    .tvbf-side.med-fakta{padding-right:27vw}
    .tvbf-side.med-fakta .tvbf-fakta{position:absolute;right:2vw;top:2.4vh;width:22vw;margin:0;padding:1.6vh 1.2vw;box-sizing:border-box;background:#FFD23F;border:4px solid #16120F;box-shadow:6px 6px 0 #000;transform:rotate(2deg)}
    .tvbf-side.med-fakta .tvbf-fakta p{font-size:1.5vw;line-height:1.25}
    .tvbf-fakta b{font-size:1.2vw;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
    .tvbf-fakta p{margin:.4vh 0 0;font-size:1.6vw;font-weight:800}
    .tvbf-best{list-style:none;margin:2vh 0;padding:0;display:flex;flex-direction:column;gap:1.4vh;max-width:60vw}
    .tvbf-best li{display:flex;align-items:center;gap:1.4vw;padding:1vh 1.4vw;color:#16120F;background:#FFF8EE;border:4px solid #16120F;border-radius:14px;animation:tvtsInn 380ms cubic-bezier(.23,1,.32,1) both;animation-delay:var(--f,0ms)}
    .tvbf-best li:first-child{background:#FFD23F}
    .tvbf-best .tvnr-h{width:5vw;height:5vw}
    .tvbf-best b{flex:1;font-size:2.4vw;font-weight:900}.tvbf-best span{font-size:2vw;font-weight:900}
    /* Bussruta */
    .tvbr-linje{position:relative;display:flex;justify-content:space-between;max-width:46vw;margin:1.4vh 0 2vh;padding:0 1vw}
    .tvbr-linje::before{content:'';position:absolute;left:3vw;right:3vw;top:1.1vw;height:6px;background:#FFF8EE;border-radius:3px}
    .tvbr-linje span{position:relative;display:flex;flex-direction:column;align-items:center;gap:.6vh;width:9vw}
    .tvbr-linje i{display:block;width:2.4vw;height:2.4vw;box-sizing:border-box;border-radius:50%;border:5px solid #16120F;background:#3A3940;box-shadow:0 0 0 3px #FFF8EE}
    .tvbr-linje .ferdig i{background:#FFF8EE}.tvbr-linje .naa i{background:#FFD23F}
    .tvbr-linje b{font-size:1.2vw;font-weight:900;text-transform:uppercase}
    .tvbr-kort{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;width:5vw;height:7vw;box-sizing:border-box;font-weight:900;color:#16120F;background:#FFFFFF;border:4px solid #16120F;border-radius:10px;box-shadow:4px 4px 0 #000}
    .tvbr-kort.rod{color:#D7263D}
    .tvbr-kort b{font-size:1.8vw;line-height:1}.tvbr-kort i{font-style:normal;font-size:2.6vw;line-height:1}
    .tvbr-kort.bak{background:repeating-linear-gradient(45deg,#D7263D 0 9px,#B81F33 9px 18px)}
    .tvbr-kort.liten{width:3.6vw;height:5vw;flex:none}.tvbr-kort.liten b{font-size:1.3vw}.tvbr-kort.liten i{font-size:1.8vw}
    .tvbr-kort.naa{box-shadow:0 0 0 6px #FFD23F}
    .tvbr-kort.snu{animation:tvbrSnu 550ms linear(0, 0.0249, 0.0878, 0.1741, 0.2724, 0.3744, 0.4742, 0.5677, 0.6526, 0.7275, 0.792, 0.8462, 0.8909, 0.9269, 0.9552, 0.9768, 0.9928, 1.0042, 1.0119, 1.0166, 1.0191, 1.0199, 1.0195, 1.0184, 1.0167, 1.0148, 1.0127, 1.0107, 1.0089, 1.0071, 1.0056, 1.0043, 1.0032, 1.0023, 1.0015, 1.001, 1.0005, 1.0002, 1) both}
    @keyframes tvbrSnu{from{transform:rotateY(90deg)}to{transform:none}}
    .tvbr-svar{display:inline-flex;align-items:center;gap:1vw;margin:1vh 0;padding:1vh 1.6vw;color:#16120F;border:4px solid #16120F;border-radius:12px;box-shadow:6px 6px 0 #000}
    .tvbr-svar.rett{background:#63E2A8}.tvbr-svar.feil{background:#FF9CC2}
    .tvbr-svar.inn{animation:tvtsInn 380ms cubic-bezier(.23,1,.32,1) both}
    .tvbr-svar b{font-family:var(--display);font-size:2.4vw;font-weight:900;font-stretch:66%;text-transform:uppercase}
    .tvbr-svar span{font-size:1.6vw;font-weight:800}
    .tvbr-hender{display:grid;grid-template-columns:repeat(auto-fill,minmax(16vw,1fr));gap:1.4vw;margin-top:2vh}
    .tvbr-hender>div{display:flex;flex-direction:column;gap:1vh;padding:1.2vh 1.2vw;border:4px solid #3A3940;border-radius:14px;background:#2A292E}
    .tvbr-hender>div.tur{border-color:#FFD23F}
    .tvbr-hender b{font-size:1.8vw;font-weight:900}
    .tvbr-vifte{position:relative;height:8vw}
    .tvbr-vifte .tvbr-kort{position:absolute;left:50%;top:.6vw;margin-left:-2.5vw;transform:translateX(calc((var(--i) - (var(--n) - 1) / 2) * 3vw)) rotate(calc((var(--i) - (var(--n) - 1) / 2) * 7deg))}
    .tvbr-hender.liten{grid-template-columns:repeat(2,minmax(0,1fr))}
    .tvbr-hender.liten>div{flex-direction:row;justify-content:space-between;align-items:center}
    .tvbr-hender.liten span{font-size:1.6vw;font-weight:900;color:#D9D2C7}
    /* ---------- Drikke-Yatzy på TV-en ---------- */
    .tv-scene.tvyz{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,30vw);gap:2.6vw;width:100%;align-self:stretch;align-items:start}
    .tvyz-v{display:flex;flex-direction:column;gap:1.6vh;min-width:0}
    .tvyz-brett{container-type:size;position:relative;height:50vh;box-sizing:border-box;border:5px solid #16120F;border-radius:22px;background:radial-gradient(120% 90% at 40% 60%,#2C7A4E 0%,#1E5C3A 70%,#174A2F 100%);box-shadow:inset 0 0 0 12px #8A5A2B,inset 0 0 0 16px #16120F,6px 6px 0 #000;overflow:hidden}
    .tvyz-kant{position:absolute;left:3cqw;right:3cqw;top:4cqh;height:34cqh;border-radius:12px;background:rgba(0,0,0,.18);border:3px dashed rgba(255,248,238,.28)}
    .tvyz-prikker{position:absolute;left:3.5cqw;bottom:5cqh;display:flex;gap:.6vw}
    .tvyz-prikker i{display:block;width:1.3vw;height:1.3vw;box-sizing:border-box;border-radius:.3vw;border:4px solid #FFF8EE}.tvyz-prikker i.paa{background:#FFF8EE}
    .tvyz-terning{position:absolute;left:0;top:0;transform:translate(calc(var(--x) * 1cqw),calc(var(--y) * 1cqh)) rotate(calc(var(--r) * 1deg))}
    .tvyz-terning.borte{visibility:hidden}
    .tvyz-terning.trill{animation:tvyzTrill 600ms cubic-bezier(.23,1,.32,1) both;animation-delay:calc(260ms + var(--f))}
    @keyframes tvyzTrill{from{transform:translate(78cqw,70cqh) rotate(240deg) scale(.9);opacity:0}}
    .tvyz-terning.flytt{animation:tvyzFlytt 260ms cubic-bezier(.23,1,.32,1) both}
    @keyframes tvyzFlytt{from{transform:translate(calc(var(--fx) * 1cqw),calc(var(--fy) * 1cqh)) rotate(calc(var(--fr) * 1deg))}}
    .tvyz-t{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);place-items:center;box-sizing:border-box;width:min(12cqw,27cqh);height:min(12cqw,27cqh);padding:16%;gap:4%;border-radius:18%;background:#FFFDF6;border:4px solid #16120F;box-shadow:5px 5px 0 #0E2E1D}
    .tvyz-t i{width:70%;height:70%;border-radius:50%}.tvyz-t i.p{background:#16120F}.tvyz-t.en i.p{background:#D7263D}
    .tvyz-terning.holdt .tvyz-t{box-shadow:0 0 0 5px #FFD23F,5px 5px 0 #0E2E1D}
    .tvyz-terning.ring .tvyz-t{box-shadow:0 0 0 7px #D7263D,5px 5px 0 #0E2E1D}
    .tvyz-beger{position:absolute;right:3cqw;bottom:5cqh;width:14cqw;height:auto;max-height:50cqh;transform-origin:50% 90%}
    .tvyz-beger .kropp{fill:#6B3A1E;stroke:#16120F;stroke-width:3;stroke-linejoin:round}.tvyz-beger .kant{stroke:#16120F;stroke-width:7;stroke-linecap:round}.tvyz-beger .baand{stroke:#C8924A;stroke-width:4;fill:none}.tvyz-beger .glans{stroke:#8E5330;stroke-width:5;stroke-linecap:round}
    .tvyz-beger.rist{animation:tvyzRist 420ms ease-in-out}
    @keyframes tvyzRist{0%,100%{transform:rotate(0)}20%{transform:rotate(-9deg) translateY(-6px)}45%{transform:rotate(8deg)}70%{transform:rotate(-6deg) translateY(-3px)}}
    .tvyz-krus{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none}
    .tvyz-krus svg{position:absolute;left:6%;top:24%;width:84%}.tvyz-krus path{fill:none;stroke:#FFD23F;stroke-linecap:round}
    .tvyz-krus b{position:relative;font-family:'Fraunces Variable',Georgia,serif;font-style:italic;font-weight:700;font-size:8vw;color:#FFF8EE;text-shadow:6px 6px 0 #16120F}
    .tvyz-krus.inn path{stroke-dasharray:900;animation:tvyzKrus 1000ms cubic-bezier(.23,1,.32,1) both;animation-delay:760ms}
    .tvyz-krus.inn b{animation:tvyzKrusB 320ms cubic-bezier(.23,1,.32,1) both;animation-delay:760ms}
    @keyframes tvyzKrus{from{stroke-dashoffset:900}}@keyframes tvyzKrusB{from{transform:scale(.9);opacity:0}}
    .tvyz-lapprad{min-height:6vh}
    .tvyz-lapp{display:inline-block;margin:0;padding:.6vh 1.2vw;font-weight:900;font-size:1.5vw;color:#16120F;background:#FFF8EE;border:4px solid #16120F;box-shadow:5px 5px 0 #000;transform:rotate(-2deg)}
    .tvyz-lapp.rod{background:#D7263D;color:#FFF8EE}.tvyz-lapp.gull{background:#FFD23F}
    .tvyz-lapp.inn{animation:tvyzLapp 280ms cubic-bezier(.23,1,.32,1) both;animation-delay:620ms}
    @keyframes tvyzLapp{from{transform:translateY(-12px) rotate(-3deg);opacity:0}}
    .tvyz-blokk{border:4px solid #16120F;border-radius:4px;background:#FBFAF4;box-shadow:6px 6px 0 #000;overflow:hidden;color:#16120F}
    .tvyz-rad{display:grid;height:3.55vh;align-items:center;border-bottom:1px solid #B9C3CF;font-size:1.15vw}
    .tvyz-rad>span:first-child{padding-left:.7vw;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .tvyz-rad.hode{height:4.4vh;background:#16120F;color:#FFF8EE;font-weight:900;text-transform:uppercase;letter-spacing:.04em;border:0}
    .tvyz-rad.hode .tvyz-c{font:inherit;color:inherit;display:block;line-height:4.4vh;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 .2vw;border-left-color:#3A3940}
    .tvyz-rad.hode .tvyz-c.aktiv{background:#FFD23F;color:#16120F}
    .tvyz-c{height:100%;display:grid;place-items:center;border-left:1px solid #B9C3CF;font-family:'Fraunces Variable',Georgia,serif;font-style:italic;font-weight:500;font-size:1.45vw;color:#3A3D44;min-width:0}
    .tvyz-c.aktiv{background:#FFF6D2}
    .tvyz-c.skriv{animation:tvyzSkriv 380ms cubic-bezier(.23,1,.32,1) both}
    @keyframes tvyzSkriv{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0)}}
    .tvyz-rad.sum{background:#EEF1F4}.tvyz-rad.sum>span:first-child{font-weight:900}.tvyz-rad.sum .tvyz-c{font-weight:700}
    .tvyz-rad.bonus{border-bottom:3px solid #16120F}
    .tvyz-rad.total{height:4.4vh;border-top:3px solid #16120F;border-bottom:0}.tvyz-rad.total .tvyz-c{font-size:1.8vw}
    /* ---------- Pyramiden på TV-en ---------- */
    .tv-scene.tvpy{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,24vw);gap:2.6vw;width:100%;align-self:stretch;align-items:start;padding:2.4vh 2.4vw;box-sizing:border-box;border-radius:24px;background:radial-gradient(70% 70% at 36% 46%,#5A1B26 0%,#34101A 50%,#160809 100%);color:#F4EBDD;overflow:hidden}
    .tvpy-v{display:flex;flex-direction:column;min-width:0}
    .tvpy-topp{display:flex;align-items:baseline;justify-content:space-between}
    .tvpy-topp span{font-size:1.1vw;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:#C9A24A}
    .tvpy-topp small{font-family:'Fraunces Variable',Georgia,serif;font-style:italic;font-size:1.3vw;color:#C9A24A}
    .tvpy-tittel{font-family:'Fraunces Variable',Georgia,serif;font-size:4vw;font-weight:900;line-height:1}
    .tvpy-pyr{display:flex;flex-direction:column;align-items:center;gap:1.2vh;padding:2.6vh 0 1vh}
    .tvpy-pyr>div{position:relative;display:flex;gap:.8vw}
    .tvpy-pyr em{position:absolute;left:-3.6vw;top:2.2vh;font-family:'Fraunces Variable',Georgia,serif;font-style:normal;font-weight:900;font-size:1.8vw;color:rgba(201,162,74,.35)}
    .tvpy-pyr em.naa{color:#C9A24A}
    .tvpy-kort{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;box-sizing:border-box;width:4.4vw;height:6.1vw;max-height:10.5vh;border-radius:9px;font-weight:900;background:#F4EBDD;color:#1A0A0E;border:2px solid #1A0A0E}
    .tvpy-kort.rod{color:#B3192E}
    .tvpy-kort b{font-size:1.5vw;line-height:1}.tvpy-kort i{font-style:normal;font-size:1.8vw;line-height:1}
    .tvpy-kort.bak{background:repeating-linear-gradient(45deg,transparent 0 7px,rgba(201,162,74,.32) 7px 8px),repeating-linear-gradient(-45deg,transparent 0 7px,rgba(201,162,74,.32) 7px 8px),#2A0A12;border-color:rgba(201,162,74,.45)}
    .tvpy-pyr .tvpy-plass>.tvpy-kort:not(.bak){opacity:.5}
    .tvpy-plass{position:relative;border-radius:9px}
    .tvpy-plass.naa{box-shadow:0 0 0 4px #C9A24A,0 0 70px 24px rgba(255,214,140,.32)}
    .tvpy-pyr .tvpy-plass.naa>.tvpy-kort{opacity:1}
    .tvpy-kort.snu{animation:tvpySnu 420ms cubic-bezier(.23,1,.32,1) both}
    @keyframes tvpySnu{from{transform:rotateY(90deg)}}
    .tvpy-lagt{position:absolute;left:calc(2.4vw + var(--j) * 2vw);top:calc(-1.4vh + var(--j) * .8vh);z-index:2;transform:rotate(calc(10deg + var(--j) * 8deg))}
    .tvpy-lagt .tvpy-kort{box-shadow:0 10px 20px rgba(0,0,0,.5)}
    .tvpy-lagt .tvpy-kort.bak{border-color:#C9A24A;background-color:#2A0A12}
    .tvpy-lagt .tvnr-h{position:absolute;left:50%;top:50%;width:2.6vw;height:2.6vw;margin:-1.3vw 0 0 -1.3vw}
    .tvpy-lagt.apen .tvnr-h{top:100%}
    .tvpy-lagt em{position:absolute;left:-.6vw;top:30%;padding:.2vh .5vw;border:3px solid;border-radius:6px;font-style:normal;font-weight:900;font-size:1.1vw;text-transform:uppercase;background:rgba(26,10,14,.85);transform:rotate(-14deg)}
    .tvpy-lagt em.sant{color:#C9A24A}.tvpy-lagt em.bloff{color:#FF4A5E}
    .tvpy-lagt.inn{animation:tvpyLegg 420ms cubic-bezier(.23,1,.32,1) both}
    @keyframes tvpyLegg{from{transform:translate(16vw,10vh) rotate(30deg);opacity:0}}
    .tvpy-h-kol{display:flex;flex-direction:column;gap:1.4vh;padding-top:1vh;min-width:0}
    .tvpy-etikett{margin:0;font-size:1vw;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#C9A24A}
    .tvpy-folk{display:flex;flex-direction:column;gap:1.2vh}
    .tvpy-folk>div{display:flex;align-items:center;gap:.8vw}
    .tvpy-folk .tvnr-h{width:3vw;height:3vw;flex:none}
    .tvpy-folk b{flex:1;font-size:1.6vw;font-weight:900;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .tvpy-folk span{display:flex;gap:3px;flex-wrap:wrap;justify-content:flex-end}
    .tvpy-folk span i{display:block;width:1vw;height:1.45vw;border-radius:3px;border:1.5px solid #C9A24A;background:#2A0A12}
    .tvpy-kort.mini{width:2.5vw;height:3.5vw;border-radius:5px;border-width:1.5px}.tvpy-kort.mini b{font-size:1.05vw}.tvpy-kort.mini i{font-size:1.2vw}
    .tvpy.ferdig .tvpy-pyr .tvpy-plass>.tvpy-kort{opacity:1}
    .tvpy-vindu{height:5px;border-radius:3px;background:rgba(201,162,74,.22);overflow:hidden;margin-top:1vh}
    .tvpy-vindu i{display:block;height:100%;background:#C9A24A;transform-origin:left;animation-name:tvpyVindu;animation-timing-function:linear;animation-fill-mode:both}
    @keyframes tvpyVindu{from{transform:scaleX(1)}to{transform:scaleX(0)}}
    .tvpy-logg{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.9vh;font-size:1.35vw;font-weight:700}
    .tvpy-logg li.tom{font-family:'Fraunces Variable',Georgia,serif;font-style:italic;font-weight:500;color:#D9CBB5}
    .tvpy-logg b.bloff{color:#FF6B7C}.tvpy-logg b.sant{color:#C9A24A}
    .tvpy-slutt{display:flex;flex-direction:column;gap:.4vh}
    .tvpy-slutt b{font-family:'Fraunces Variable',Georgia,serif;font-size:3.4vw;font-weight:900;line-height:1}
    .tvpy-slutt small{font-size:1.2vw;color:#D9CBB5}
    .tvpy-vent{margin:1vh 0 0;font-size:1.3vw;font-weight:800;color:#D9CBB5}
    .tvpy-avsl{position:absolute;inset:0;z-index:5;display:flex;align-items:center;justify-content:center;gap:4vw;background:rgba(16,6,9,.88);animation:tvpyFade 200ms ease-out both}
    @keyframes tvpyFade{from{opacity:0}}
