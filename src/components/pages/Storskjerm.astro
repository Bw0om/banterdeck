    @keyframes tvnrKrone{from{transform:translateY(-4vw) rotate(-14deg);opacity:0}to{transform:rotate(-8deg);opacity:1}}
    @media (prefers-reduced-motion:reduce){.lh-nese.vokser,.lh-svette path,.tvlh-linje.inn,.tvnr-alt.inn .tvnr-hvem>span,.tvnr-linje.inn .tvnr-pinne,.tvnr-linje.inn .tvnr-flagg,.tvnr-pall.inn .tvnr-blokk,.tvnr-pall.inn .tvnr-h.stor,.tvnr-pall.inn .tvnr-krone{animation:none}.lh-nese.vokser{transform:none}}
