    .tvee-alene p{flex-basis:100%;font-size:.95em}
    .tvee-alene span{flex-basis:100%;font-size:.9em}
    .tvee.kompakt .tvee-side{padding:1.4vh 1.6vw;gap:.6vh}
    .tvee.kompakt .tvee-side b{font-size:clamp(20px,2vw,36px)}
    .tvee.kompakt .tvee-folk{font-size:1.05em}
    .tvee-benk{position:absolute;left:0;right:0;bottom:0;height:12vw;border-top:4px solid #FFF8EE;background:#2A292E;overflow:hidden}
    .tvee-midt{position:absolute;left:50%;top:0;bottom:0;border-left:3px dashed #FFF8EE;opacity:.5}
    .tvee-hode{position:absolute;left:calc(2vw + (100% - 4vw - var(--w)) * var(--x));bottom:-3.6vw;width:var(--w);transition:left 560ms cubic-bezier(.23,1,.32,1)}
    .tvee-hev{display:flex;flex-direction:column;align-items:center;gap:.3em;transform:translateY(2.8vw);transition:transform 680ms cubic-bezier(.23,1,.32,1)}
    .tvee-hev.oppe{transform:translateY(0)}
    .tvee-hode.alene .tvee-hev{animation:tveeOi 520ms cubic-bezier(.23,1,.32,1) both}
    @keyframes tveeOi{0%{transform:translateY(0)}35%{transform:translateY(-1vw) rotate(-5deg)}100%{transform:translateY(0) rotate(0)}}
    .tvee-navn{padding:.1em .6em;font-size:.95em;font-weight:900;color:#D9D2C7;background:#2A292E;border:2px dashed #D9D2C7;border-radius:999px;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
    .tvee-navn.har{color:#16120F;background:#63E2A8;border:2px solid #16120F}
    .tvee-hode.alene .tvee-navn{background:#FFD23F}
    .mv-hode{display:block;width:100%;height:auto;overflow:visible}
    .mv-pup{transition:transform 300ms cubic-bezier(.23,1,.32,1)}
    .mv-lokk{transform-origin:0 4px;animation:mvBlunk 5.2s infinite;animation-delay:calc(var(--i,0) * 1.3s)}
    @keyframes mvBlunk{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.06)}}
    .mv-svette{animation:mvSvette 1.1s cubic-bezier(.23,1,.32,1) infinite}
    @keyframes mvSvette{0%{transform:translateY(-4px);opacity:0}30%{opacity:1}100%{transform:translateY(8px);opacity:0}}
    @media (prefers-reduced-motion:reduce){.mv-lokk,.mv-svette,.tvee-hode.alene .tvee-hev{animation:none}.mv-pup,.tvee-hev,.tvee-hode{transition:none}.tvee-sider.inn .tvee-side{animation:tvjaToning .3s ease both}}
    @media (prefers-reduced-motion:reduce){.tvnr-alt.inn .tvnr-a em{animation:none}}
    .tv-toast,.tv-banner{border:3px solid #FFF8EE!important;border-radius:6px!important;box-shadow:6px 6px 0 #FFD23F!important;background:#16120F!important}
