    .tv-pris{background:var(--card);border:1px solid rgba(200,255,46,.35);border-radius:24px;padding:2.4vh 1.6vw;display:flex;flex-direction:column;align-items:center;text-align:center;gap:.4vh;opacity:0;animation:tvInn .6s cubic-bezier(.2,1.5,.4,1) forwards}
    .tv-pris span{font-size:2.6em}.tv-pris small{text-transform:uppercase;letter-spacing:.1em;color:var(--gold);font-weight:800}.tv-pris b{font-family:var(--display);font-size:1.8em}.tv-pris em{opacity:.75;font-style:normal}
    @keyframes tvInn{from{opacity:0;transform:translateY(30px) scale(.9)}to{opacity:1;transform:none}}
    .tv-meldt{background:var(--accent);color:var(--ink2);font-weight:800;padding:1.4vh 2.5vw;font-size:1.2em;animation:tvPuls 1.2s ease-in-out infinite}.tv-meldt small{opacity:.8;font-weight:600}
    @keyframes tvPuls{50%{background:#E8705A}}
    .tv-kobling{margin:auto;max-width:720px;text-align:center;display:flex;flex-direction:column;gap:2.4vh;align-items:center;padding:4vh 4vw}
    .tv-kobling h1{font-size:2.6em;margin:0}
    .tv-felt{display:flex;gap:2vw}.tv-felt label{display:flex;flex-direction:column;gap:6px;font-weight:700;text-align:left}
    .tv-felt input{font-size:1.6em;padding:10px 16px;border-radius:14px;border:2px solid var(--gold);background:var(--card);color:var(--ink);width:7.5em;letter-spacing:.12em;text-transform:uppercase}
    .tv-start{font-size:1.3em;padding:16px 36px}
    .tv-feil{color:#ff8a70;font-weight:700;margin:0}
    .tv-drikk{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(255,91,31,.94);color:var(--ink2);animation:drikkInn .35s cubic-bezier(.2,1.6,.4,1),drikkBlink .5s steps(1) 4 .35s}
    .tv-drikk b{font-family:var(--display);font-size:12vw;line-height:1;font-weight:900;animation:drikkRist .12s linear 8}
    .tv-drikk ul{list-style:none;padding:0;margin:3vh 0 0;display:flex;flex-wrap:wrap;gap:2vh 4vw;justify-content:center}
    .tv-drikk li{display:flex;align-items:baseline;gap:14px;font-size:4vw;font-weight:900}.tv-drikk li i{font-style:normal;background:var(--ink2);color:var(--gold);border-radius:999px;padding:0 .5em}
    .tv-knust{position:fixed;inset:0;z-index:9998;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2vh;background:rgba(200,20,40,.92);color:#fff;animation:drikkInn .3s cubic-bezier(.2,1.6,.4,1)}
    .tv-knust b{font-family:var(--display);font-size:9vw;font-weight:900;animation:drikkRist .1s linear 8}.tv-knust span{font-size:3vw;font-weight:800}
    .tv-vann{position:fixed;inset:0;z-index:9997;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2.4vh;padding:4vh 8vw;text-align:center;color:#fff;
      background:radial-gradient(130% 55% at 50% 112%,rgb(120 215 255 / .42),transparent 62%),linear-gradient(180deg,#1C5FE8 0%,#123A99 100%);animation:vannInn .5s cubic-bezier(.2,1.2,.4,1)}
    .tv-vann i{font-style:normal;font-size:10vw;line-height:1;animation:vannDuv 1.8s ease-in-out .5s infinite}
    .tv-vann b{font-family:var(--display);font-size:9vw;line-height:1;font-weight:900;font-stretch:125%;letter-spacing:-.04em}
    .tv-vann span{max-width:22em;font-size:3.4vw;line-height:1.2;font-weight:750;text-wrap:balance}
    .tv-banner{position:fixed;left:50%;top:8vh;transform:translateX(-50%);z-index:9000;background:var(--accent);color:var(--ink2);border-radius:24px;padding:2.4vh 3vw;max-width:80vw;text-align:center;display:flex;flex-direction:column;gap:1vh;box-shadow:0 20px 60px rgba(0,0,0,.6);animation:drikkInn .35s cubic-bezier(.2,1.6,.4,1)}
    .tv-banner b{font-size:1.8em}.tv-banner span{font-size:1.1em;opacity:.9}
    .tv-toast{position:fixed;left:50%;bottom:4vh;transform:translateX(-50%);z-index:8000;background:rgba(20,16,9,.92);border:1px solid var(--gold);border-radius:999px;padding:1.4vh 2.4vw;font-size:1.2em;font-weight:700;max-width:80vw;text-align:center;animation:tvInn .4s ease-out}
    .tv-reak{bottom:18vh}.tv-reak span{font-size:6vw}.tv-reak small{font-size:1.2vw}
    /* ny identitet: utstrakt skrift til det som roper, smal til tall, ingen sperrede etiketter */
    .tv-etikett,.tv-pris small{text-transform:none;letter-spacing:0}
    .tv-scene h1,.tv-drikk b,.tv-knust b,.tv-banner b,.tv-logo{font-stretch:125%;font-weight:900;letter-spacing:-.03em}
    .tv-kode b,.tv-liste li b,.tv-pris em{font-stretch:66%;font-weight:900}
    .tv-lobby h1{font-stretch:68%;font-size:4.2em;letter-spacing:.02em}
    .tv-side section{background:rgb(var(--card-rgb) / .7)}
    /* Tittelkort når en ny lek starter: hele rommet ser opp samtidig */
    .tv-intro{position:fixed;inset:0;z-index:8500;pointer-events:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2vh;padding:4vh 8vw;text-align:center;
      background:radial-gradient(ellipse at top,#2A1A22,#0A0609 70%);animation:tvIntroLag 200ms var(--ease-out) both}
    .tv-intro.ut{animation:tvIntroUt 400ms var(--ease-out) forwards}
    .tv-intro-etikett{margin:0;color:var(--gold);font-weight:800;font-size:1.3em;animation:tvIntroOpp 400ms var(--ease-out) 100ms both}
    .tv-intro h1{margin:0;font-family:var(--display);font-stretch:125%;font-weight:900;letter-spacing:-.03em;font-size:6.5vw;line-height:1.05;max-width:18ch;text-wrap:balance;animation:tvIntroNavn 600ms var(--ease-out) 150ms both}
    .tv-intro-strek{width:12vw;height:3px;border-radius:3px;background:var(--gold);transform-origin:center;animation:tvIntroStrek 600ms var(--ease-in-out) 300ms both}
    .tv-intro-folk{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 14px;max-width:70vw;margin-top:1vh}
    .tv-intro-folk span{background:var(--card2);padding:8px 18px;border-radius:999px;font-weight:700;font-size:1.2em;animation:tvIntroOpp 300ms var(--ease-out) both}
    .tv-hoved{transition:opacity 500ms var(--ease-out),transform 500ms var(--ease-out)}
    body.tv-intro-paa .tv-hoved{opacity:0;transform:translateY(12px) scale(.98);transition:none}
    @keyframes tvIntroLag{from{opacity:0}}
    @keyframes tvIntroUt{to{opacity:0}}
    @keyframes tvIntroOpp{from{opacity:0;transform:translateY(8px)}}
    @keyframes tvIntroNavn{from{opacity:0;transform:scale(.96)}}
    @keyframes tvIntroStrek{from{transform:scaleX(0)}}
    @keyframes tvIntroFade{from{opacity:0}}
    @media (prefers-reduced-motion:reduce){
      .tv-intro-etikett,.tv-intro h1,.tv-intro-folk span{animation-name:tvIntroFade}
      .tv-intro-strek{animation:tvIntroFade 300ms ease-out both}
      .tv-hoved{transition:opacity 500ms var(--ease-out)}
      body.tv-intro-paa .tv-hoved{transform:none}
    }
    /* Alle svarer: kortet til venstre, hvem som har svart til høyre */
    .tv-aldri{gap:4vw;align-items:center}
    .tv-aldri-venstre{flex:1;min-width:0;display:flex;flex-direction:column;gap:2.4vh}
    .tv-aldri .tv-kort{transform:none;max-width:none;min-width:0}
    .tv-aldri-lunte{height:10px;border-radius:5px;background:var(--card2);overflow:hidden}
    .tv-aldri-lunte i{display:block;height:100%;border-radius:5px;background:var(--gold);transform-origin:left;transform:scaleX(var(--fra));animation:tvLunte linear forwards}
    @keyframes tvLunte{from{transform:scaleX(var(--fra))}to{transform:scaleX(0)}}
    .tv-aldri-svar{width:min(26vw,380px);display:flex;flex-direction:column;gap:1.6vh}
    .tv-aldri-svar h3{margin:0;font-size:1.2em}
    .tv-aldri-svar ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1vh}
    .tv-aldri-svar li{display:flex;align-items:center;justify-content:space-between;min-height:5.4vh;padding:0 1.2vw;border-radius:16px;border:1.5px dashed var(--hårstrek);color:var(--muted);font-weight:700;font-size:1.05em}
    .tv-aldri-svar li small{font-size:.8em}
    .tv-aldri-svar li.svart{border:1.5px solid transparent;background:rgb(var(--card-rgb) / .85);color:var(--ink)}
    .tv-aldri-svar li svg{width:1.2em;height:1.2em;fill:none;stroke:var(--gold);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
    .tv-aldri-svar li.ny svg{animation:tvHake 300ms cubic-bezier(.23,1,.32,1)}
    @keyframes tvHake{from{transform:scale(.6);opacity:0}}
    /* Avsløringen: tallet, så glassene med navn ett og ett */
    .tv-aldri-avslort{gap:3vh}
    .tv-aldri-pastand{margin:0;max-width:30ch;font-size:1.25em;font-weight:700;color:var(--muted)}
    .tv-aldri-tall{font-family:var(--serif)!important;font-stretch:normal!important;font-weight:560!important;font-size:5.4em!important;letter-spacing:-.03em!important;line-height:1}
    .tv-aldri-tall em{font-style:italic;font-weight:440;color:var(--gold-t)}
    .tv-aldri-har{display:flex;flex-wrap:wrap;gap:1.6vh 1.2vw;justify-content:center}
    .tv-aldri-har span{display:inline-flex;align-items:center;gap:.5em;padding:1.2vh 1.6vw;border-radius:999px;background:var(--accent);color:var(--ink2);font-size:1.6em;font-weight:900;letter-spacing:-.02em}
    .tv-aldri-har svg{width:.9em;height:1.05em;fill:none;stroke:var(--ink2);stroke-width:2.4;stroke-linejoin:round}
    .tv-aldri-fri{margin:0;font-size:1.15em;color:var(--muted)}.tv-aldri-fri b{color:var(--ink)}
    .tv-aldri-mest{margin:0;font-size:.95em;color:var(--faint)}
    .tv-aldri-avslort.inn .tv-aldri-tall{animation:tvAldriTall 420ms cubic-bezier(.23,1,.32,1) both}
    .tv-aldri-avslort.inn .tv-aldri-har span{animation:tvAldriNavn 320ms cubic-bezier(.23,1,.32,1) both;animation-delay:calc(260ms + min(var(--i, 0), 10) * 80ms)}
    .tv-aldri-avslort.inn :is(.tv-aldri-fri,.tv-aldri-mest){animation:tvTon 300ms ease-out 500ms both}
    @keyframes tvAldriTall{from{opacity:0;transform:scale(.96)}}
    @keyframes tvAldriNavn{from{opacity:0;transform:translateY(12px)}}
    @keyframes tvTon{from{opacity:0}}
    /* Noen deler ut: panelet kommer, glassene fylles ett og ett, så navnene */
    .tv-utdeling{position:fixed;inset:0;z-index:9500;display:flex;align-items:center;justify-content:center;background:rgba(10,6,9,.6);animation:tvTon 220ms ease-out;transition:opacity 300ms ease}
    .tv-utdeling.ut{opacity:0}
    .tv-ut-panel{width:min(70vw,980px);box-sizing:border-box;padding:5vh 4vw 4.6vh;border-radius:32px;background:var(--card);border:1px solid var(--hårstrek);box-shadow:0 40px 100px rgba(0,0,0,.6);display:flex;flex-direction:column;align-items:center;gap:3vh;text-align:center;animation:tvAldriTall 360ms cubic-bezier(.23,1,.32,1) both}
    .tv-ut-panel h1{margin:0;font-family:var(--serif);font-weight:560;font-size:3.4em;letter-spacing:-.03em;line-height:1.02}
    .tv-ut-panel h1 em{font-style:italic;font-weight:440;color:var(--gold-t)}
    .tv-ut-glass{display:flex;gap:.6vw}
    .tv-ut-glass svg{width:2em;height:2.4em;fill:var(--gold);stroke:var(--gold);stroke-width:1.8;stroke-linejoin:round;animation:tvAldriNavn 280ms cubic-bezier(.23,1,.32,1) both;animation-delay:calc(200ms + var(--i, 0) * 70ms)}
    .tv-ut-navn{display:flex;flex-wrap:wrap;gap:1.4vh 1vw;justify-content:center}
    .tv-ut-navn span{padding:1.1vh 1.4vw;border-radius:999px;background:var(--accent);color:var(--ink2);font-size:1.5em;font-weight:900;letter-spacing:-.02em;animation:tvAldriNavn 300ms cubic-bezier(.23,1,.32,1) both;animation-delay:calc(500ms + min(var(--i, 0), 10) * 80ms)}
    .tv-ut-navn b{font-variant-numeric:tabular-nums}
    @media (prefers-reduced-motion:reduce){
      .tv-aldri-avslort.inn :is(.tv-aldri-tall,.tv-aldri-har span),.tv-ut-panel,.tv-ut-glass svg,.tv-ut-navn span{animation-name:tvTon}
      .tv-aldri-svar li.ny svg{animation:none}
    }
  
    /* ---------- stua-designet på TV-en: mørkt rom, kremhvit strek, gule harde skygger ---------- */
    body.tv{background:#1C1B1F;color:#FFF8EE}
    .tv-logo{font-family:var(--display);font-stretch:72%;font-weight:900;background:#16120F;color:#FFF8EE;padding:4px 14px 6px;border:3px solid #FFF8EE;box-shadow:5px 5px 0 #FFD23F;transform:rotate(-2deg);display:inline-block}
    .tv-logo b{color:#FFD23F;font-style:italic}
    .tv h1,.tv h2,.tv h3{text-transform:none}
    .tv-lobby{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);align-items:center;gap:4vw}
    .tv-lobby-venstre{display:flex;flex-direction:column;gap:2vh}
    .tv-lobby h1{font-size:3.4em;color:#FFD23F;text-transform:none;word-break:break-word}
    .tv-qr{border:4px solid #16120F;box-shadow:8px 8px 0 #FFD23F;border-radius:8px!important;width:min(30vh,20vw)!important}
    .tv-stua{background:#FF5B1F;border:4px solid #FFF8EE;border-radius:8px;box-shadow:10px 10px 0 #FFD23F;padding:1vh 1vw .4vh}
    .tv-stua svg{display:block;width:100%;height:auto;overflow:visible}
    .tv-stua-seksjon{padding:0!important;background:transparent!important;border:0!important;box-shadow:none!important}
    .tv-stua-seksjon .tv-stua{box-shadow:6px 6px 0 #FFD23F;border-width:3px}
    .tv-chips span{border:3px solid #FFF8EE;border-radius:4px!important;background:#2A292E;box-shadow:3px 3px 0 #000;font-family:var(--display);font-stretch:85%;font-weight:850}
    .tv-side section{border:3px solid #FFF8EE!important;border-radius:6px!important;background:#2A292E!important;box-shadow:6px 6px 0 #FFD23F}
    .tv-kort,.tv-scene .rof-kort{background:#FFF8EE!important;color:#16120F!important;border:5px solid #16120F!important;border-radius:10px!important;box-shadow:14px 14px 0 #FF5B1F!important}
    .tv-etikett{font-family:var(--display);font-stretch:80%;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:#FFD23F}
    .tv-sporsmal{font-family:var(--display);font-stretch:78%;font-weight:900;color:#FFF8EE;max-width:24ch;line-height:1.02}
    .tv-sitat{font-family:var(--display);font-stretch:80%;font-weight:850;font-size:2.4em;background:#FFF8EE;color:#16120F;border:5px solid #16120F;box-shadow:12px 12px 0 #FFD23F;padding:.5em .8em;border-radius:8px;max-width:26ch;margin-top:3vh}
    .tv-valg{list-style:none;padding:0;margin:3vh 0 0;display:grid;gap:1.6vh;max-width:56vw}
    .tv-valg li{display:flex;gap:1em;align-items:center;font-size:1.7em;font-weight:750;background:#2A292E;border:3px solid #FFF8EE;border-radius:6px;padding:.4em .7em;box-shadow:5px 5px 0 #000}
    .tv-valg b{display:inline-grid;place-items:center;min-width:1.6em;height:1.6em;background:#FFD23F;color:#16120F;border-radius:4px;font-family:var(--display);font-weight:900}
    .tv-fasit{font-size:2em;margin-top:3vh}
    .tv-fasit b{background:#63E2A8;color:#16120F;padding:0 .3em;border-radius:4px}
    .tvnr{display:block!important;width:100%;text-align:left;align-self:stretch}
    .tvnr-hoved{display:flex;flex-direction:column;gap:2.2vh;min-width:0}
    .tvnr-hode{display:flex;align-items:center;gap:1em;flex-wrap:wrap}
    .tvnr-hoved .tv-sporsmal{font-size:clamp(26px,2.7vw,52px)!important;max-width:30ch;margin:0}
    .tvnr-nr{margin:0;font-family:var(--display);font-weight:900;font-size:1em;padding:.1em .5em;border:3px solid #FFF8EE;border-radius:4px}
    .tvnr-gul{color:#FFD23F}
    .tvnr-p{display:inline-grid;place-items:center;min-width:1.9em;height:1.9em;padding:0 .3em;box-sizing:border-box;border:3px solid #16120F;border-radius:1em;background:var(--f);color:#16120F;font-weight:900;font-size:.8em}
    .tvnr-alt{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4vw}
    .tvnr-a{position:relative;display:flex;align-items:center;gap:.6em;padding:.45em .7em;font-size:1.25em;font-weight:800;line-height:1.15;background:#2A292E;color:#FFF8EE;border:3px solid #FFF8EE;border-radius:8px;box-shadow:6px 6px 0 #000;transition:opacity .3s,background-color .3s}
    .tvnr-a i{flex:none;display:grid;place-items:center;width:1.6em;height:1.6em;font-style:normal;font-weight:900;border:3px solid #16120F;border-radius:6px;background:#FFD23F;color:#16120F}
    .tvnr-a>span:nth-of-type(1){flex:1}
    .tvnr-hvem{display:flex;gap:.25em}
    .tvnr-a.rett{background:#63E2A8;color:#16120F;box-shadow:10px 10px 0 #FFD23F}
    .tvnr-a.rett i{background:#16120F;color:#FFF8EE}
    .tvnr-a.dempet{opacity:.5}
    .tvnr-a em{position:absolute;right:-.4em;top:-.7em;font-style:normal;font-size:.65em;font-weight:900;text-transform:uppercase;padding:.2em .5em;background:#FFF8EE;color:#16120F;border:3px solid #16120F;transform:rotate(-6deg)}
    .tvnr-alt.inn .tvnr-a em{animation:tvnrStempel .42s cubic-bezier(.23,1,.32,1) both}
    @keyframes tvnrStempel{from{transform:rotate(-6deg) scale(1.6);opacity:0}to{transform:rotate(-6deg);opacity:1}}
    .tvnr-folk{display:flex;flex-wrap:wrap;align-items:center;gap:.5em;font-size:1.15em}
    .tvnr-folk .mangler .tvnr-p{background:transparent;color:#D9D2C7;border-style:dashed;border-color:#D9D2C7}
    .tvnr-teller{margin-left:.5em;font-weight:800;color:#D9D2C7}
    .tvnr-liste{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1vh 1.4vw;font-size:1.2em}
    .tvnr-liste li{display:flex;align-items:center;gap:.6em;padding:.3em .6em;background:#2A292E;border:3px solid #FFF8EE;border-radius:6px}
    .tvnr-liste li span:not(.tvnr-p){flex:1;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .tvnr-liste li b{font-size:.7em;text-transform:uppercase;font-weight:900;padding:.15em .45em;border-radius:3px;color:#16120F;background:#F2EADF}
    .tvnr-liste li.rett b{background:#63E2A8}
    .tvnr-liste li.feil b{background:#FF9CC2}
    .tvnr-info{margin:0;font-size:1.05em;color:#D9D2C7;max-width:70ch}
    .tvnr-stilling{list-style:none;margin:0 0 0 auto;padding:0;display:flex;gap:.6em;flex-wrap:wrap}
    .tvnr-stilling li{display:flex;align-items:center;gap:.35em;padding:.2em .5em .2em .25em;background:#2A292E;border:3px solid #FFF8EE;border-radius:999px;font-weight:900}
    .tvnr-stilling li:first-child{box-shadow:4px 4px 0 #FFD23F}
    .tvnr-stilling b{font-variant-numeric:tabular-nums}
    .tvlh-hvem{display:flex;align-items:center;gap:.6em;font-size:1.4em}
    .tvlh-hvem p{margin:0;font-weight:800}
    .tvlh-bunn{display:flex;align-items:center;gap:3vw;margin-top:2vh}
    .tvlh-stempel{flex:none;display:inline-block;font-style:normal;font-family:var(--display);font-size:clamp(48px,6vw,110px);font-weight:900;font-stretch:62%;text-transform:uppercase;line-height:.9;padding:.08em .25em .12em;color:#16120F;border:5px solid #FFF8EE;box-shadow:12px 12px 0 #FF5B1F;transform:rotate(-4deg)}
    .tvlh-stempel.logn{background:#FF9CC2}
    .tvlh-stempel.sant{background:#63E2A8}
    .tvlh-stempel.inn{animation:tvlhStempel .46s cubic-bezier(.23,1,.32,1) both}
    @keyframes tvlhStempel{from{transform:rotate(-4deg) scale(1.7);opacity:0}to{transform:rotate(-4deg);opacity:1}}
    .tvlh-kolonner{flex:1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4vw}
    .tvlh-kol{padding:.7em .9em;background:#2A292E;border:3px solid #FFF8EE;border-radius:8px;opacity:.6}
    .tvlh-kol.rett{opacity:1;background:#63E2A8;color:#16120F;box-shadow:8px 8px 0 #FFD23F}
    .tvlh-kol p{margin:0 0 .5em;font-weight:900;text-transform:uppercase;font-size:1.1em}
    .tvlh-kol div{display:flex;gap:.4em;flex-wrap:wrap;font-size:1.3em}
    .tvlh-kol .sikker .tvnr-p{box-shadow:0 0 0 4px #FF5B1F}
    .tvpk-pre{margin:0;font-size:1.3em;font-weight:900;text-transform:uppercase;letter-spacing:.04em;color:#D9D2C7}
    .tvpk-vri{font-weight:900;padding:.2em .6em;background:#FFD23F;color:#16120F;border:3px solid #16120F;transform:rotate(-2deg)}
