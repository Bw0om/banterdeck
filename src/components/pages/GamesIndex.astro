---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import Icon from '../Icon.astro';
import { spill, games, gamesFor, gameHref, langGroups, itemsOf, t } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const L = ui(lang);
const groups = langGroups(spill, lang).map((g: any) => ({ ...g, list: itemsOf(g, lang) })).filter((g: any) => g.list.length);
const hrefOf = (it: any) => gameHref(games.find((x) => x.name === it.name), (p) => path(lang, p));
const searchPh = lang === 'no' ? 'Søk etter lek eller utstyr …' : 'Search games or equipment…';
---
<Base title={L.gamesTitle} description={L.gamesDesc(gamesFor(lang).length)} lang={lang} gate={true}>
  <p class="crumb"><a href={path(lang, '/')}>{L.breadcrumbHome}</a> › {L.gamesTitle}</p>
  <h1 class="withicon"><Icon name="drikkeleker" size={34} />{L.gamesTitle}</h1>
  <p class="lead">{L.gamesLead}</p>


  <div class="dictfilter sticky">
    <input id="gameInput" type="search" autocomplete="off" placeholder={searchPh} aria-label={searchPh} />
    <div class="chips dictchips">
      {groups.map((g: any) => <a href={`#${g.id}`}>{t(g.title, lang)}<b>{g.list.length}</b></a>)}
    </div>
  </div>

  {groups.map((g: any, i: number) => (
    <section class="group dictgroup" id={g.id} data-ggroup>
      <h3>{t(g.title, lang)}<span class="group-count">{g.list.length}</span></h3>
      <div class="gamelist">
        {g.list.map((it: any) => (
          <a class="game" href={hrefOf(it)}
             data-q={`${t(it.name, 'no')} ${t(it.name, 'en')} ${t(it.gear, lang)}`.toLowerCase()}>
            <span class="gn">{t(it.name, lang)}</span>
            <span class="gm">{t(it.gear, lang)}</span>
            <span class="gp">{it.pl} {L.players}</span>
          </a>
        ))}
      </div>
      {i === 0 && <AdSlot />}
    </section>
  ))}
  <p class="small" id="gameNone" hidden>{L.noResults}</p>

  <script is:inline>
    (function () {
      function init() {
        var inp = document.getElementById('gameInput');
        if (!inp || inp.dataset.bound) return;
        inp.dataset.bound = '1';
        inp.addEventListener('input', function () {
          var q = inp.value.trim().toLowerCase(), any = false;
          document.querySelectorAll('[data-ggroup]').forEach(function (sec) {
            var shown = 0;
            sec.querySelectorAll('[data-q]').forEach(function (c) {
              var hit = !q || c.getAttribute('data-q').indexOf(q) !== -1;
              c.hidden = !hit; if (hit) shown++;
            });
            sec.hidden = shown === 0; if (shown) any = true;
          });
          document.getElementById('gameNone').hidden = any;
        });
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</Base>
