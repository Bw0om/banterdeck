---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import Icon from '../Icon.astro';
import PopulaertNaa from '../PopulaertNaa.astro';
import { spill, games, gamesFor, gameHref, langGroups, itemsOf, t } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
import DECKS from '../../data/decks.json';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const L = ui(lang);
const groups = langGroups(spill, lang).map((g: any) => ({ ...g, list: itemsOf(g, lang) })).filter((g: any) => g.list.length);
const hrefOf = (it: any) => gameHref(games.find((x) => x.name === it.name), (p) => path(lang, p), lang);
const no = lang === 'no';
const APP = new Set([...Object.keys(DECKS as any), 'over-eller-under', 'fuck-the-dealer', 'krig', 'veddelopet', 'bussruta', 'terningen-bestemmer',
  '21-med-terninger', 'opus', 'regelfabrikken', 'drikke-bingo', 'gjett-aret', '100-sporsmal', 'nyhetsrunden', 'nasjonal-vorsprove']);
const ROM = new Set(['pekeleken', 'jeg-har-aldri', 'enten-eller', 'kategorier', 'nodt-eller-sannhet', 'rygg-mot-rygg', 'duoleken', '50-50',
  'ring-of-fire', 'forraeder', 'drikke-bingo', 'regelfabrikken', 'over-eller-under', 'veddelopet', 'pyramiden', 'president', 'gris']);
const slugOf = (it: any) => (games.find((x) => x.name === it.name) || {}).slug;
const FAV = ['ring-of-fire', 'regelfabrikken', 'pyramiden', 'forraeder', 'bussruta', 'drikke-bingo', 'opus', 'president'];
const favs = no ? FAV.map((sl) => games.find((x) => x.slug === sl)).filter(Boolean) : [];
const searchPh = lang === 'no' ? 'Søk etter lek eller utstyr …' : 'Search games or equipment…';
---
<Base title={L.gamesTitle} description={L.gamesDesc(gamesFor(lang).length)} lang={lang} gate={true}>
  <p class="crumb"><a href={path(lang, '/')}>{L.breadcrumbHome}</a> › {L.gamesTitle}</p>
  <h1 class="withicon"><Icon name="drikkeleker" size={34} />{L.gamesTitle}</h1>
  <p class="lead">{L.gamesLead}</p>


  {lang === 'no' && <p class="small" style="margin:-6px 0 16px">Drikking er valgfritt – lekene funker like godt med brus.</p>}

  {lang === 'no' && (
    <p class="guidechips">
      <a class="btn gold" href="/no/finn-lek">Finn lek</a>
      <a class="btn" href="/no/rom">Spill sammen i rom</a>
      <a href="/no/leker/vors">Til vorset</a>
      <a href="/no/leker/nachspiel">Til nachspiel</a>
      <a href="/no/leker/bursdag">Til bursdag</a>
      <a href="/no/leker/to-personer">For to</a>
      <a href="/no/leker/store-grupper">Store grupper</a>
    </p>
  )}

  {favs.length > 0 && (
    <section class="favleker">
      <h2>Spill rett på telefonen</h2>
      <p class="small">Ingen kortstokk eller terning? Disse spiller dere rett i appen – flere av dem fra hver sin telefon.</p>
      <div class="favgrid">
        {favs.map((g: any) => (
          <a class="favlek" href={gameHref(g, (p) => path(lang, p), lang)}>
            <b>{t(g.name, lang)}</b>
            <span>{t(g.gear, lang)}</span>
            <span class="badges">
              {APP.has(g.slug) && <i>I appen</i>}
              {ROM.has(g.slug) && <i class="rom">Flere telefoner</i>}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <PopulaertNaa lang={lang} vis="leker" />

  <div class="dictfilter sticky">
    <input id="gameInput" type="search" autocomplete="off" placeholder={searchPh} aria-label={searchPh} />
    <div class="chips dictchips">
      {groups.map((g: any) => <a href={`#${g.id}`}>{t(g.title, lang)}<b>{g.list.length}</b></a>)}
    </div>
  </div>

  {groups.map((g: any, i: number) => (
    <section class:list={['group dictgroup', g.id === 'blikjent' && 'gruppe-rolig']} id={g.id} data-ggroup>
      <h3>{t(g.title, lang)}<span class="group-count">{g.list.length}</span></h3>
      {g.id === 'blikjent' && no && <p class="small">Roligere leker – fine når dere ikke kjenner hverandre så godt ennå.</p>}
      <div class="gamelist">
        {g.list.map((it: any) => (
          <a class="game" href={hrefOf(it)}
             data-q={`${t(it.name, 'no')} ${t(it.name, 'en')} ${t(it.gear, lang)}`.toLowerCase()}>
            <span class="gn">{t(it.name, lang)}</span>
            <span class="gm">{t(it.gear, lang)}</span>
            <span class="gp">{it.pl} {L.players}</span>
            {no && (APP.has(slugOf(it)) || ROM.has(slugOf(it))) && (
              <span class="badges">
                {APP.has(slugOf(it)) && <i>I appen</i>}
                {ROM.has(slugOf(it)) && <i class="rom">Flere telefoner</i>}
              </span>
            )}
          </a>
        ))}
      </div>
      {i === 0 && <AdSlot />}
    </section>
  ))}
  <p class="small" id="gameNone" hidden>{L.noResults}</p>

  <script is:inline>
    (function () {
      function init() {
        var inp = document.getElementById('gameInput');
        if (!inp || inp.dataset.bound) return;
        inp.dataset.bound = '1';
        inp.addEventListener('input', function () {
          var q = inp.value.trim().toLowerCase(), any = false;
          document.querySelectorAll('[data-ggroup]').forEach(function (sec) {
            var shown = 0;
            sec.querySelectorAll('[data-q]').forEach(function (c) {
              var hit = !q || c.getAttribute('data-q').indexOf(q) !== -1;
              c.hidden = !hit; if (hit) shown++;
            });
            sec.hidden = shown === 0; if (shown) any = true;
          });
          document.getElementById('gameNone').hidden = any;
        });
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</Base>
