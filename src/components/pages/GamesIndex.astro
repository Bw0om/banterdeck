---
// Alle drikkelekene. Lekene som spilles i appen (fra hver sin telefon) først og størst,
// så lekene der telefonen hjelper, og til slutt klassikerne der dere bare trenger reglene.
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import Icon from '../Icon.astro';
import PopulaertNaa from '../PopulaertNaa.astro';
import { spill, gamesFor, gameHref, langGroups, t } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
import { PLUSS_SLUGS } from '../../lib/plussleker';
import { niva, HOOK, spillere } from '../../lib/niva';
import { illustrasjon } from '../../lib/illustrasjon';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const L = ui(lang);
const no = lang === 'no';
const PL = new Set(PLUSS_SLUGS);
const synlige = gamesFor(lang);
const gruppeNavn: Record<string, string> = Object.fromEntries(langGroups(spill, lang).map((g: any) => [g.id, t(g.title, lang)]));
// Rekkefølgen i toppen: de som får folk hekta først
const TOPP = ['spionen', 'hvem-skrev-det', 'bloffquizen', 'pekeleken', 'nyhetsrunden', 'ring-of-fire', 'forraeder', 'regelfabrikken', 'samme-svar',
  'pyramiden', 'bussruta', 'hvem-er-jeg', 'to-sannheter-og-en-logn', 'drikke-bingo', 'skal-refleksen', 'jeg-har-aldri', 'president', 'gris'];
const rang = (s: string) => { const i = TOPP.indexOf(s); return i === -1 ? 99 : i; };
/** Første setning av reglene, som kort beskrivelse. */
function kort(g: any) {
  const r = (g.rules && (g.rules[lang] || g.rules.no)) || [];
  const f = String((r.find((x: string) => !x.startsWith('b|')) || r[0] || '')).replace(/^b\|/, '');
  const s = f.split(/(?<=[.!?])\s/)[0] || f;
  return s.length > 110 ? s.slice(0, 107).trimEnd() + '…' : s;
}
const leker = synlige.map((g: any) => {
  const [min, maks] = spillere(g.pl);
  const n = niva(g.slug);
  return { g, slug: g.slug, navn: t(g.name, lang), niva: n, href: gameHref(g, (p) => path(lang, p), lang), bilde: illustrasjon(g),
    om: HOOK[g.slug] ? HOOK[g.slug][no ? 0 : 1] : kort(g), utstyr: t(g.gear, lang), pl: g.pl, min, maks, gruppe: g.group.id,
    gruppeNavn: gruppeNavn[g.group.id] || '', pluss: PL.has(g.slug) };
});
const rom = leker.filter((x) => x.niva === 'rom').sort((a, b) => rang(a.slug) - rang(b.slug));
const app = leker.filter((x) => x.niva === 'app').sort((a, b) => rang(a.slug) - rang(b.slug) || a.navn.localeCompare(b.navn, 'nb'));
const regler = leker.filter((x) => x.niva === 'regler').sort((a, b) => a.navn.localeCompare(b.navn, 'nb'));
const q = (x: any) => `${t(x.g.name, 'no')} ${t(x.g.name, 'en')} ${x.utstyr} ${x.gruppeNavn}`.toLowerCase();
const searchPh = no ? 'Søk etter lek eller utstyr …' : 'Search games or equipment…';
const romSti = no ? '/no/rom' : '/room';
---
<Base title={L.gamesTitle} description={L.gamesDesc(synlige.length)} lang={lang} gate={true} bilde="/og/drikkeleker.jpg">
  <p class="crumb"><a href={path(lang, '/')}>{L.breadcrumbHome}</a> › {L.gamesTitle}</p>
  <h1 class="withicon"><Icon name="drikkeleker" size={34} />{L.gamesTitle}</h1>
  <p class="lead">{no ? `${synlige.length} leker. De beste spiller dere fra hver deres telefon – ingen kortstokk, ingen forberedelser.` : `${synlige.length} games. The best ones you play from your own phones – no deck of cards, no prep.`}</p>

  <div class="lk-snarveier">
    <a class="btn gold" href={romSti}><Icon name="telefon" />{no ? 'Lag et rom' : 'Create a room'}</a>
    <a class="btn ghost" href={no ? '/no/finn-lek' : '/find-a-game'}>{no ? 'Finn lek på 3 spørsmål' : 'Find a game in 3 questions'}</a>
    <a class="btn ghost" href={no ? '/no/kveld' : '/plan'}>{no ? 'Planlegg kvelden' : 'Plan the night'}</a>
  </div>

  <div class="lk-filter sticky" id="lkFilter">
    <input id="gameInput" type="search" autocomplete="off" placeholder={searchPh} aria-label={searchPh} />
    <div class="lk-chips" role="group" aria-label={no ? 'Filtrer' : 'Filter'}>
      <button type="button" data-f="niva" data-v="" aria-pressed="true">{no ? 'Alle' : 'All'}</button>
      <button type="button" data-f="niva" data-v="rom" aria-pressed="false"><Icon name="telefon" size={16} />{no ? 'I appen' : 'In the app'}</button>
      <button type="button" data-f="niva" data-v="app" aria-pressed="false"><Icon name="kort" size={16} />{no ? 'Telefonen hjelper' : 'Phone helps'}</button>
      <button type="button" data-f="niva" data-v="regler" aria-pressed="false"><Icon name="ordbok" size={16} />{no ? 'Bare regler' : 'Just rules'}</button>
      <span class="lk-skille" aria-hidden="true"></span>
      <button type="button" data-f="pl" data-v="2" aria-pressed="false">{no ? 'For to' : 'For two'}</button>
      <button type="button" data-f="pl" data-v="4" aria-pressed="false">3–5</button>
      <button type="button" data-f="pl" data-v="6" aria-pressed="false">{no ? '6 eller flere' : '6 or more'}</button>
      <button type="button" data-f="pluss" data-v="0" aria-pressed="false">{no ? 'Bare gratis' : 'Free only'}</button>
    </div>
    <label class="alkfri-linje lk-alkfri"><button type="button" class="alkfri-bryter" data-alkoholfri-bryter aria-pressed="false"><span class="alkfri-knott" aria-hidden="true"></span>{no ? 'Alkoholfri' : 'Alcohol-free'}</button></label>
  </div>

  <section class="lk-seksjon" data-seksjon="rom">
    <div class="lk-hode">
      <h2 class="withicon"><Icon name="telefon" size={24} />{no ? 'Spill fra hver sin telefon' : 'Play from your own phones'}</h2>
      <p class="small">{no ? 'Én lager et rom, resten blir med på koden. Hemmeligheter, stemming og poeng – det kan ingen kortstokk.' : 'One person creates a room, everyone else joins with the code. Secrets, voting and scores – no deck of cards can do that.'}</p>
    </div>
    <div class="lk-store">
      {rom.map((x) => (
        <a class="lk-kort" href={x.href} data-q={q(x)} data-niva="rom" data-min={x.min} data-maks={x.maks} data-pluss={x.pluss ? '1' : '0'}>
          <img src={x.bilde} alt="" width="240" height="126" loading="lazy" decoding="async" />
          <span class="lk-tekst">
            <b>{x.navn}</b>
            <span class="lk-meta"><span class="lk-pl"><Icon name="gjeng" size={14} />{x.pl}</span>{x.pluss ? <i class="pluss"><Icon name="gnist" size={12} />Pluss</i> : <i class="gratis">{no ? 'Gratis' : 'Free'}</i>}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <PopulaertNaa lang={lang} vis="leker" />
  <AdSlot />

  <section class="lk-seksjon" data-seksjon="app">
    <div class="lk-hode">
      <h2 class="withicon"><Icon name="kort" size={24} />{no ? 'Telefonen er kortstokken' : 'The phone is the deck'}</h2>
      <p class="small">{no ? 'Én telefon på bordet: kort, terninger, klokke eller spørsmål – dere trenger ikke noe annet.' : 'One phone on the table: cards, dice, timer or questions – you don’t need anything else.'}</p>
    </div>
    <!-- Bare navn her – beskrivelsen står når man trykker seg inn på leken -->
    <div class="lk-mellom">
      {app.map((x) => (
        <a class="lk-rad" href={x.href} data-q={q(x)} data-niva="app" data-min={x.min} data-maks={x.maks} data-pluss={x.pluss ? '1' : '0'}>
          <img src={x.bilde} alt="" width="72" height="72" loading="lazy" decoding="async" />
          <span class="lk-tekst"><b>{x.navn}</b><span class="lk-meta"><span class="lk-pl"><Icon name="gjeng" size={14} />{x.pl}</span><span>{x.gruppeNavn}</span>{x.pluss && <i class="pluss"><Icon name="gnist" size={12} />Pluss</i>}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="lk-seksjon" data-seksjon="regler">
    <div class="lk-hode">
      <h2 class="withicon"><Icon name="ordbok" size={24} />{no ? 'Klassikere – bare regler' : 'Classics – just the rules'}</h2>
      <p class="small">{no ? 'Kopper, baller og en god dose konkurranseinstinkt. Her finner du reglene.' : 'Cups, balls and a healthy dose of competitive spirit. Here are the rules.'}</p>
    </div>
    <div class="lk-sma">
      {regler.map((x) => (
        <a class="lk-liten" href={x.href} data-q={q(x)} data-niva="regler" data-min={x.min} data-maks={x.maks} data-pluss="0">
          <b>{x.navn}</b><span>{x.utstyr} · {x.pl}</span>
        </a>
      ))}
    </div>
  </section>
  <p class="small" id="gameNone" hidden>{L.noResults}</p>

  {no && (
    <p class="guidechips lk-anledning">
      <span class="small">Til anledningen:</span>
      <a href="/no/leker/vors">Vors</a>
      <a href="/no/leker/nachspiel">Nachspiel</a>
      <a href="/no/leker/bursdag">Bursdag</a>
      <a href="/no/leker/to-personer">For to</a>
      <a href="/no/leker/store-grupper">Store grupper</a>
      <a href="/no/suggest#lek">Send inn en lek</a>
    </p>
  )}

  <script is:inline>
    (function () {
      function init() {
        var root = document.getElementById('lkFilter');
        if (!root || root.dataset.bound) return; root.dataset.bound = '1';
        var inp = document.getElementById('gameInput'), f = { niva: '', pl: '', pluss: '' };
        function passer(el) {
          var q = inp.value.trim().toLowerCase();
          if (q && el.getAttribute('data-q').indexOf(q) === -1) return false;
          if (f.niva && el.dataset.niva !== f.niva) return false;
          if (f.pluss === '0' && el.dataset.pluss === '1') return false;
          if (f.pl) {
            var min = Number(el.dataset.min), maks = Number(el.dataset.maks), n = Number(f.pl);
            if (n === 2 && !(min <= 2 && maks >= 2)) return false;
            if (n === 4 && !(min <= 5 && maks >= 3)) return false;
            if (n === 6 && !(maks >= 6)) return false;
          }
          return true;
        }
        function oppdater() {
          var noen = false;
          document.querySelectorAll('[data-seksjon]').forEach(function (sec) {
            var vist = 0;
            sec.querySelectorAll('[data-q]').forEach(function (el) { var ok = passer(el); el.hidden = !ok; if (ok) vist++; });
            sec.hidden = vist === 0; if (vist) noen = true;
          });
          document.getElementById('gameNone').hidden = noen;
        }
        inp.addEventListener('input', oppdater);
        root.addEventListener('click', function (e) {
          var b = e.target.closest('[data-f]'); if (!b) return;
          var k = b.dataset.f, v = b.dataset.v;
          // Klikk på et valgt filter (utenom «Alle») slår det av igjen
          f[k] = f[k] === v && k !== 'niva' ? '' : v;
          root.querySelectorAll('[data-f="' + k + '"]').forEach(function (x) { x.setAttribute('aria-pressed', String(x.dataset.v === f[k] || (k === 'niva' && !f[k] && !x.dataset.v))); });
          if (k !== 'niva' && !f[k]) b.setAttribute('aria-pressed', 'false');
          oppdater();
        });
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</Base>
