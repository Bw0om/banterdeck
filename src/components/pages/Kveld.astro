---
// Kveldsoppsett: velg lengde, gjeng og utstyr – få en rekkefølge av leker med tid på hver.
// Felles for /no/kveld (lang="no") og /plan (lang="en").
import Base from '../../layouts/Base.astro';
import { gamesFor, t } from '../../lib/content';
import { romLenke } from '../../lib/romlenke';
import { PLUSS_SLUGS } from '../../lib/plussleker';
import type { Lang } from '../../lib/i18n';
const { lang = 'no' } = Astro.props as { lang?: Lang };
const no = lang === 'no';
// fase: o = oppvarming, h = hoveddel, f = finale · min = minutter · vill: 1–3 · pl: minst antall
// utstyr: '' = bare telefon, 'kopper' = kopper og bord, 'musikk' = høyttaler · rom: kan spilles i rom · bareRom: trenger flere telefoner
// tips = norsk, en = engelsk
const LEKER: Record<string, { fase: string; min: number; vill: number; pl: number; utstyr?: string; rom?: boolean; bareRom?: boolean; tips: string; en: string }> = {
  'pekeleken': { fase: 'o', min: 15, vill: 1, pl: 4, rom: true, tips: 'Alle peker samtidig. Lett start, får praten i gang.', en: 'Everyone points at once. An easy start that gets people talking.' },
  'jeg-har-aldri': { fase: 'o', min: 15, vill: 2, pl: 3, rom: true, tips: 'Klassikeren. Ta den rolige modusen først.', en: 'The classic. Start with the mild mode.' },
  '50-50': { fase: 'o', min: 10, vill: 1, pl: 4, rom: true, tips: 'Halvparten drikker hver gang – ingen blir sittende alene.', en: 'Half the table drinks every time – nobody drinks alone.' },
  'enten-eller': { fase: 'o', min: 10, vill: 1, pl: 4, rom: true, tips: 'Minoriteten drikker.', en: 'The minority drinks.' },
  'to-sannheter-og-en-logn': { fase: 'o', min: 15, vill: 1, pl: 3, rom: true, tips: 'Perfekt når ikke alle kjenner hverandre.', en: "Perfect when not everyone knows each other." },
  'tanken-bak-sangen': { fase: 'o', min: 15, vill: 1, pl: 2, utstyr: 'musikk', rom: true, tips: 'Musikk i gang og historier på bordet.', en: 'Music on and stories on the table.' },
  'nyhetsrunden': { fase: 'o', min: 20, vill: 1, pl: 3, rom: true, tips: 'Ukas nyheter – verten leser, alle svarer på sin telefon.', en: "This week's news – the host reads, everyone answers on their phone." },
  'kategorier': { fase: 'h', min: 15, vill: 2, pl: 3, rom: true, tips: 'Den som ikke kommer på noe, drikker.', en: 'Whoever blanks, drinks.' },
  'ring-of-fire': { fase: 'h', min: 30, vill: 2, pl: 3, rom: true, tips: 'Kvelden kan godt bygges rundt denne.', en: 'You could build the whole night around this one.' },
  'forraeder': { fase: 'h', min: 20, vill: 2, pl: 4, rom: true, bareRom: true, tips: 'Hemmelige roller på hver sin telefon.', en: "Secret roles on everyone's phone." },
  'regelfabrikken': { fase: 'h', min: 25, vill: 2, pl: 3, rom: true, tips: 'Dere skriver kortene selv – blir bare bedre utover kvelden.', en: 'You write the cards yourselves – it only gets better as the night goes on.' },
  'drikke-bingo': { fase: 'h', min: 30, vill: 2, pl: 3, utstyr: 'musikk', rom: true, tips: 'Spilleliste på, hver sitt brett.', en: 'Playlist on, a card each.' },
  'veddelopet': { fase: 'h', min: 15, vill: 2, pl: 3, rom: true, tips: 'Kort og intenst. Alle vedder samtidig.', en: 'Short and intense. Everyone bets at once.' },
  'bussruta': { fase: 'h', min: 25, vill: 3, pl: 3, rom: true, tips: 'Noen ender på bussen. Beste før finalen.', en: 'Someone ends up on the bus. Best right before the finale.' },
  'drikke-yatzy': { fase: 'h', min: 30, vill: 2, pl: 2, rom: true, tips: 'Rolig tempo, men enere og fire like svir.', en: 'Slow pace, but ones and four of a kind sting.' },
  'pyramiden': { fase: 'h', min: 25, vill: 2, pl: 3, rom: true, bareRom: true, tips: 'Bløff med skjulte kort på telefonen.', en: 'Bluffing with hidden cards on your phone.' },
  'president': { fase: 'h', min: 30, vill: 2, pl: 4, rom: true, bareRom: true, tips: 'Titler som varer resten av kvelden.', en: 'Titles that stick for the rest of the night.' },
  'gris': { fase: 'h', min: 15, vill: 2, pl: 4, rom: true, bareRom: true, tips: 'Kaotisk og kjapp. Sistemann på nesa drikker.', en: 'Chaotic and quick. Last finger on the nose drinks.' },
  'over-eller-under': { fase: 'h', min: 15, vill: 2, pl: 2, rom: true, tips: 'Enkel og rask mellom to større leker.', en: 'Quick and simple between two bigger games.' },
  'fuck-the-dealer': { fase: 'h', min: 20, vill: 3, pl: 3, tips: 'Én telefon, dealeren styrer.', en: "One phone, the dealer's in charge." },
  '21-med-terninger': { fase: 'h', min: 15, vill: 2, pl: 2, tips: 'Telefonen er terningen.', en: 'The phone is the die.' },
  'beer-pong': { fase: 'h', min: 30, vill: 2, pl: 2, utstyr: 'kopper', tips: 'Rigg bordet mens noen spiller noe annet.', en: 'Set up the table while the others play something else.' },
  'flip-cup': { fase: 'f', min: 15, vill: 3, pl: 6, utstyr: 'kopper', tips: 'Lag mot lag – full fart.', en: 'Team against team – full speed.' },
  'rage-cage': { fase: 'f', min: 20, vill: 3, pl: 6, utstyr: 'kopper', tips: 'For de som vil avslutte hardt.', en: 'For those who want to finish hard.' },
  'opus': { fase: 'f', min: 10, vill: 3, pl: 4, utstyr: 'musikk', tips: 'Send telefonen rundt og vent på droppet.', en: 'Pass the phone around and wait for the drop.' },
  'thunderstruck': { fase: 'f', min: 5, vill: 3, pl: 3, utstyr: 'musikk', tips: 'Fem minutter kaos. Vannglass klart.', en: 'Five minutes of chaos. Keep a glass of water ready.' },
  'power-hour': { fase: 'f', min: 60, vill: 3, pl: 1, utstyr: 'musikk', tips: 'Én slurk i minuttet i en time. Bare for de modige.', en: 'One sip a minute for an hour. Only for the brave.' },
};
const synlige = gamesFor(lang);
const finnes = new Set(synlige.map((g: any) => g.slug));
const DATA = Object.fromEntries(Object.entries(LEKER).filter(([s]) => finnes.has(s)).map(([s, v]) => {
  const g = synlige.find((x: any) => x.slug === s);
  const { en, ...rest } = v;
  return [s, { ...rest, tips: no ? v.tips : en, navn: t(g.name, lang), romHref: romLenke(s, '', lang), pluss: PLUSS_SLUGS.includes(s) }];
}));
---
<Base title={no ? 'Kveldsplan' : 'Night plan'} description={no ? 'Planlegg kvelden: få en rekkefølge av drikkeleker tilpasset gjengen, tiden og utstyret dere har.' : 'Plan the night: get a running order of drinking games that fits your crew, your time and what you have to play with.'} lang={lang} gate={true} bilde="/og/drikkeleker.jpg">
  <h1>{no ? 'Kveldsplan' : 'Night plan'}</h1>
  <p class="lead">{no ? 'Si hvor lenge dere har og hva dere har å spille med, så setter vi opp kvelden – fra oppvarming til finale.' : "Tell us how long you've got and what you've got to play with, and we'll set up the night – from warm-up to finale."}</p>

  <form id="kvSkjema" class="form kv-skjema">
    <fieldset class="kv-valg"><legend class="lab">{no ? 'Hvor lenge?' : 'How long?'}</legend>
      <label><input type="radio" name="tid" value="60"> {no ? '1 time' : '1 hour'}</label>
      <label><input type="radio" name="tid" value="120" checked> {no ? '2 timer' : '2 hours'}</label>
      <label><input type="radio" name="tid" value="180"> {no ? '3 timer+' : '3 hours+'}</label>
    </fieldset>
    <fieldset class="kv-valg"><legend class="lab">{no ? 'Hvor mange?' : 'How many?'}</legend>
      <label><input type="radio" name="pl" value="3"> 2–3</label>
      <label><input type="radio" name="pl" value="5" checked> 4–6</label>
      <label><input type="radio" name="pl" value="8"> 7+</label>
    </fieldset>
    <fieldset class="kv-valg"><legend class="lab">{no ? 'Stemning' : 'Vibe'}</legend>
      <label><input type="radio" name="vill" value="1"> {no ? 'Rolig' : 'Chill'}</label>
      <label><input type="radio" name="vill" value="2" checked> {no ? 'Passe' : 'Balanced'}</label>
      <label><input type="radio" name="vill" value="3"> {no ? 'Vill' : 'Wild'}</label>
    </fieldset>
    <fieldset class="kv-valg"><legend class="lab">{no ? 'Dette har vi' : "We've got"}</legend>
      <label><input type="checkbox" name="utstyr" value="musikk" checked> {no ? 'Høyttaler' : 'A speaker'}</label>
      <label><input type="checkbox" name="utstyr" value="kopper"> {no ? 'Kopper og bord' : 'Cups and a table'}</label>
      <label><input type="checkbox" name="rom" value="1" checked> {no ? 'Hver sin telefon' : 'A phone each'}</label>
    </fieldset>
    <button class="btn gold" type="submit">{no ? 'Lag kveldsplan' : 'Make the plan'}</button>
  </form>

  <section id="kvPlan" class="kv-plan" hidden></section>

  <script is:inline data-astro-rerun define:vars={{ DATA, LANG: lang }}>
  (function () {
    var skjema = document.getElementById('kvSkjema'), ut = document.getElementById('kvPlan');
    if (!skjema || skjema.dataset.bound) return; skjema.dataset.bound = '1';
    var EN = LANG === 'en';
    // nyPlan: bare en helt ny plan glir inn punkt for punkt – ikke hvert steg eller bytte senere
    var plan = null, valg = null, aktiv = -1, klokke = null, nyPlan = false;
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function bland(a) { a = a.slice(); for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var x = a[i]; a[i] = a[j]; a[j] = x; } return a; }
    function lagre() { try { localStorage.setItem('bd_kveld', JSON.stringify({ plan: plan, valg: valg, aktiv: aktiv, start: plan && plan.start })); } catch (e) {} }

    function passer(slug, fase, brukt) {
      var g = DATA[slug];
      if (!g || g.fase !== fase || brukt.indexOf(slug) !== -1) return false;
      if (g.pl > valg.pl) return false;
      if (g.utstyr && valg.utstyr.indexOf(g.utstyr) === -1) return false;
      if (g.bareRom && !valg.rom) return false;
      if (valg.vill === 1 && g.vill === 3) return false;
      if (valg.vill === 3 && g.vill === 1 && fase === 'h') return false;
      if (slug === 'power-hour' && valg.tid < 180) return false;
      return true;
    }
    function velg(fase, brukt, maksMin) {
      var kand = Object.keys(DATA).filter(function (s) { return passer(s, fase, brukt) && DATA[s].min <= maksMin; });
      // Villere kvelder foretrekker villere leker
      kand = bland(kand).sort(function (a, b) { return Math.abs(DATA[a].vill - valg.vill) - Math.abs(DATA[b].vill - valg.vill); });
      return kand[0] || null;
    }
    function lagPlan() {
      var brukt = [], blokker = [], igjen = valg.tid;
      var o = velg('o', brukt, 25); if (o) { brukt.push(o); blokker.push({ slug: o, min: DATA[o].min }); igjen -= DATA[o].min; }
      var finaleTid = valg.tid >= 180 ? 60 : 20;
      var f = velg('f', brukt, finaleTid) || velg('h', brukt, 25);
      if (f) brukt.push(f);
      igjen -= f ? DATA[f].min : 0;
      var vakt = 0;
      while (igjen >= 10 && vakt++ < 12) {
        var h = velg('h', brukt, igjen);
        if (!h) break;
        brukt.push(h); blokker.push({ slug: h, min: DATA[h].min }); igjen -= DATA[h].min;
      }
      if (f) blokker.push({ slug: f, min: DATA[f].min, finale: true });
      return { blokker: blokker, start: null };
    }
    function bytt(i) {
      var b = plan.blokker[i], fase = b.finale ? 'f' : (i === 0 ? 'o' : 'h');
      var brukt = plan.blokker.map(function (x) { return x.slug; });
      var ny = velg(fase, brukt, b.min + 15) || velg('h', brukt, b.min + 15);
      if (!ny) return;
      plan.blokker[i] = { slug: ny, min: DATA[ny].min, finale: b.finale };
      lagre(); tegn();
    }
    function tid(min) { return min >= 60 ? Math.floor(min / 60) + (EN ? ' h' : ' t') + (min % 60 ? ' ' + (min % 60) + ' min' : '') : min + ' min'; }
    function tegn() {
      ut.hidden = false;
      var totalt = plan.blokker.reduce(function (n, b) { return n + b.min; }, 0), t0 = 0;
      ut.innerHTML = '<div class="kv-topp"><h2>' + (EN ? "Tonight's plan" : 'Kveldens plan') + '</h2><span class="small">' + plan.blokker.length + (EN ? ' games · about ' : ' leker · ca. ') + tid(totalt) + '</span></div>' +
        '<ol class="kv-liste' + (nyPlan ? ' kv-ny' : '') + '">' + plan.blokker.map(function (b, i) {
          var g = DATA[b.slug], fra = t0; t0 += b.min;
          var merke = i === 0 ? (EN ? 'Warm-up' : 'Oppvarming') : b.finale ? 'Finale' : (EN ? 'Main event' : 'Hoveddel');
          return '<li class="' + (i === aktiv ? 'aktiv' : i < aktiv ? 'ferdig' : '') + '">' +
            '<span class="kv-tid">' + (fra ? '+' + tid(fra) : 'Start') + '</span>' +
            '<div class="kv-lek"><small>' + merke + ' · ' + b.min + ' min' + (g.pluss ? (EN ? ' · ✨ Plus' : ' · ✨ Pluss') : '') + '</small><b>' + esc(g.navn) + '</b><span>' + esc(g.tips) + '</span>' +
            '<div class="kv-knapper"><a class="btn gold small" href="' + (EN ? '/drinking-games/' : '/no/drinking-games/') + b.slug + '/">' + (EN ? 'Rules and tools' : 'Regler og verktøy') + '</a>' +
            (g.rom && valg.rom ? '<a class="btn small" href="' + g.romHref + '">' + (EN ? 'Open a room' : 'Åpne rom') + '</a>' : '') +
            (i >= aktiv ? '<button class="mini" type="button" data-bytt="' + i + '">' + (EN ? 'Swap' : 'Bytt') + '</button>' : '') + '</div></div></li>';
        }).join('') + '</ol>' +
        '<div class="kv-styring">' + (aktiv < 0
          ? '<button class="btn gold" type="button" data-k="start">' + (EN ? 'Start the night' : 'Start kvelden') + '</button><button class="btn ghost" type="button" data-k="ny">' + (EN ? 'Make a new one' : 'Lag en ny') + '</button>'
          : aktiv < plan.blokker.length
            ? '<div class="kv-naa"><span class="small">' + (EN ? 'Now: ' : 'Nå: ') + '<b>' + esc(DATA[plan.blokker[aktiv].slug].navn) + '</b></span><span class="kv-klokke" id="kvKlokke"></span></div>' +
              '<button class="btn gold" type="button" data-k="neste">' + (aktiv + 1 < plan.blokker.length ? (EN ? 'Next game' : 'Neste lek') : (EN ? "That's it for tonight" : 'Ferdig for kvelden')) + '</button>'
            : '<p class="dl-melding dl-stor">' + (EN ? "That's a wrap! Remember water 💧" : 'Det var kvelden! Husk vann 💧') + '</p><button class="btn ghost" type="button" data-k="ny">' + (EN ? 'Make a new plan' : 'Lag en ny plan') + '</button>') + '</div>';
      oppdaterKlokke();
    }
    function oppdaterKlokke() {
      clearInterval(klokke);
      if (aktiv < 0 || aktiv >= plan.blokker.length || !plan.blokkStart) return;
      var slutt = plan.blokkStart + plan.blokker[aktiv].min * 60000;
      function tikk() {
        var el = document.getElementById('kvKlokke'); if (!el) return clearInterval(klokke);
        var ms = slutt - Date.now(), m = Math.floor(Math.abs(ms) / 60000), s = Math.floor(Math.abs(ms) % 60000 / 1000);
        el.textContent = ms >= 0 ? m + ':' + String(s).padStart(2, '0') + (EN ? ' left' : ' igjen') : (EN ? 'Overtime – swap whenever you like' : 'På overtid – bytt når dere vil');
        el.classList.toggle('over', ms < 0);
      }
      tikk(); klokke = setInterval(tikk, 1000);
    }
    skjema.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = new FormData(skjema);
      valg = { tid: +f.get('tid'), pl: +f.get('pl'), vill: +f.get('vill'), utstyr: f.getAll('utstyr'), rom: !!f.get('rom') };
      plan = lagPlan(); aktiv = -1; nyPlan = true; lagre(); tegn(); nyPlan = false;
      ut.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    ut.addEventListener('click', function (e) {
      var b = e.target.closest('[data-bytt]'); if (b) return bytt(+b.dataset.bytt);
      var k = e.target.closest('[data-k]'); if (!k) return;
      if (k.dataset.k === 'start') { aktiv = 0; plan.blokkStart = Date.now(); }
      if (k.dataset.k === 'neste') { aktiv++; plan.blokkStart = Date.now(); }
      if (k.dataset.k === 'ny') { plan = lagPlan(); aktiv = -1; nyPlan = true; }
      lagre(); tegn(); nyPlan = false;
    });
    document.addEventListener('astro:before-swap', function () { clearInterval(klokke); }, { once: true });
    // Fortsett en plan fra tidligere i kveld
    try {
      var lagret = JSON.parse(localStorage.getItem('bd_kveld') || 'null');
      if (lagret && lagret.plan && lagret.plan.blokker && lagret.plan.blokker.every(function (b) { return DATA[b.slug]; }) &&
          (lagret.aktiv < 0 || (lagret.plan.blokkStart && Date.now() - lagret.plan.blokkStart < 8 * 3600000))) {
        plan = lagret.plan; valg = lagret.valg; aktiv = lagret.aktiv; tegn();
      }
    } catch (e) {}
  })();
  </script>
</Base>
