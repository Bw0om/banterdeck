        '<p class="rom-status">' + (s.igjen != null ? s.igjen : ROF_N - tatt.length) + T(' kort i ringen · ', ' cards in the ring · ') + (s.konger || 0) + T(' av 4 konger', ' of 4 kings') + '</p>' +
        lunte((s.igjen != null ? s.igjen : ROF_N - tatt.length) / ROF_N) +
