      if (sisteBev === null || maks < sisteBev) { sisteBev = maks; return; }   // første visning eller ny børs: ikke vis gammelt
      liste.filter(function (e) { return e.n > sisteBev; }).forEach(function (e, i) { setTimeout(function () { visPenger(e); }, 900 * i); });
