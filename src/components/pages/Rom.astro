        return '<div class="rom-vent"><p class="rom-stor">' + T('Venter på at ' + esc(navn(t.vert)) + ' velger en lek …', 'Waiting for ' + esc(navn(t.vert)) + ' to pick a game …') + '</p>' +
          '<p class="small">' + t.spillere.length + T(' med i rommet. Del koden <b>', ' in the room. Share the code <b>') + esc(kode) + T('</b> med resten.', '</b> with the others.') + '</p>' + romMerker() + '</div>';
      }
