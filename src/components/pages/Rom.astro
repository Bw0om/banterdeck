---
// Rommet («Spill sammen» / «Play together») – én felles side for /no/rom og /room.
import Base from '../../layouts/Base.astro';
import KortVelger from '../KortVelger.astro';
import { lekeliste } from '../../lib/rom';
import type { Lang } from '../../lib/i18n';
const { lang = 'no' } = Astro.props as { lang?: Lang };
const EN = lang === 'en';
const LANG = EN ? 'en' : 'no';
// Navnene på lekene, så «Spill fra hver sin telefon» fra en lekeside kan vise riktig lek før rommet finnes
const LEKNAVN = Object.fromEntries(lekeliste(LANG).map((l: any) => [l.id, l.navn]));
// Det rommet trenger fra serveren, som JSON i siden (src/klient/rom.js leser det). < escapes, så ingenting kan bryte ut av taggen.
const ROMDATA = JSON.stringify({ LEKNAVN, LANG }).replace(/</g, '\\u003c');
---
<Base title={EN ? 'Play together' : 'Spill sammen'} description={EN ? 'Create a room and get everyone in from their own phone. Same card on every screen, secret roles, voting and bingo.' : 'Lag et rom og få med alle fra hver sin telefon. Samme kort på alle skjermer, hemmelige roller, stemming og bingo.'} lang={LANG} gate={true} bilde="/og/rom.jpg">
  <KortVelger />
  <div id="rom" class="rom">
    <noscript><p>{EN ? 'The room needs JavaScript.' : 'Rommet trenger JavaScript.'}</p></noscript>
  </div>
  <script is:inline define:vars={{ EN }}>
    // Skjelettet av rommet med en gang siden kommer – før selve romkoden (100 kB) er lastet. Samme
    // skjelett som rom.js tegner; den tar over når den er klar. Bare når man har en romkode og er med.
    (function () {
      var k = (new URLSearchParams(location.search).get('k') || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8);
      var r = document.getElementById('rom');
      try { if (!k || !r || !localStorage.getItem('bd_rom_' + k)) return; } catch (e) { return; }
      document.documentElement.classList.add('i-rom');
      r.innerHTML = '<div class="rom-laster" aria-busy="true"><div class="rom-hode"><div class="rom-hode-v"><div><span class="rom-etikett">' + (EN ? 'Room' : 'Rom') + '</span><b class="rom-kode">' + k + '</b></div></div>' +
        '<span class="rom-hodeknapper"><i></i><i></i><i></i><i></i></span></div><div class="skj-rad"><i></i><i></i><i></i></div><div class="skj-kort"></div>' +
        '<p class="rom-laster-tekst" role="status">' + (EN ? 'Connecting to room ' : 'Kobler til rom ') + k + ' …</p></div>';
    })();
  </script>

  <script>
    import qrcode from 'qrcode-generator';
    (window as any).BDqr = function (tekst: string) {
      const q = qrcode(0, 'M'); q.addData(tekst); q.make();
      return q.createSvgTag({ cellSize: 6, margin: 2, scalable: true });
    };
    // Rommet kan ha tegnet lobbyen før denne fila var lastet (tregt nett) – da tegnes QR-koden nå
    document.dispatchEvent(new CustomEvent('bdqr-klar'));
  </script>
  <script is:inline type="application/json" id="romData" set:html={ROMDATA}></script>
  <script>
    // Selve rommet ligger i src/klient/rom.js (en egen fil som nettleseren lagrer). Den startes ved hver
    // sidevisning – også når man kommer hit fra en annen side uten full lasting.
    import { startRom } from '../../klient/rom.js';
    function kjorRom() {
      const data = document.getElementById('romData');
      if (!data || !document.getElementById('rom')) return;
      let d: any = {};
      try { d = JSON.parse(data.textContent || '{}'); } catch { /* tom */ }
      startRom(d.LEKNAVN || {}, d.LANG === 'en' ? 'en' : 'no');
    }
    document.addEventListener('astro:page-load', kjorRom);
  </script>
</Base>
