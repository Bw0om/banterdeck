          '<p>' + T('Venter på at ' + esc(navn(t.vert)) + ' starter når alle er med …', 'Waiting for ' + esc(navn(t.vert)) + ' to start once everyone\'s in …') + '</p>' + liste + romMerker() + '</div>';
      }
