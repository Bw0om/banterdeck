      }
      if (!l) return;
      if (l.pluss && !t.pluss) return visPlussTilbud();
      gjorAlltid({ handling: 'start', lek: l.id, modus: l.modus, sett: (settListe()[l.id] || []).slice(-1500) });
    }
    function planBoks() {
      var t = tilstand; if (!erVert() || !t.plan || !t.plan.length) return '';
