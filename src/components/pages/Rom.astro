        '<p class="rom-status">' + s.harValgt.length + T(' av ', ' of ') + tilstand.spillere.length + T(' har valgt', ' have picked') + (s.harFire ? ' · <b class="dl-hint">' + T('Du har fire like!', 'You have four of a kind!') + '</b>' : '') + '</p>' +
