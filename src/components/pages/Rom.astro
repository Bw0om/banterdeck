    function veddelopetSpill(s) {
      var F = ['♥', '♠', '♦', '♣'], NAVN = EN ? { '♥': 'Hearts', '♠': 'Spades', '♦': 'Diamonds', '♣': 'Clubs' } : { '♥': 'Hjerter', '♠': 'Spar', '♦': 'Ruter', '♣': 'Kløver' };
