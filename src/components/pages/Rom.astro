      if (t.gjeng) ut += '<p class="small">' + T('🏆 Kvelden telles i sesongen til ', '🏆 Tonight counts toward the season for ') + '<a href="' + RUTE.gjeng + '?k=' + esc(t.gjeng.kode) + '" target="_blank" rel="noopener">' + esc(t.gjeng.navn) + '</a>.</p>';
