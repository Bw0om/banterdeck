        '<span class="rom-hodeknapper"><button class="rom-del" data-g="hjul-aapne" type="button" aria-label="' + T('Straffehjul', 'Penalty wheel') + '">🎡</button><button class="rom-del" data-g="tavle" type="button" aria-label="' + T('Poengtavle', 'Scoreboard') + '">' + ikon.pokal + '</button><button class="rom-del" data-g="qr" type="button" aria-label="' + T('Vis QR-kode', 'Show QR code') + '">' + ikon.qr + '</button><button class="rom-del" data-g="del" type="button" aria-label="' + T('Inviter', 'Invite') + '">' + ikon.del + '<span class="rom-del-tekst">' + T('Inviter', 'Invite') + '</span></button></span>' +
