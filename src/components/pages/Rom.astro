        (s.ringBrutt ? '<p class="small rofr-hint">💥 ' + T('Ringen er brutt av ', 'The ring was broken by ') + esc((s.brudd && s.brudd.navn) || '') + T(' – nå kan den ikke ryke igjen. Bare trekk!', ' – it can’t break again. Just draw!') + '</p>'
