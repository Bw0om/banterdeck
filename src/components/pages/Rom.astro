    /* ---------- kort og terninger ---------- */
    function vn(v) { return v <= 10 ? String(v) : (EN ? { 11: 'J', 12: 'Q', 13: 'K', 14: 'A' } : { 11: 'Kn', 12: 'D', 13: 'K', 14: 'A' })[v]; }
