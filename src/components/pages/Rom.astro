    /* ---------- hemmelige oppdrag ---------- */
    /* ---------- Vorsbørsen ---------- */
    /** +xx / −xx som flyter opp på skjermen når pengene dine endrer seg på børsen. */
    var sisteBev = null;
    function borsPenger(d) {
      var liste = d && d.bors && d.bors.bev; if (!liste) { sisteBev = null; return; }
