    function forFa(l) { var min = MIN_SPILLERE[l.id] || MIN_SPILLERE[l.type] || 0; return min && tilstand.spillere.length < min ? min : 0; }
    /** Tre leker som er lette å starte med – ut fra hvor mange dere er. */
    function anbefalteLeker() {
