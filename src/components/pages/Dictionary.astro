---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import AdSlot from '../AdSlot.astro';
import { dictGroups, itemsOf, tdef, t, dictAnchor, situationById } from '../../lib/content';
import { ui, path, type Lang } from '../../lib/i18n';
const { lang = 'en', view = 'ord' } = Astro.props as { lang?: Lang; view?: string };
const L = ui(lang);
const TITTEL = view === 'uttrykk' ? L.uttrykkTitle : L.ordTitle;
const LEAD = view === 'uttrykk' ? L.uttrykkLead : L.ordLead;
const SOK = view === 'uttrykk' ? L.uttrykkSearch : L.ordSearch;
const IKON = view === 'uttrykk' ? 'uttrykk' : 'ordbok';
const groups = dictGroups(view, lang).map((g: any) => ({
  ...g,
  items: itemsOf(g, lang).slice().sort((a: any, b: any) =>
    a.word.replace(/^Å /i, '').localeCompare(b.word.replace(/^Å /i, ''), 'no')),
}));
---
<Base title={TITTEL} description={LEAD} lang={lang}>
  <p class="crumb"><a href={path(lang, '/')}>{L.breadcrumbHome}</a> › {TITTEL}</p>
  <h1 class="withicon"><Icon name={IKON} size={34} />{TITTEL}</h1>
  <p class="lead">{LEAD}</p>

  <div class="dictfilter sticky">
    <input id="dictInput" type="search" autocomplete="off" placeholder={SOK} aria-label={SOK} />
    <div class="chips dictchips">
      {groups.map((g: any) => <a href={`#${g.id}`}>{t(g.title, lang)}<b>{g.items.length}</b></a>)}
    </div>
  </div>

  {groups.map((g: any) => (
    <section class="group dictgroup" id={g.id} data-dgroup>
      <h3>{t(g.title, lang)}<span class="group-count">{g.items.length}</span></h3>
      <div class="cards">
        {g.items.map((it: any) => (
          <article class="card dict" id={dictAnchor(it.word)} data-copy={`${it.word} – ${tdef(it, lang)}`}
                   data-word={`${it.word} ${tdef(it, lang)} ${it.note || ''}`.toLowerCase()} tabindex="0" title={L.copyHint}>
            <p class="word">{it.word}</p>
            <p class="def">{tdef(it, lang)}</p>
            {it.note && <p class="note">{it.note}</p>}
            {(it.sit || []).length > 0 && (
              <p class="sittags">
                <span class="fits">{L.fitsIn}</span>
                {(it.sit || []).map(situationById).filter(Boolean).map((x: any) => (
                  <a href={path(lang, `/situations/${x.id}`)}>{t(x.title, lang)}</a>
                ))}
              </p>
            )}
            <div class="cardacts">
              <button class="starbtn" data-fav={`${it.word} – ${tdef(it, lang)}`} aria-label={L.favAdd}><Icon name="favoritt" /></button>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
  <p class="small" id="dictNone" hidden>{L.noResults}</p>

  <AdSlot />

  <script is:inline>
    (function () {
      function init() {
        var inp = document.getElementById('dictInput');
        if (!inp || inp.dataset.bound) return;
        inp.dataset.bound = '1';
        inp.addEventListener('input', function () {
          var q = inp.value.trim().toLowerCase(), any = false;
          document.querySelectorAll('[data-dgroup]').forEach(function (sec) {
            var shown = 0;
            sec.querySelectorAll('[data-word]').forEach(function (c) {
              var hit = !q || c.getAttribute('data-word').indexOf(q) !== -1;
              c.classList.toggle('hide', !hit); if (hit) shown++;
            });
            sec.hidden = shown === 0; if (shown) any = true;
          });
          document.getElementById('dictNone').hidden = any;
        });
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</Base>
