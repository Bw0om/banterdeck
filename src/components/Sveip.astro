---
/**
 * Sveipemodus: replikkene som en kortbunke i fullskjerm.
 * Åpnes av en knapp med [data-sveip]. items: [{ l: replikk, k: situasjon/merkelapp }]
 */
const { items, title, lang = 'no', shuffle = false } =
  Astro.props as { items: { l: string; k?: string }[]; title: string; lang?: string; shuffle?: boolean };
const T = lang === 'no'
  ? { back: 'Forrige', copy: 'Kopier', save: 'Lagre', close: 'Lukk', of: 'av', hint: 'Sveip for neste', done: 'Du har sett alle. Starter på nytt.' }
  : { back: 'Previous', copy: 'Copy', save: 'Save', close: 'Close', of: 'of', hint: 'Swipe for next', done: 'You have seen them all. Starting over.' };
---
<div class="sw" id="sveip" hidden tabindex="-1" role="dialog" aria-modal="true" aria-label={title}>
  <div class="sw-top">
    <button class="sw-x" data-sw="lukk" aria-label={T.close}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12"/><path d="M18 6 6 18"/></svg>
    </button>
    <div class="sw-title"><b>{title}</b><span class="sw-count"></span></div>
    <span class="sw-x" aria-hidden="true"></span>
  </div>
  <div class="sw-bar"><i></i></div>
  <div class="sw-stack">
    <div class="sw-card sw-b2" aria-hidden="true"></div>
    <div class="sw-card sw-b1" aria-hidden="true"></div>
    <div class="sw-card sw-front" tabindex="0">
      <span class="sw-tag"></span>
      <p class="sw-line"></p>
      <span class="sw-hint">{T.hint} →</span>
    </div>
  </div>
  <div class="sw-acts">
    <button class="sw-round" data-sw="tilbake" aria-label={T.back}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-2"/></svg>
    </button>
    <button class="sw-copy" data-copy="">{T.copy}</button>
    <button class="sw-round starbtn" data-fav="" aria-label={T.save}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>
    </button>
  </div>
</div>

<script is:inline data-astro-rerun define:vars={{ ITEMS: items, SHUFFLE: shuffle, T }}>
(function () {
  var root = document.getElementById('sveip');
  if (!root || root.dataset.bound) return; root.dataset.bound = '1';
  var front = root.querySelector('.sw-front'), line = root.querySelector('.sw-line'), tag = root.querySelector('.sw-tag');
  var count = root.querySelector('.sw-count'), bar = root.querySelector('.sw-bar i');
  var copyBtn = root.querySelector('.sw-copy'), favBtn = root.querySelector('[data-fav]');
  var order = [], pos = 0;
  function stokk() {
    order = ITEMS.slice();
    if (SHUFFLE) for (var i = order.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var x = order[i]; order[i] = order[j]; order[j] = x; }
    pos = 0;
  }
  function tegn() {
    var it = order[pos];
    line.textContent = '«' + it.l + '»';
    tag.textContent = it.k || '';
    tag.hidden = !it.k;
    count.textContent = (pos + 1) + ' ' + T.of + ' ' + order.length;
    bar.style.width = (100 * (pos + 1) / order.length) + '%';
    copyBtn.setAttribute('data-copy', it.l);
    favBtn.setAttribute('data-fav', it.l);
    var favs = []; try { favs = JSON.parse(localStorage.getItem('bd_favs') || '[]'); } catch (e) {}
    favBtn.classList.toggle('on', favs.indexOf(it.l) !== -1);
  }
  function neste(retning) {
    front.style.transition = 'transform .22s ease, opacity .22s ease';
    front.style.transform = 'translateX(' + (retning * 120) + '%) rotate(' + (retning * 14) + 'deg)';
    front.style.opacity = '0';
    setTimeout(function () {
      if (pos < order.length - 1) pos++; else stokk();
      front.style.transition = 'none'; front.style.transform = 'scale(.94)'; front.style.opacity = '0';
      tegn();
      requestAnimationFrame(function () { requestAnimationFrame(function () {
        front.style.transition = 'transform .18s ease, opacity .18s ease'; front.style.transform = ''; front.style.opacity = '';
      }); });
    }, 200);
  }
  function aapne() {
    if (!order.length) stokk();
    root.hidden = false; document.body.classList.add('noscroll');
    tegn(); root.focus({ preventScroll: true });
  }
  function lukk() { root.hidden = true; document.body.classList.remove('noscroll'); }

  /* Sidebytter lager en ny bunke; knappelytteren på dokumentet registreres bare én gang. */
  window.__bdSveip = aapne;
  if (!window.__bdSveipLytter) {
    window.__bdSveipLytter = true;
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-sveip]') && window.__bdSveip && document.getElementById('sveip')) { e.preventDefault(); window.__bdSveip(); }
    });
  }
  root.addEventListener('click', function (e) {
    var b = e.target.closest('[data-sw]'); if (!b) return;
    if (b.dataset.sw === 'lukk') lukk();
    if (b.dataset.sw === 'tilbake' && pos > 0) { pos--; tegn(); }
  });
  root.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') lukk();
    if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); neste(-1); }
    if (e.key === 'ArrowLeft' && pos > 0) { pos--; tegn(); }
  });

  /* Sveip med finger eller mus */
  var start = null, dx = 0;
  front.addEventListener('pointerdown', function (e) { start = e.clientX; dx = 0; front.setPointerCapture(e.pointerId); front.style.transition = 'none'; });
  front.addEventListener('pointermove', function (e) {
    if (start === null) return;
    dx = e.clientX - start;
    front.style.transform = 'translateX(' + dx + 'px) rotate(' + (dx / 18) + 'deg)';
  });
  function slipp() {
    if (start === null) return;
    start = null;
    if (Math.abs(dx) > 80) neste(dx > 0 ? 1 : -1);
    else if (Math.abs(dx) < 6) neste(-1);
    else { front.style.transition = 'transform .18s ease'; front.style.transform = ''; }
  }
  front.addEventListener('pointerup', slipp);
  front.addEventListener('pointercancel', slipp);
})();
</script>
