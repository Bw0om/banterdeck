---
// Stua: en isometrisk stue tegnet med tykk strek. Én ny gjest går inn døra for hver bokstav i romkoden,
// TV-en viser koden, og folka kan dras rundt. Ingenting beveger seg uten at noen klikker, drar eller skriver.
// Skriptet legger også ut en liten fjærmotor (window.mvFjaer) som resten av forsiden bruker.
import type { Lang } from '../lib/i18n';
const { lang = 'no' } = Astro.props as { lang?: Lang };
const no = lang === 'no';
---
<div class="stua">
  <svg id="stuaScene" viewBox="62 -4 396 326" role="img" aria-labelledby="stuaTekst">
    <title id="stuaTekst">{no ? 'En tegnet stue: TV-en på veggen viser romkoden, venner står rundt et bord, og en ny gjest kommer inn døra for hver bokstav du skriver.' : 'A drawn living room: the TV shows the room code, friends stand around a table, and a new guest walks in for every letter you type.'}</title>
  </svg>
  <span class="stua-hint" aria-hidden="true">{no ? 'Dra i folka' : 'Drag the people'}</span>
</div>

<style>
  .stua{position:relative}
  .stua svg{display:block;width:100%;height:auto;overflow:visible}
  .stua :global(.figur){cursor:grab;touch-action:none}
  .stua :global(.figur:active){cursor:grabbing}
  .stua-hint{position:absolute;right:2px;top:4px;font-family:var(--display);font-stretch:80%;font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:.03em;
    background:var(--papir);color:var(--blekk);border:2.5px solid var(--blekk);padding:3px 8px;box-shadow:3px 3px 0 var(--blekk);transform:rotate(2deg)}
  @media (max-width:560px){.stua-hint{font-size:11px}}
</style>

<script>
  // Selve stua ligger i src/klient/stua.js (felles med rommet og TV-en)
  import { lagStua } from '../klient/stua.js';
  function start() {
    const svg = document.getElementById('stuaScene') as SVGSVGElement | null;
    if (!svg || svg.dataset.bound) return; svg.dataset.bound = '1';
    const en = /^en/.test(document.documentElement.lang || '');
    (window as any).mvStua = lagStua(svg, { demo: true, lang: en ? 'en' : 'no' });
  }
  start();
  document.addEventListener('astro:page-load', start);
  document.dispatchEvent(new CustomEvent('mv-stua-klar'));
</script>
