---
/**
 * Digitale kortstokker og terninger, så lekene kan spilles uten fysiske ting.
 * Alt kjører på én telefon. Leker som trenger skjulte hender (Pyramiden, President, Gris) ligger i rom.
 */
const { slug } = Astro.props as { slug: string };
const DIGITALE = ['over-eller-under', 'fuck-the-dealer', 'krig', 'veddelopet', 'bussruta', 'terningen-bestemmer', '21-med-terninger', 'opus'];
const RomLeker = ['opus', 'over-eller-under', 'veddelopet', 'pyramiden', 'president', 'gris'];
const har = DIGITALE.includes(slug);
const bareRom = ['pyramiden', 'president', 'gris'].includes(slug);
---
{(har || bareRom) && (
<section class="gt dl" data-dl={slug}>
  <h2>{bareRom ? 'Spill uten kortstokk' : (['terningen-bestemmer', '21-med-terninger', 'opus'].includes(slug) ? 'Telefonen er terningen' : 'Telefonen er kortstokken')}</h2>
  {bareRom ? (
    <>
      <p>Her har hver spiller skjulte kort på hånda, så dere spiller fra hver deres telefon. Lag et rom, del koden og velg {slug === 'pyramiden' ? 'Pyramiden' : slug === 'president' ? 'President' : 'Gris'}.</p>
      <p><a class="btn gold" href="/no/rom">Lag et rom</a></p>
    </>
  ) : <div class="dl-body"></div>}
  {RomLeker.includes(slug) && !bareRom && <p class="small dl-romtips">Vil dere spille fra hver sin telefon? <a href="/no/rom">Lag et rom</a> og velg leken der.</p>}
</section>
)}

{har && (
<script is:inline data-astro-rerun>
/* Felles hjelpere for kort og terninger – defineres én gang */
if (!window.BDK) window.BDK = (function () {
  function bland(a) { a = a.slice(); for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function stokk(utenEss) {
    var s = [];
    ['♥', '♦', '♠', '♣'].forEach(function (f) { for (var v = 2; v <= 14; v++) if (!(utenEss && v === 14)) s.push({ v: v, f: f }); });
    return bland(s);
  }
  function vn(v) { return v <= 10 ? String(v) : ({ 11: 'Kn', 12: 'D', 13: 'K', 14: 'A' })[v]; }
  function rod(k) { return k.f === '♥' || k.f === '♦'; }
  function kort(k, kl) {
    if (!k) return '<span class="kk tom ' + (kl || '') + '"></span>';
    return '<span class="kk ' + (rod(k) ? 'rod ' : '') + (kl || '') + '"><b>' + vn(k.v) + '</b><i>' + k.f + '</i></span>';
  }
  function bakside(kl) { return '<span class="kk bak ' + (kl || '') + '"></span>'; }
  var PRIKKER = { 1: [5], 2: [1, 9], 3: [1, 5, 9], 4: [1, 3, 7, 9], 5: [1, 3, 5, 7, 9], 6: [1, 3, 4, 6, 7, 9] };
  function terning(n) {
    var s = '<span class="dice" data-n="' + n + '" aria-label="Terning viser ' + n + '">';
    for (var i = 1; i <= 9; i++) s += '<i' + (PRIKKER[n].indexOf(i) !== -1 ? ' class="p"' : '') + '></i>';
    return s + '</span>';
  }
  /* Spinner terningene i et lite øyeblikk før de lander */
  function kast(el, antall, ferdig) {
    var slutt = []; for (var i = 0; i < antall; i++) slutt.push(1 + Math.floor(Math.random() * 6));
    var redusert = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var runder = redusert ? 0 : 9, r = 0;
    el.classList.add('spinner');
    (function steg() {
      if (r < runder) {
        el.innerHTML = slutt.map(function () { return terning(1 + Math.floor(Math.random() * 6)); }).join('');
        r++; return setTimeout(steg, 55 + r * 8);
      }
      el.classList.remove('spinner');
      el.innerHTML = slutt.map(terning).join('');
      ferdig(slutt);
    })();
  }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function navn(inp) { return inp.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean).slice(0, 12); }
  function husk(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function hent(k) { try { return localStorage.getItem(k) || ''; } catch (e) { return ''; } }
  return { bland: bland, stokk: stokk, vn: vn, kort: kort, bakside: bakside, terning: terning, kast: kast, esc: esc, navn: navn, husk: husk, hent: hent };
})();
</script>
)}

{slug === 'over-eller-under' && (
<script is:inline data-astro-rerun>
(function () {
  var root = document.querySelector('[data-dl="over-eller-under"] .dl-body'); if (!root || root.dataset.bound) return; root.dataset.bound = '1';
  var K = window.BDK, stokk, naa, bunke, melding;
  function start() { stokk = K.stokk(); naa = stokk.pop(); bunke = 1; melding = 'Neste spiller: høyere eller lavere?'; tegn(); }
  function tegn(sist) {
    root.innerHTML = '<div class="dl-bord">' + K.kort(naa, 'stor' + (sist ? ' inn' : '')) + '</div>' +
      '<p class="dl-melding" aria-live="polite">' + K.esc(melding) + '</p>' +
      '<p class="dl-info">Bunken: <b>' + bunke + '</b> ' + (bunke === 1 ? 'kort' : 'kort') + ' · ' + stokk.length + ' igjen i stokken</p>' +
      '<div class="dl-knapper"><button class="btn gold" data-v="over">Høyere ↑</button><button class="btn gold" data-v="under">Lavere ↓</button></div>' +
      '<p class="small">Ess er høyest. Likt teller som feil.</p>';
  }
  root.addEventListener('click', function (e) {
    var b = e.target.closest('[data-v]'); if (!b) return;
    if (!stokk.length) { stokk = K.stokk(); }
    var nytt = stokk.pop(), riktig = b.dataset.v === 'over' ? nytt.v > naa.v : nytt.v < naa.v;
    if (riktig) { bunke++; melding = 'Riktig! Turen går videre.'; }
    else { melding = 'Feil! Drikk ' + bunke + (bunke === 1 ? ' slurk.' : ' slurker.'); bunke = 1; }
    naa = nytt; tegn(true);
  });
  start();
})();
</script>
)}

{slug === 'fuck-the-dealer' && (
<script is:inline data-astro-rerun>
(function () {
  var root = document.querySelector('[data-dl="fuck-the-dealer"] .dl-body'); if (!root || root.dataset.bound) return; root.dataset.bound = '1';
  var K = window.BDK, stokk, kortet, forsok, rad, brukt, melding, hint, avslort;
  function start() { stokk = K.stokk(); brukt = {}; rad = 0; nyttKort(); melding = 'Spilleren til venstre for dealeren gjetter.'; tegn(); }
  function nyttKort() { if (!stokk.length) { stokk = K.stokk(); brukt = {}; } kortet = stokk.pop(); forsok = 1; hint = ''; avslort = false; }
  function tegn() {
    var verdier = []; for (var v = 2; v <= 14; v++) verdier.push(v);
    root.innerHTML = '<div class="dl-bord">' + (avslort ? K.kort(kortet, 'stor inn') : K.bakside('stor')) + '</div>' +
      '<p class="dl-melding" aria-live="polite">' + K.esc(melding) + (hint ? ' <b class="dl-hint">' + hint + '</b>' : '') + '</p>' +
      (avslort
        ? '<div class="dl-knapper"><button class="btn gold" data-a="neste">Neste spiller</button></div>'
        : '<p class="dl-info">Gjett ' + (forsok === 1 ? 'verdien' : 'én gang til') + '</p><div class="dl-verdier">' + verdier.map(function (v) {
            var n = brukt[v] || 0;
            return '<button data-g="' + v + '"' + (n >= 4 ? ' disabled' : '') + '><b>' + K.vn(v) + '</b><small>' + (4 - n) + ' igjen</small></button>';
          }).join('') + '</div>') +
      '<p class="dl-info">Dealeren har klart <b>' + rad + '</b> av 3 på rad · ' + stokk.length + ' kort igjen</p>';
  }
  root.addEventListener('click', function (e) {
    var g = e.target.closest('[data-g]'), a = e.target.closest('[data-a]');
    if (a) { nyttKort(); melding = 'Neste spiller gjetter.'; return tegn(); }
    if (!g) return;
    var v = Number(g.dataset.g);
    if (v === kortet.v) {
      melding = forsok === 1 ? 'Rett på første! Dealeren drikker 5.' : 'Riktig! Dealeren drikker 2.';
      rad = 0; avslort = true; brukt[kortet.v] = (brukt[kortet.v] || 0) + 1;
    } else if (forsok === 1) {
      forsok = 2; hint = kortet.v > v ? 'Høyere!' : 'Lavere!'; melding = 'Feil.';
    } else {
      var diff = Math.abs(kortet.v - v);
      melding = 'Feil igjen – drikk ' + diff + (diff === 1 ? ' slurk.' : ' slurker.'); hint = '';
      rad++; avslort = true; brukt[kortet.v] = (brukt[kortet.v] || 0) + 1;
      if (rad >= 3) { melding += ' Dealeren har klart tre på rad – send telefonen til ny dealer.'; rad = 0; }
    }
    tegn();
  });
  start();
})();
</script>
)}

{slug === 'krig' && (
<script is:inline data-astro-rerun>
(function () {
  var root = document.querySelector('[data-dl="krig"] .dl-body'); if (!root || root.dataset.bound) return; root.dataset.bound = '1';
  var K = window.BDK, A, B, na = 'Spiller 1', nb = 'Spiller 2', vist = null, melding = '';
  function oppsett() {
    root.innerHTML = '<div class="dl-navn"><label for="krA">Spiller 1</label><input id="krA" maxlength="20" placeholder="Navn">' +
      '<label for="krB">Spiller 2</label><input id="krB" maxlength="20" placeholder="Navn"></div>' +
      '<button class="btn gold" data-a="start">Del ut</button>';
  }
  function start() {
    var s = K.stokk(); A = s.slice(0, 26); B = s.slice(26); vist = null; melding = 'Trykk for å snu samtidig.';
    tegn();
  }
  function tegn() {
    root.innerHTML = '<div class="dl-krig">' +
      '<div><p class="dl-spiller">' + K.esc(na) + '</p>' + (vist ? K.kort(vist.a, 'stor inn') : K.bakside('stor')) + '<p class="dl-info"><b>' + A.length + '</b> kort</p></div>' +
      '<div><p class="dl-spiller">' + K.esc(nb) + '</p>' + (vist ? K.kort(vist.b, 'stor inn') : K.bakside('stor')) + '<p class="dl-info"><b>' + B.length + '</b> kort</p></div>' +
      '</div><p class="dl-melding" aria-live="polite">' + K.esc(melding) + '</p>' +
      (A.length && B.length ? '<div class="dl-knapper"><button class="btn gold" data-a="snu">Snu</button></div>'
        : '<div class="dl-knapper"><button class="btn gold" data-a="start">Ny runde</button></div>');
  }
  function snu() {
    var pott = [], meld = [], a, b, kriger = 0;
    while (true) {
      if (!A.length || !B.length) break;
      a = A.shift(); b = B.shift(); pott.push(a, b);
      if (a.v !== b.v) break;
      kriger++; meld.push('KRIG! Begge drikker 2.');
      for (var i = 0; i < 3 && A.length > 1; i++) pott.push(A.shift());
      for (var j = 0; j < 3 && B.length > 1; j++) pott.push(B.shift());
    }
    vist = { a: a, b: b };
    if (a && b && a.v !== b.v) {
      var vinnerA = a.v > b.v, taper = vinnerA ? nb : na;
      (vinnerA ? A : B).push.apply(vinnerA ? A : B, K.bland(pott));
      if (kriger) meld.push(taper + ' tapte krigen – drikk 3.');
      else if ((vinnerA ? a.v : b.v) >= 11) meld.push(taper + ' mistet et kort til et bildekort – drikk 1.');
      else meld.push((vinnerA ? na : nb) + ' tar stikket.');
    }
    if (!A.length || !B.length) meld.push((A.length ? na : nb) + ' vant hele stokken!');
    melding = meld.join(' ');
    tegn();
  }
  root.addEventListener('click', function (e) {
    var b = e.target.closest('[data-a]'); if (!b) return;
    if (b.dataset.a === 'start') {
      var ia = root.querySelector('#krA'), ib = root.querySelector('#krB');
      if (ia) { na = ia.value.trim() || 'Spiller 1'; nb = ib.value.trim() || 'Spiller 2'; }
      start();
    }
    if (b.dataset.a === 'snu') snu();
  });
  oppsett();
})();
</script>
)}

{slug === 'veddelopet' && (
<script is:inline data-astro-rerun>
(function () {
  var root = document.querySelector('[data-dl="veddelopet"] .dl-body'); if (!root || root.dataset.bound) return; root.dataset.bound = '1';
  var K = window.BDK, FARGER = ['♥', '♠', '♦', '♣'], LENGDE = 7;
  var stokk, bane, snudd, pos, sist, vinner, auto = null, melding;
  function start() {
    stokk = K.stokk(true); bane = stokk.splice(0, LENGDE); snudd = []; pos = { '♥': 0, '♠': 0, '♦': 0, '♣': 0 };
    sist = null; vinner = null; melding = 'Vedd slurker på en farge før start. Snu kort for å kjøre løpet.'; tegn();
  }
  function tegn() {
