---
import { ICONS } from '../lib/icons';
const { name, size = 18, class: cls = '' } = Astro.props as { name: string; size?: number; class?: string };
---
<svg class={`icon ${cls}`} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[name]} />
