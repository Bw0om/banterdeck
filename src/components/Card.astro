---
import { tf, cueText } from '../lib/content';
import { ui, type Lang } from '../lib/i18n';
/**
 * mode="clean"  – på situasjonssider: bare replikken, pluss et kort stikkord når det sier noe nytt.
 * mode="full"   – i samlinger: full kontekst og kommentar.
 */
const { it, lang = 'en', mode = 'full', cue = false } =
  Astro.props as { it: any; lang?: Lang; mode?: 'clean' | 'full'; cue?: boolean };
const L = ui(lang);
const line = tf(it, 'line', lang);
const ctx = tf(it, 'ctx', lang);
const note = tf(it, 'note', lang);
const shownCtx = mode === 'clean' ? (cue ? cueText(ctx, lang) : '') : ctx;
const crude = /grov|crude|mørk|dark/i.test(note);
const shownNote = mode === 'clean' ? (crude ? '' : note) : note;
---
<article class:list={['card', mode === 'clean' && 'clean', crude && 'crude']} data-copy={line} tabindex="0" title={L.copyHint}>
  {shownCtx && <p class="ctx">{shownCtx}</p>}
  <p class="line">«{line}»</p>
  {shownNote && <p class="note">{shownNote}</p>}
  <div class="cardacts">
    <button class="starbtn" data-fav={line} aria-label={L.favAdd}>☆</button>
    <button class="sharebtn" data-share={line} aria-label={L.share}>↗</button>
  </div>
</article>
